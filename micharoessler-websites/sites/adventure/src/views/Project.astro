---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import { preloadFor } from '../lib/img';
import YouTube from '../components/YouTube.astro';
import Terrain from '../components/Terrain.astro';
import { terrainFor } from '../data/terrain';
import { href, ui, type Lang } from '../i18n';
import { projects, pic, type Project } from '../data/projects';

interface Props {
	lang: Lang;
	project: Project;
}
const { lang, project: p } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
const idx = projects.findIndex((x) => x.slug === p.slug);
const nxt = projects[(idx + 1) % projects.length];

const credits: [string, string][] = [
	[t.role_l, p.roles[lang]],
	...(p.client ? [[t.client_l, p.client] as [string, string]] : []),
	[t.location_l, p.location[lang]],
	...(p.year ? [[t.year_l, p.year] as [string, string]] : []),
];

const jsonLd: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: p.title[lang],
		abstract: p.summary[lang],
		creator: { '@id': 'https://micharoessler.com/#person' },
		...(p.year ? { dateCreated: p.year.slice(0, 4) } : {}),
		locationCreated: { '@type': 'Place', name: p.location[lang] },
	},
	...(p.youtube
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'VideoObject',
					name: p.title[lang],
					description: p.summary[lang],
					thumbnailUrl: `https://i.ytimg.com/vi/${p.youtube}/maxresdefault.jpg`,
					embedUrl: `https://www.youtube-nocookie.com/embed/${p.youtube}`,
					contentUrl: `https://www.youtube.com/watch?v=${p.youtube}`,
					...(p.year ? { uploadDate: `${p.year.slice(0, 4)}-01-01` } : {}),
				},
			]
		: []),
];
const area = terrainFor[p.slug];
const peakFact = p.facts.find((f) => /\d.*m\b/.test(f.value[lang]) && f.value[lang].includes(' m'));
const cover = pic(p.cover);
const pad = (n: number) => String(n).padStart(2, '0');
const heroWidths = [640, 960, 1280, 1600, 1920, 2560];
const heroSizes = '(min-width: 1520px) 1424px, calc(100vw - 2 * clamp(16px, 3.3vw, 48px))';
const pre = await preloadFor(cover, heroWidths, heroSizes, { ratio: 16 / 9 });
---

<Base
	lang={lang}
	title={`${p.title[lang]} – ${p.kicker[lang]} | Micha Rössler`}
	description={p.summary[lang]}
	alt={{ en: href('en', p.slug), de: href('de', p.slug) }}
	ogImage={p.cover}
	jsonLd={jsonLd}
	preload={[pre]}
	terrainCredit={!!area}
>
	<article>
		<header class="wrap p-head">
			<p class="eyebrow k">
				<a class="back" href={href(lang, 'work')}>← {t.allWork}</a>
				<span class="rule" aria-hidden="true"></span>
				<span>{p.kicker[lang]}</span>
				<span class="hide-m">{pad(idx + 1)} / {pad(projects.length)}</span>
			</p>
			<div class="p-grid">
				<h1>{p.title[lang]}</h1>
				<p class="lead p-sum">{p.summary[lang]}</p>
			</div>
		</header>

		<div class="wrap p-media">
			{
				p.youtube ? (
					<div style={`view-transition-name: p-${p.slug}`}>
						<YouTube id={p.youtube} title={p.title[lang]} lang={lang} poster={cover} alt={p.title[lang]} eager widths={heroWidths} sizes={heroSizes} />
					</div>
				) : (
					<div class="m hero-img" style={`view-transition-name: p-${p.slug}`}>
						<Media src={cover} alt={p.title[lang]} video={p.video} widths={heroWidths} sizes={heroSizes} crop={{ ratio: 16 / 9 }} eager />
						{p.tag && <span class="tag">{p.tag[lang]}</span>}
					</div>
				)
			}
			<div class="rows credits">
				{
					credits.map(([k, v]) => (
						<div>
							<span class="k">{k}</span>
							<span>{v}</span>
						</div>
					))
				}
			</div>
			{
				p.youtube && (
					<a class="lnk yt-link" href={`https://www.youtube.com/watch?v=${p.youtube}`} rel="noopener">
						{en ? 'Watch on YouTube – check the views yourself ↗' : 'Auf YouTube ansehen – Aufrufe selbst prüfen ↗'}
					</a>
				)
			}
		</div>

		<section class="wrap sec p-text">
			<div class="prose p-body">
				{p.body.map((b) => <p>{b[lang]}</p>)}
			</div>
			<aside class="slate" aria-labelledby="log-h">
				<div class="slate-top" aria-hidden="true"></div>
				<p class="slate-h"><span id="log-h">{en ? 'Field log' : 'Drehprotokoll'}</span><span>{p.year || '—'}</span></p>
				<dl>
					{
						p.facts.map((f) => (
							<div>
								<dt>{f.label[lang]}</dt>
								<dd>{f.value[lang]}</dd>
							</div>
						))
					}
				</dl>
			</aside>
		</section>

		{
			area && (
				<section class="wrap sec" aria-label={en ? 'Terrain' : 'Gelände'}>
					<Terrain id={area} lang={lang} side section name={peakFact && area === 'kilimanjaro' ? peakFact.value[lang] : undefined} />
				</section>
			)
		}

		{
			p.gallery.length > 0 && (
				<section class="wrap sec" aria-label={en ? 'Stills' : 'Standbilder'}>
					<div class="gallery">
						{p.gallery.map((g) => (
							<figure class="m reveal">
								<Photo src={g} alt={`${p.title[lang]} – ${en ? 'still' : 'Standbild'}`} widths={[480, 640, 800, 1200, 1600]} sizes="(min-width: 1520px) 700px, (min-width: 700px) 46vw, 92vw" />
							</figure>
						))}
					</div>
					{p.galleryCredit && (
						<p class="k credit">
							{en ? 'Photos' : 'Fotos'}: {p.galleryCredit}
						</p>
					)}
				</section>
			)
		}

		<nav class="wrap sec" aria-label={t.next}>
			<a href={href(lang, nxt.slug)} class="p-next">
				<span class="k">{t.next}</span>
				<span class="p-next-title">{nxt.title[lang]}</span>
				<span class="p-next-arrow" aria-hidden="true">→</span>
			</a>
		</nav>

		<section class="wrap sec p-cta">
			<h2 class="h2">{en ? 'Have a project like this?' : 'Ein ähnliches Projekt geplant?'}</h2>
			<a class="btn" href={href(lang, 'contact')}>{t.cta}<Icon name="arrow" /></a>
		</section>
	</article>
</Base>

<style>
	.p-head {
		padding-top: clamp(16px, 3vw, 40px);
	}
	.eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
		margin-bottom: 28px;
	}
	.back {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--ink-2);
	}
	.back:hover {
		color: var(--ink);
	}
	.eyebrow .hide-m {
		margin-left: auto;
	}
	.p-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 24px clamp(32px, 6vw, 120px);
		align-items: end;
	}
	h1 {
		font-size: clamp(36px, 5.2vw, 84px);
		line-height: 1.04;
		letter-spacing: -0.03em;
		font-variation-settings: 'wdth' 86;
	}
	.p-sum {
		max-width: 38ch;
	}
	.p-media {
		margin-top: clamp(36px, 4vw, 56px);
	}
	.hero-img {
		aspect-ratio: 16 / 9;
		border-radius: 6px;
	}
	.tag {
		position: absolute;
		right: 16px;
		bottom: 16px;
		z-index: 2;
		padding: 5px 9px;
		border-radius: 3px;
		background: var(--ink);
		color: #0f0f0f;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
	}
	.credits {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		column-gap: clamp(24px, 4vw, 64px);
		margin-top: 18px;
	}
	.credits div {
		display: grid;
		gap: 4px;
		padding: 12px 0;
		border-bottom: 1px solid var(--line);
		font-size: 15px;
	}
	.credits .k {
		font-size: 11px;
	}
	.yt-link {
		margin-top: 18px;
	}
	.p-text {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(32px, 6vw, 110px);
		align-items: start;
	}
	.p-body {
		font-size: clamp(17px, 1.3vw, 20px);
		line-height: 1.65;
	}
	.slate {
		border: 1px solid var(--line-2);
		border-radius: 6px;
		background: var(--bg-2);
		overflow: hidden;
	}
	.slate-top {
		height: 36px;
		background: repeating-linear-gradient(-45deg, #f2efe9 0 18px, #0f0f0f 18px 36px);
		border-bottom: 1px solid var(--line-2);
	}
	.slate-h {
		display: flex;
		justify-content: space-between;
		padding: 16px 22px;
		border-bottom: 1px solid var(--line);
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.slate dl div {
		display: grid;
		gap: 6px;
		padding: 16px 22px;
		border-bottom: 1px solid var(--line);
	}
	.slate dl div:last-child {
		border-bottom: 0;
	}
	.slate dt {
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.slate dd {
		font-size: 17px;
		line-height: 1.35;
	}
	.gallery {
		columns: 2;
		column-gap: clamp(16px, 2.5vw, 36px);
	}
	.gallery figure {
		margin-bottom: clamp(16px, 2.5vw, 36px);
		break-inside: avoid;
	}
	.gallery figure :global(img) {
		height: auto;
	}
	.credit {
		margin-top: 4px;
	}
	.p-next {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 10px 24px;
		padding-top: 22px;
		border-top: 1px solid var(--line);
	}
	.p-next .k {
		grid-column: 1 / -1;
	}
	.p-next-title,
	.p-next-arrow {
		font-size: clamp(28px, 4vw, 64px);
		line-height: 1.05;
		letter-spacing: -0.03em;
		font-variation-settings: 'wdth' 86;
	}
	.p-next-arrow {
		transition: transform 0.4s var(--ease);
	}
	.p-next:hover .p-next-arrow {
		transform: translateX(10px);
	}
	.p-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}
	@media (max-width: 1000px) {
		.p-text {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 700px) {
		.p-grid {
			grid-template-columns: 1fr;
		}
		.hide-m {
			display: none;
		}
		.gallery {
			columns: 1;
		}
	}
</style>
