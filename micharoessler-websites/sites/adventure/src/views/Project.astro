---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import YouTube from '../components/YouTube.astro';
import Terrain from '../components/Terrain.astro';
import { terrainFor } from '../data/terrain';
import { href, ui, type Lang } from '../i18n';
import { projects, pic, type Project } from '../data/projects';

interface Props {
	lang: Lang;
	project: Project;
}
const { lang, project: p } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
const idx = projects.findIndex((x) => x.slug === p.slug);
const nxt = projects[(idx + 1) % projects.length];

const credits: [string, string][] = [
	[t.role_l, p.roles[lang]],
	...(p.client ? [[t.client_l, p.client] as [string, string]] : []),
	[t.location_l, p.location[lang]],
	...(p.year ? [[t.year_l, p.year] as [string, string]] : []),
];

const jsonLd: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: p.title[lang],
		abstract: p.summary[lang],
		creator: { '@id': 'https://micharoessler.com/#person' },
		...(p.year ? { dateCreated: p.year.slice(0, 4) } : {}),
		locationCreated: { '@type': 'Place', name: p.location[lang] },
	},
	...(p.youtube
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'VideoObject',
					name: p.title[lang],
					description: p.summary[lang],
					thumbnailUrl: `https://i.ytimg.com/vi/${p.youtube}/maxresdefault.jpg`,
					embedUrl: `https://www.youtube-nocookie.com/embed/${p.youtube}`,
					contentUrl: `https://www.youtube.com/watch?v=${p.youtube}`,
					...(p.year ? { uploadDate: `${p.year.slice(0, 4)}-01-01` } : {}),
				},
			]
		: []),
];
const area = terrainFor[p.slug];
const peakFact = p.facts.find((f) => /\d.*m\b/.test(f.value[lang]) && f.value[lang].includes(' m'));
const cover = pic(p.cover);
const heroWidths = [640, 960, 1280, 1920, 2560];
const heroSizes = '(min-width: 1440px) 1280px, 92vw';
// Same candidate list as <Photo>/<YouTube> build, so the preload and the <picture> pick identical files.
const coverWidths = [...new Set([...heroWidths.filter((w) => w < cover.width), Math.min(cover.width, Math.max(...heroWidths))])];
---

<Base
	lang={lang}
	title={`${p.title[lang]} – ${p.kicker[lang]} | Micha Rössler`}
	description={p.summary[lang]}
	alt={{ en: href('en', p.slug), de: href('de', p.slug) }}
	ogImage={p.cover}
	jsonLd={jsonLd}
	hero={{ src: cover, widths: coverWidths, sizes: heroSizes }}
	terrainCredit={!!area}
>
	<article>
		<header class="wrap p-head">
			<a class="link back" href={href(lang, 'work')}>← {t.allWork}</a>
			<p class="label">{p.kicker[lang]}</p>
			<h1>{p.title[lang]}</h1>
			<p class="p-sum">{p.summary[lang]}</p>
			<dl class="credits">
				{
					credits.map(([k, v]) => (
						<div>
							<dt class="label">{k}</dt>
							<dd>{v}</dd>
						</div>
					))
				}
			</dl>
		</header>

		<div class="wrap p-media">
			{
				p.youtube ? (
					<div style={`view-transition-name: p-${p.slug}`}>
						<YouTube id={p.youtube} title={p.title[lang]} lang={lang} poster={cover} alt={p.title[lang]} eager widths={heroWidths} sizes={heroSizes} />
						<a class="link yt-link" href={`https://www.youtube.com/watch?v=${p.youtube}`} rel="noopener">
							{en ? 'Watch on YouTube – check the views yourself ↗' : 'Auf YouTube ansehen – Aufrufe selbst prüfen ↗'}
						</a>
					</div>
				) : (
					<div class="media hero-img" style={`view-transition-name: p-${p.slug}`}>
						<Photo src={cover} alt={p.title[lang]} widths={heroWidths} sizes={heroSizes} eager />
					</div>
				)
			}
		</div>

		<section class="wrap section p-text">
			<div class="prose p-body">
				{p.body.map((b) => <p>{b[lang]}</p>)}
			</div>
			<aside aria-labelledby="log-h">
				<p class="label" id="log-h">{en ? 'Field log' : 'Drehprotokoll'}</p>
				<dl class="rows facts">
					{
						p.facts.map((f) => (
							<div>
								<dt class="meta">{f.label[lang]}</dt>
								<dd>{f.value[lang]}</dd>
							</div>
						))
					}
				</dl>
			</aside>
		</section>

		{
			area && (
				<section class="wrap section p-terrain" aria-label={en ? 'Terrain' : 'Gelände'}>
					<Terrain id={area} lang={lang} name={peakFact && area === 'kilimanjaro' ? peakFact.value[lang] : undefined} />
				</section>
			)
		}

		{
			p.gallery.length > 0 && (
				<section class="wrap section" aria-label={en ? 'Stills' : 'Standbilder'}>
					<div class="gallery">
						{p.gallery.map((g) => (
							<figure class="media reveal">
								<Photo
									src={g}
									alt={`${p.title[lang]} – ${en ? 'still' : 'Standbild'}`}
									widths={[480, 640, 800, 1200, 1600]}
									sizes="(min-width: 1440px) 620px, (min-width: 760px) 44vw, 92vw"
								/>
							</figure>
						))}
					</div>
					{p.galleryCredit && (
						<p class="meta credit">
							{en ? 'Photos' : 'Fotos'}: {p.galleryCredit}
						</p>
					)}
				</section>
			)
		}

		<nav class="wrap section p-next" aria-label={t.next}>
			<a href={href(lang, nxt.slug)} class="p-next-link">
				<span class="label">{t.next}</span>
				<span class="p-next-title">{nxt.title[lang]}</span>
				<span class="p-next-arrow" aria-hidden="true">→</span>
			</a>
		</nav>

		<section class="wrap section p-cta">
			<h2 class="h2">{en ? 'Have a project like this?' : 'Ein ähnliches Projekt geplant?'}</h2>
			<a class="btn" href={href(lang, 'contact')}>{t.cta}</a>
		</section>
	</article>
</Base>

<style>
	.p-head {
		padding-top: clamp(24px, 4vw, 56px);
	}
	.back {
		margin-bottom: clamp(32px, 5vw, 64px);
		color: var(--muted);
	}
	h1 {
		margin: 14px 0 22px;
		font-size: clamp(32px, 3.6vw + 12px, 64px);
		line-height: 1.12;
		letter-spacing: -0.025em;
		max-width: 20ch;
	}
	.p-sum {
		max-width: 46ch;
		font-size: clamp(18px, 0.7vw + 14px, 22px);
		line-height: 1.5;
		color: #d4d2cc;
	}
	.credits {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
		gap: 0 clamp(24px, 3vw, 48px);
		margin: clamp(40px, 5vw, 64px) 0 0;
	}
	.credits div {
		display: grid;
		align-content: start;
		gap: 6px;
		padding: 14px 0;
		border-top: 1px solid var(--line);
	}
	.credits dd {
		margin: 0;
		font-family: var(--mono);
		font-size: 15px;
	}
	.p-media {
		margin-top: clamp(40px, 5vw, 64px);
	}
	.hero-img {
		aspect-ratio: 16 / 9;
	}
	.yt-link {
		margin-top: 8px;
		color: var(--muted);
		font-size: 12px;
	}
	.p-text {
		display: grid;
		gap: 48px clamp(24px, 6vw, 96px);
	}
	@media (min-width: 900px) {
		.p-text {
			grid-template-columns: 7fr 5fr;
		}
	}
	.p-body {
		font-size: clamp(17px, 0.4vw + 15px, 20px);
		line-height: 1.7;
	}
	.facts {
		margin-top: 14px;
		border-top: 1px solid var(--line);
	}
	.facts div {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: 1rem;
		align-items: baseline;
	}
	.facts dd {
		margin: 0;
		font-family: var(--mono);
		font-size: 15px;
	}
	.p-terrain :global(.terrain) {
		max-width: 880px;
		margin-inline: auto;
	}
	.gallery {
		columns: 1;
		column-gap: clamp(16px, 3vw, 40px);
	}
	@media (min-width: 760px) {
		.gallery {
			columns: 2;
		}
	}
	.gallery figure {
		margin: 0 0 clamp(16px, 3vw, 40px);
		break-inside: avoid;
	}
	.gallery figure :global(img) {
		height: auto;
	}
	.credit {
		font-size: 13px;
	}
	.p-next-link {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 10px 24px;
		padding-top: 22px;
		border-top: 1px solid var(--line);
		text-decoration: none;
	}
	.p-next-link .label {
		grid-column: 1 / -1;
	}
	.p-next-title {
		font-family: var(--mono);
		font-size: clamp(26px, 2.6vw + 10px, 48px);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	.p-next-arrow {
		font-family: var(--mono);
		font-size: clamp(26px, 2.6vw + 10px, 48px);
		line-height: 1.15;
		transition: translate 0.4s var(--ease);
	}
	.p-next-link:hover .p-next-arrow {
		translate: 8px 0;
	}
	.p-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}
</style>
