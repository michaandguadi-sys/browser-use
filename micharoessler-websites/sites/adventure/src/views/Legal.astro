---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { impressum, privacy } from '../data/legal';

interface Props {
	lang: Lang;
	kind: 'imprint' | 'privacy';
}
const { lang, kind } = Astro.props;
const en = lang === 'en';
const sections = kind === 'imprint' ? impressum[lang] : privacy('Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, USA')[lang];
const title = kind === 'imprint' ? (en ? 'Imprint' : 'Impressum') : en ? 'Privacy policy' : 'Datenschutzerklärung';
const alt = kind === 'imprint' ? { en: '/imprint/', de: '/de/impressum/' } : { en: '/privacy/', de: '/de/datenschutz/' };
---

<Base lang={lang} title={`${title} | Micha Rössler`} description={title} alt={alt} sheet={kind === 'imprint' ? 'C/01' : 'C/02'} solidHeader>
	<div class="sheet sheet--firn l-sheet">
		<div class="wrap g12">
			<div class="col-prose l">
				<h1 class="h2">{title}</h1>
				{
					sections.map((s) => (
						<section>
							<h2>{s.h}</h2>
							{s.p.map((p) => (
								<p set:html={p} />
							))}
						</section>
					))
				}
			</div>
		</div>
	</div>
</Base>

<style>
	.l-sheet {
		padding-top: calc(var(--neat) + 56px + clamp(3rem, 7vw, 6rem));
		padding-bottom: clamp(4rem, 9vw, 7rem);
	}
	.l {
		max-width: 62ch;
	}
	h1 {
		margin-bottom: 2.5rem;
	}
	section {
		margin-top: 2.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}
	h2 {
		font-family: var(--mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.4;
		margin-bottom: 0.75rem;
	}
	p {
		font-size: 17px;
		line-height: 1.6;
		overflow-wrap: anywhere;
	}
	p + p {
		margin-top: 0.75rem;
	}
</style>
