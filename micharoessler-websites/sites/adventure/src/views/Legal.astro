---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { impressum, privacy } from '../data/legal';

interface Props {
	lang: Lang;
	kind: 'imprint' | 'privacy';
}
const { lang, kind } = Astro.props;
const en = lang === 'en';
const sections = kind === 'imprint' ? impressum[lang] : privacy('Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, USA')[lang];
const title = kind === 'imprint' ? (en ? 'Imprint' : 'Impressum') : en ? 'Privacy policy' : 'Datenschutzerklärung';
const alt = kind === 'imprint' ? { en: '/imprint/', de: '/de/impressum/' } : { en: '/privacy/', de: '/de/datenschutz/' };
---

<Base lang={lang} title={`${title} | Micha Rössler`} description={title} alt={alt} cta={false}>
	<div class="l-sheet">
		<div class="wrap">
			<div class="l">
				<h1>{title}</h1>
				{
					sections.map((s) => (
						<section>
							<h2>{s.h}</h2>
							{s.p.map((p) => (
								<p set:html={p} />
							))}
						</section>
					))
				}
			</div>
		</div>
	</div>
</Base>

<style>
	.l-sheet {
		padding-top: clamp(16px, 3vw, 40px);
	}
	.l {
		max-width: 72ch;
	}
	h1 {
		margin-bottom: 40px;
		font-size: clamp(34px, 4.4vw, 68px);
		line-height: 1.08;
		letter-spacing: -0.03em;
		font-variation-settings: 'wdth' 86;
	}
	section {
		padding: 18px 0 22px;
		border-top: 1px solid var(--line);
	}
	h2 {
		margin-bottom: 12px;
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	p {
		font-size: 16px;
		line-height: 1.7;
		color: var(--ink-2);
		overflow-wrap: anywhere;
	}
	p + p {
		margin-top: 12px;
	}
	p :global(a) {
		border-bottom: 1px solid var(--line-2);
	}
</style>
