---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { impressum, privacy } from '../data/legal';

interface Props {
	lang: Lang;
	kind: 'imprint' | 'privacy';
}
const { lang, kind } = Astro.props;
const en = lang === 'en';
const sections = kind === 'imprint' ? impressum[lang] : privacy('Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, USA')[lang];
const title = kind === 'imprint' ? (en ? 'Imprint' : 'Impressum') : en ? 'Privacy policy' : 'Datenschutzerklärung';
const alt = kind === 'imprint' ? { en: '/imprint/', de: '/de/impressum/' } : { en: '/privacy/', de: '/de/datenschutz/' };
---

<Base lang={lang} title={`${title} | Micha Rössler`} description={title} alt={alt}>
	<div class="l-sheet">
		<div class="wrap">
			<div class="l">
				<h1>{title}</h1>
				{
					sections.map((s) => (
						<section>
							<h2>{s.h}</h2>
							{s.p.map((p) => (
								<p set:html={p} />
							))}
						</section>
					))
				}
			</div>
		</div>
	</div>
</Base>

<style>
	.l-sheet {
		padding-top: clamp(24px, 4vw, 56px);
	}
	.l {
		max-width: 68ch;
	}
	h1 {
		margin-bottom: 40px;
		font-size: clamp(30px, 2.4vw + 14px, 52px);
		letter-spacing: -0.025em;
		line-height: 1.15;
	}
	section {
		margin-top: 32px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}
	h2 {
		font-size: 15px;
		line-height: 1.4;
		margin-bottom: 12px;
	}
	p {
		font-size: 16px;
		line-height: 1.7;
		color: #cfcdc7;
		overflow-wrap: anywhere;
	}
	p + p {
		margin-top: 12px;
	}
</style>
