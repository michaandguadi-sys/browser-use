---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { type Lang } from '../i18n';
import { projects } from '../data/projects';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';
---

<Base
	lang={lang}
	title={en ? 'Work – Expedition, Documentary & Destination Films | Micha Rössler' : 'Projekte – Expeditions-, Doku- & Destinationsfilme | Micha Rössler'}
	description={en
		? 'Expedition films from the Bolivian Andes and Kilimanjaro, documentaries with 1.2M and 1.4M views, destination and hospitality films.'
		: 'Expeditionsfilme aus den bolivianischen Anden und vom Kilimandscharo, Dokus mit 1,2 und 1,4 Mio. Aufrufen, Destinations- und Hotelfilme.'}
	alt={{ en: '/work/', de: '/de/work/' }}
>
	<div class="wrap w">
		<p class="label">{en ? 'Index' : 'Übersicht'} · {projects.length}</p>
		<h1>{en ? 'Work' : 'Projekte'}</h1>
		<WorkGrid lang={lang} items={projects} headingLevel="h2" eagerFirst />
	</div>
</Base>

<style>
	.w {
		padding-top: clamp(24px, 4vw, 56px);
	}
	h1 {
		margin: 14px 0 clamp(48px, 6vw, 88px);
		font-size: clamp(36px, 4vw + 12px, 72px);
		letter-spacing: -0.03em;
		line-height: 1.05;
	}
</style>
