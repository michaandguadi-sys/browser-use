---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { href, type Lang } from '../i18n';
import { pic } from '../data/projects';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';

const timeline = en
	? [
			['2021', 'Drivers Eye – 24h Nürburgring documentary for Felix von der Laden: camera, edit, direction. 1.4M views.'],
			['2023', 'Winter hike to Trolltunga, Norway. Kilimanjaro via the Rongai route. Glacier tour on the Großvenediger (3,660 m). Sahara shoot with Fabian Baggeler.'],
			['2024', 'Four weeks in the Bolivian Andes for an upcoming documentary, with brand partner Hydraid. Start of full-time life on the road.'],
			['2025–26', 'Travel films with Guada as Guadi & Micha across Asia and the Americas. Format editing for brands like Carwow.'],
			['2027', 'Planned: Laponia midwinter ski traverse, Lyngen Alps, Arctic Circle Trail.'],
		]
	: [
			['2021', 'Drivers Eye – 24h-Nürburgring-Doku für Felix von der Laden: Kamera, Schnitt, Regie. 1,4 Mio. Aufrufe.'],
			['2023', 'Winterwanderung zur Trolltunga, Norwegen. Kilimandscharo über die Rongai-Route. Gletschertour am Großvenediger (3.660 m). Sahara-Dreh mit Fabian Baggeler.'],
			['2024', 'Vier Wochen in den bolivianischen Anden für eine kommende Doku, mit Markenpartner Hydraid. Beginn des Lebens auf Reisen.'],
			['2025–26', 'Reisefilme mit Guada als Guadi & Micha in Asien und Amerika. Format-Schnitt für Marken wie Carwow.'],
			['2027', 'Geplant: Laponia-Skidurchquerung im Hochwinter, Lyngen-Alpen, Arctic Circle Trail.'],
		];
---

<Base
	lang={lang}
	title={en ? 'About – Micha Rössler, Expedition Filmmaker from Germany' : 'Über mich – Micha Rössler, Outdoor-Filmemacher aus Bayern'}
	description={en
		? 'German expedition and adventure filmmaker, camera operator and documentary editor. Raised in a small Bavarian village, now filming on the road full-time.'
		: 'Expeditions- und Outdoor-Filmemacher, Kameramann und Dokumentarfilm-Cutter. Aufgewachsen in einem kleinen Dorf in Bayern, heute dauerhaft unterwegs.'}
	alt={{ en: '/about/', de: '/de/ueber-mich/' }}
	ogImage="kilimanjaro-ridge"
	sheet="A/03"
	solidHeader
>
	<div class="sheet sheet--basalt a">
		<div class="wrap g12 a-grid">
			<div class="a-main">
				<p class="meta">{en ? 'About' : 'Über mich'}</p>
				<h1 class="h2">{en ? 'Still looking for the next hard, honest story' : 'Immer auf der Suche nach der nächsten harten, ehrlichen Geschichte'}</h1>
				<div class="prose a-prose">
					{
						en ? (
							<>
								<p>I grew up in a small village in Bavaria, and the mountains were my first playground. For a while I almost lost that – until I started travelling and understood that the most important skill is being able to tell a story, to the right people, the right way.</p>
								<p>I learned the craft on long-form YouTube documentaries: directing, filming and editing for Felix von der Laden, whose 24h Nürburgring and Hotrodtour docs reached 1.4 and 1.2 million views. Since then I have filmed on Kilimanjaro, in the Sahara and in the Bolivian Andes.</p>
								<p>Today I live on the road with my partner Guada. My main terrain is mountains, snow and multi-day journeys. I care about fair work, people over spectacle and stories that do not need to be exaggerated.</p>
								<p>Practical bits, because you will wonder: I am German, I work in German and English, and I invoice through my own US company, Micha Roessler LLC, because I work on the road full-time. You always deal with me directly.</p>
							</>
						) : (
							<>
								<p>Ich bin in einem kleinen Dorf in Bayern aufgewachsen, die Berge waren mein erster Spielplatz. Eine Zeit lang hätte ich das fast verloren – bis ich angefangen habe zu reisen und verstanden habe, dass die wichtigste Fähigkeit ist, eine Geschichte zu erzählen: den richtigen Menschen, auf die richtige Weise.</p>
								<p>Das Handwerk habe ich bei langen YouTube-Dokumentationen gelernt: Regie, Kamera und Schnitt für Felix von der Laden, dessen Dokus über das 24h-Rennen am Nürburgring und die Hotrodtour 1,4 und 1,2 Millionen Aufrufe erreicht haben. Seitdem habe ich am Kilimandscharo, in der Sahara und in den bolivianischen Anden gedreht.</p>
								<p>Heute lebe ich mit meiner Partnerin Guada unterwegs. Mein Terrain sind Berge, Schnee und mehrtägige Touren. Mir sind faire Arbeit, Menschen statt Spektakel und Geschichten wichtig, die man nicht übertreiben muss.</p>
								<p>Ganz praktisch, weil die Frage sowieso kommt: Ich bin Deutscher, arbeite auf Deutsch und Englisch und rechne über meine eigene US-Firma Micha Roessler LLC ab, weil ich dauerhaft unterwegs arbeite. Ihr habt immer direkt mit mir zu tun.</p>
							</>
						)
					}
				</div>
			</div>
			<figure class="a-fig">
				<div class="grain"><Image src={portrait} alt="Micha Rössler" widths={[480, 720, 960, 1280]} sizes="(min-width: 960px) 30vw, 100vw" loading="eager" fetchpriority="high" /></div>
				<figcaption class="meta">Micha Rössler · {en ? 'filmmaker & editor' : 'Filmemacher & Cutter'}</figcaption>
			</figure>
		</div>

	</div>

	<section class="tl sheet sheet--firn" aria-labelledby="tl-h">
		<div class="wrap g12">
			<h2 id="tl-h" class="h2 tl-h">{en ? 'Timeline' : 'Stationen'}</h2>
			<div class="tl-body" data-trace>
				<svg class="tl-line" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true">
					<path class="trace" pathLength="1" d="M1 0V100"></path>
				</svg>
				<ol>
					{
						timeline.map(([y, txt]) => (
							<li>
								<span class="tl-y">{y}</span>
								<p>{txt}</p>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<section class="also sheet sheet--basalt">
		<div class="wrap g12">
			<div class="col-prose also-in">
				<p class="meta">{en ? 'Also' : 'Außerdem'}</p>
				<p class="prose">
					{en ? 'I build edit systems for recurring video formats – templates, data-driven graphics and shorts pipelines – at ' : 'Für wiederkehrende Videoformate baue ich Schnitt-Systeme – Templates, datengetriebene Grafiken und Shorts-Pipelines – bei '}
					<a href={en ? 'https://formatschnitt.de/en/' : 'https://formatschnitt.de/'}>formatschnitt.de</a>.
				</p>
				<a class="btn btn--primary" href={href(lang, 'contact')}>{en ? 'Work with me' : 'Zusammenarbeiten'}</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.a {
		padding-top: calc(var(--neat) + 56px + clamp(3rem, 7vw, 6rem));
		padding-bottom: clamp(4rem, 9vw, 7rem);
	}
	.a-grid {
		row-gap: 3rem;
	}
	@media (min-width: 960px) {
		.a-main {
			grid-column: 1 / 8 !important;
		}
		.a-fig {
			grid-column: 9 / 13 !important;
			position: sticky;
			top: 6rem;
			align-self: start;
		}
		.a-prose {
			margin-left: calc((100% + var(--colgap)) / 7);
		}
	}
	h1 {
		margin: 0.75rem 0 2.5rem;
		max-width: 18ch;
	}
	.a-fig {
		margin: 0;
	}
	.a-fig :global(img) {
		width: 100%;
	}
	.a-fig figcaption {
		margin-top: 0.6rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--rule);
	}
	.tl {
		padding-block: clamp(4rem, 9vw, 7rem);
	}
	.tl-h {
		margin-bottom: 2.5rem;
	}
	@media (min-width: 960px) {
		.tl-h {
			grid-column: 1 / 4 !important;
		}
		.tl-body {
			grid-column: 4 / 12 !important;
		}
	}
	.tl-body {
		position: relative;
		padding-left: clamp(1.25rem, 3vw, 2.5rem);
	}
	.tl-line {
		position: absolute;
		left: 0;
		top: 0;
		width: 2px;
		height: 100%;
		overflow: visible;
	}
	.tl ol {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--ink);
	}
	.tl li {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1rem;
		padding: 1.4rem 0;
		border-bottom: 1px solid var(--rule);
		align-items: baseline;
	}
	.tl-y {
		font-size: 32px;
		font-weight: 300;
		line-height: 1;
		color: var(--ochre);
		font-variant-numeric: tabular-nums lining-nums;
	}
	.tl p {
		max-width: 62ch;
	}
	.also {
		padding-block: clamp(4rem, 9vw, 7rem);
	}
	.also-in {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}
	@media (max-width: 560px) {
		.tl li {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
	}
</style>
