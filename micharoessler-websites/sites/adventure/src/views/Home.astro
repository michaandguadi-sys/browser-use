---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import YouTube from '../components/YouTube.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { href, ui, type Lang } from '../i18n';
import { projects, brands, creators, pic } from '../data/projects';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';

const services = en
	? [
			{
				n: '01',
				h: 'Expedition & mountain film',
				p: 'I join your expedition, ski traverse or climb as the camera: light kit, self-sufficient, fit enough to keep filming at altitude when it matters.',
			},
			{
				n: '02',
				h: 'Camera operator',
				p: 'Second unit or solo camera for creators, outdoor brands and productions. Cinema camera, drone and FPV, on location worldwide.',
			},
			{
				n: '03',
				h: 'Documentary editing',
				p: 'Story-first edits for documentaries with impact: structure, pacing and the moments that make people care. Long-form and cut-downs.',
			},
			{
				n: '04',
				h: 'Destination & hospitality films',
				p: 'For tourism boards, lodges and hotels: films that sell a place through the people and landscapes around it, in 16:9 and 9:16.',
			},
		]
	: [
			{
				n: '01',
				h: 'Expeditions- & Bergfilm',
				p: 'Ich begleite eure Expedition, Skidurchquerung oder Klettertour als Kamera: leichtes Kit, autark und fit genug, um auch in der Höhe weiterzudrehen, wenn es darauf ankommt.',
			},
			{
				n: '02',
				h: 'Kameramann',
				p: 'Second Unit oder Solo-Kamera für Creators, Outdoor-Marken und Produktionen. Cinema-Kamera, Drohne und FPV – weltweit vor Ort.',
			},
			{
				n: '03',
				h: 'Dokumentarfilm-Schnitt',
				p: 'Story-first-Schnitt für Dokumentarfilme mit Wirkung: Struktur, Rhythmus und die Momente, die berühren. Langform und Cut-downs.',
			},
			{
				n: '04',
				h: 'Destinations- & Hotelfilme',
				p: 'Für Tourismusverbände, Lodges und Hotels: Imagefilme, die einen Ort über seine Menschen und Landschaften verkaufen – in 16:9 und 9:16.',
			},
		];

const field = en
	? [
			['Highest shoot', 'Kilimanjaro summit, 5,895 m'],
			['Longest shoot', '4 weeks, Bolivian Andes'],
			['Kit', 'Sony A7S III · A7 IV, drone, FPV'],
			['Languages', 'German · English'],
			['Base', 'On the road full-time since 2024'],
			['Biggest doc audience', '1.4M views (Drivers Eye)'],
		]
	: [
			['Höchster Dreh', 'Kilimandscharo-Gipfel, 5.895 m'],
			['Längster Dreh', '4 Wochen, bolivianische Anden'],
			['Kit', 'Sony A7S III · A7 IV, Drohne, FPV'],
			['Sprachen', 'Deutsch · Englisch'],
			['Basis', 'Seit 2024 dauerhaft unterwegs'],
			['Größte Doku-Reichweite', '1,4 Mio. Aufrufe (Drivers Eye)'],
		];

const next = en
	? [
			['Feb 2027', 'Laponia midwinter ski traverse, Swedish Lapland', 'Planned'],
			['Feb 2027', 'Lyngen Alps ski touring, Norway', 'Planned'],
			['Jul 2027', 'Arctic Circle Trail, Greenland', 'Planned'],
		]
	: [
			['Feb. 2027', 'Laponia-Skidurchquerung im Hochwinter, Schwedisch-Lappland', 'Geplant'],
			['Feb. 2027', 'Skitouren in den Lyngen-Alpen, Norwegen', 'Geplant'],
			['Jul. 2027', 'Arctic Circle Trail, Grönland', 'Geplant'],
		];

const title = en
	? 'Micha Rössler – Expedition & Adventure Filmmaker, Camera Operator'
	: 'Micha Rössler – Expeditionsfilmer, Outdoor-Filmemacher & Kameramann';
const description = en
	? 'Expedition & adventure filmmaker for outdoor brands, expedition teams and tourism boards: mountain film, camera operator, documentary editing.'
	: 'Expeditions- & Outdoor-Filmemacher für Outdoor-Marken, Expeditionsteams und Tourismus: Bergfilm, Kameramann, Dokumentarfilm-Schnitt.';
// Stats band: numbers taken from the "field" facts above (no new data).
const split = (v: string, re: RegExp) => {
	const m = v.match(re);
	return m ? m[1] : v;
};
const stats = [
	{ n: split(field[5][1], /^([\d.,]+\s?(?:Mio\.|M))/), l: field[5][0] },
	{ n: split(field[0][1], /([\d.,]+ m)$/), l: field[0][0] },
	{ n: split(field[1][1], /^(\d+ \S+?),/), l: field[1][0] },
];
const facts = [field[2], field[3], field[4]];

const film = projects.find((p) => p.slug === 'drivers-eye-24h-nurburgring')!;
const heroImg = pic('bolivia-ridge-climbers');
const heroWidths = [640, 960, 1280, 1920, 2560];
const heroSizes = '(min-width: 1440px) 1280px, 92vw';
---

<Base lang={lang} title={title} description={description} alt={{ en: '/', de: '/de/' }} hero={{ src: heroImg, widths: heroWidths, sizes: heroSizes }}>
	<section class="wrap hero">
		<h1>
			<span class="label eyebrow">Micha Rössler · {t.role}</span>
			<span class="statement">
				{
					en
						? 'I film people at the edge of what they can do – on mountains, in snow, on multi-day journeys – and edit it into stories that are honest about what it took.'
						: 'Ich filme Menschen an der Grenze ihrer Möglichkeiten – am Berg, im Schnee, auf mehrtägigen Touren – und schneide daraus Geschichten, die ehrlich zeigen, was es gekostet hat.'
				}
			</span>
		</h1>
		<ul class="hero-meta">
			<li><Icon name="pin" />{en ? 'Available worldwide · based on the road' : 'Weltweit verfügbar · zuhause unterwegs'}</li>
			<li class="hm-rule" aria-hidden="true"></li>
			<li><a href="mailto:hello@micharoessler.com"><Icon name="mail" />hello@micharoessler.com</a></li>
		</ul>
		<div class="hero-media">
			<YouTube
				id={film.youtube!}
				title={film.title[lang]}
				lang={lang}
				poster={heroImg}
				alt={en ? 'Two climbers on a snowy ridge in the Bolivian Andes at dusk' : 'Zwei Bergsteiger auf einem verschneiten Grat in den bolivianischen Anden in der Dämmerung'}
				badge
				eager
				widths={heroWidths}
				sizes={heroSizes}
			/>
			<p class="hero-cap meta">
				<span>{film.title[lang]} · {film.kicker[lang]} · {film.year}</span>
				<a href={href(lang, film.slug)}>{t.viewFilm} →</a>
			</p>
		</div>
	</section>

	<section class="wrap section names" aria-labelledby="names-h">
		<h2 id="names-h" class="label names-h">{en ? 'Brands & creators I have worked with' : 'Marken & Creators, mit denen ich gearbeitet habe'}</h2>
		<ul class="names-row">{brands.map((b) => <li>{b}</li>)}</ul>
		<ul class="names-row names-row--c">{creators.map((c) => <li>{c}</li>)}</ul>
	</section>

	<section id="work" class="wrap section" aria-labelledby="work-h">
		<div class="head">
			<h2 id="work-h" class="h2">{en ? 'Selected work' : 'Ausgewählte Projekte'}</h2>
			<a class="link" href={href(lang, 'work')}>{t.allWork} →</a>
		</div>
		<WorkGrid lang={lang} items={projects} />
	</section>

	<section class="wrap section" aria-labelledby="svc-h">
		<div class="head">
			<h2 id="svc-h" class="h2">{en ? 'What I do' : 'Was ich mache'}</h2>
		</div>
		<ol class="services">
			{
				services.map((s) => (
					<li>
						<span class="meta">{s.n}</span>
						<h3>{s.h}</h3>
						<p>{s.p}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="wrap section" aria-labelledby="talk-h">
		<div class="band media">
			<Photo src="bolivia-snowfield" alt="" widths={[640, 960, 1280, 1920]} sizes="(min-width: 1440px) 1280px, 92vw" class="band-img" />
			<div class="band-in">
				<h2 id="talk-h" class="label band-k">{en ? "Let's talk" : 'Lass uns reden'}</h2>
				<span class="band-rule" aria-hidden="true"></span>
				<dl class="stats">
					{
						stats.map((s) => (
							<div>
								<dt class="meta">{s.l}</dt>
								<dd>{s.n}</dd>
							</div>
						))
					}
				</dl>
				<a class="btn" href={href(lang, 'contact')}>
					{t.cta}
					<Icon name="arrow" class="arrow" />
				</a>
			</div>
		</div>
	</section>

	<section class="wrap section field" aria-labelledby="field-h">
		<div>
			<p class="label">{en ? 'For expedition teams' : 'Für Expeditionsteams'}</p>
			<h2 id="field-h" class="h2">{en ? 'In the field' : 'Im Gelände'}</h2>
		</div>
		<div>
			<p class="prose field-p">
				{
					en
						? 'An expedition camera has to carry its own weight. I travel full-time, I am used to long days in cold and thin air, and I plan the shoot around the objective – never the other way round.'
						: 'Eine Expeditionskamera muss ihr eigenes Gewicht tragen. Ich reise dauerhaft, bin lange Tage in Kälte und dünner Luft gewohnt und plane den Dreh um das Ziel herum – nie umgekehrt.'
				}
			</p>
			<dl class="rows facts">
				{
					facts.map(([k, v]) => (
						<div>
							<dt class="meta">{k}</dt>
							<dd>{v}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="wrap section me" aria-labelledby="me-h">
		<div class="media me-img reveal">
			<Photo src={portrait} alt="Micha Rössler" widths={[480, 800, 1200]} sizes="(min-width: 900px) 34vw, 92vw" />
		</div>
		<div class="me-txt">
			<p class="label">{en ? 'Who you will work with' : 'Mit wem du arbeitest'}</p>
			<h2 id="me-h" class="h2">{en ? 'Hi, I am Micha.' : 'Hi, ich bin Micha.'}</h2>
			<p class="prose">
				{
					en
						? 'No agency, no account manager. When you write, I answer – and I am the one carrying the camera up the mountain and sitting in the edit afterwards.'
						: 'Keine Agentur, kein Account-Manager. Wenn du schreibst, antworte ich – und ich bin derjenige, der die Kamera auf den Berg trägt und danach im Schnitt sitzt.'
				}
			</p>
			<div class="actions">
				<a class="btn" href={href(lang, 'contact')}>{t.cta}</a>
				<a class="link" href={href(lang, 'about')}>{en ? 'My story' : 'Meine Geschichte'} →</a>
			</div>
		</div>
	</section>

	<section class="wrap section" aria-labelledby="next-h">
		<div class="head">
			<h2 id="next-h" class="h2">{en ? 'Next expeditions' : 'Nächste Expeditionen'}</h2>
			<p class="meta">{en ? 'Open for partners & sponsors' : 'Offen für Partner & Sponsoren'}</p>
		</div>
		<ul class="rows next-list">
			{
				next.map(([d, what, s]) => (
					<li>
						<span class="meta">{d}</span>
						<span class="next-what">{what}</span>
						<span class="meta next-s">{s}</span>
					</li>
				))
			}
		</ul>
		<a class="btn btn--ghost" href={href(lang, 'contact')}>{en ? 'Partner on a film' : 'Film unterstützen'}</a>
	</section>
</Base>

<style>
	.hero {
		padding-top: clamp(40px, 7vw, 96px);
	}
	h1 {
		display: grid;
		gap: clamp(20px, 2.4vw, 32px);
		font-size: inherit;
	}
	h1 .statement {
		max-width: 34ch;
	}
	.eyebrow {
		letter-spacing: 0.08em;
	}
	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.75rem;
		margin: clamp(48px, 7vw, 104px) 0 0;
		padding: 0;
		list-style: none;
		font-family: var(--mono);
		font-size: 14px;
	}
	.hero-meta li,
	.hero-meta a {
		display: inline-flex;
		align-items: center;
		gap: 0.7em;
		min-height: 44px;
		text-decoration: none;
	}
	.hero-meta a:hover {
		text-decoration: underline;
	}
	.hero-meta :global(.icon) {
		color: var(--muted);
	}
	.hm-rule {
		width: 48px;
		height: 1px;
		min-height: 0 !important;
		background: var(--line-2);
	}
	.hero-media {
		margin-top: clamp(40px, 6vw, 88px);
	}
	.hero-cap {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: 14px;
		font-size: 13px;
	}
	.hero-cap a {
		color: var(--ink);
		text-decoration: none;
	}
	.hero-cap a:hover {
		text-decoration: underline;
	}

	.names {
		text-align: center;
	}
	.names-h {
		margin-bottom: 28px;
	}
	.names-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.6rem 0;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--mono);
		font-size: clamp(14px, 0.4vw + 11px, 17px);
		color: #d9d7d1;
	}
	.names-row li + li::before {
		content: '';
		display: inline-block;
		width: clamp(16px, 2vw, 32px);
		height: 1px;
		margin-inline: clamp(10px, 1.2vw, 18px);
		vertical-align: middle;
		background: var(--line-2);
	}
	@media (max-width: 1000px) {
		.names-row {
			gap: 10px 28px;
		}
		.names-row li + li::before {
			display: none;
		}
	}
	.names-row--c {
		margin-top: 16px;
		font-size: 13px;
		color: var(--muted);
	}

	.services {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
		gap: 40px clamp(24px, 3vw, 48px);
	}
	.services li {
		display: grid;
		align-content: start;
		gap: 12px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}
	.services h3 {
		font-size: var(--t-title);
		line-height: 1.35;
	}
	.services p {
		color: var(--muted);
		font-size: 16px;
		line-height: 1.6;
	}

	.band {
		min-height: clamp(460px, 44vw, 600px);
		display: grid;
	}
	.band :global(picture),
	.band :global(.band-img) {
		position: absolute;
		inset: 0;
	}
	.band :global(.band-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.band::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(10 10 10 / 0.66);
	}
	.band-in {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		align-content: center;
		gap: clamp(28px, 3.5vw, 48px);
		padding: clamp(48px, 6vw, 80px) 24px;
		text-align: center;
	}
	.band-k {
		color: var(--ink);
		letter-spacing: 0.1em;
	}
	.band-rule {
		width: 1px;
		height: 32px;
		background: var(--line-2);
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 28px clamp(32px, 6vw, 96px);
		margin: 0;
	}
	.stats div {
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 6px;
	}
	.stats dd {
		margin: 0;
		font-family: var(--mono);
		font-size: clamp(32px, 3.4vw, 52px);
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}
	.stats dt {
		font-size: 13px;
		color: #c4c2bc;
	}

	.field {
		display: grid;
		gap: 32px clamp(24px, 4.5vw, 64px);
	}
	.field .h2 {
		margin-top: 14px;
	}
	.field-p {
		margin-bottom: 36px;
	}
	.facts div {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: 1rem;
		align-items: baseline;
	}
	.facts dd {
		margin: 0;
		font-family: var(--mono);
		font-size: 15px;
	}
	@media (min-width: 900px) {
		.field {
			grid-template-columns: 1fr 1fr;
		}
	}

	.me {
		display: grid;
		gap: 40px clamp(24px, 6vw, 96px);
		align-items: center;
	}
	@media (min-width: 900px) {
		.me {
			grid-template-columns: 5fr 7fr;
		}
	}
	.me-img {
		aspect-ratio: 4 / 5;
		max-width: 520px;
	}
	.me-img :global(img) {
		object-position: 50% 22%;
	}
	.me h2 {
		margin: 14px 0 24px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px 32px;
		margin-top: 36px;
	}

	.next-list {
		margin-bottom: 40px;
		border-top: 1px solid var(--line);
	}
	.next-list li {
		display: grid;
		grid-template-columns: 9rem 1fr auto;
		gap: 1rem;
		align-items: baseline;
		padding-block: 18px;
	}
	.next-what {
		font-family: var(--mono);
		font-size: var(--t-title);
		line-height: 1.4;
	}
	@media (max-width: 640px) {
		.hero-media :global(.yt) {
			aspect-ratio: 4 / 3;
		}
		.hero-cap {
			flex-direction: column;
		}
		.stats {
			flex-direction: column;
			gap: 22px;
		}
		.next-list li {
			grid-template-columns: 1fr auto;
		}
		.next-what {
			grid-column: 1 / -1;
			grid-row: 2;
		}
		.hm-rule {
			display: none;
		}
		.hero-meta {
			gap: 0;
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
