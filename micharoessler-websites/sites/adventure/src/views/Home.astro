---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { href, ui, type Lang } from '../i18n';
import { projects, brands, creators, pic } from '../data/projects';
import ExpeditionMap from '../components/ExpeditionMap.astro';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';

const services = en
	? [
			{
				n: '01',
				h: 'Expedition & mountain film',
				p: 'I join your expedition, ski traverse or climb as the camera: light kit, self-sufficient, fit enough to keep filming at altitude when it matters.',
			},
			{
				n: '02',
				h: 'Camera operator',
				p: 'Second unit or solo camera for creators, outdoor brands and productions. Cinema camera, drone and FPV, on location worldwide.',
			},
			{
				n: '03',
				h: 'Documentary editing',
				p: 'Story-first edits for documentaries with impact: structure, pacing and the moments that make people care. Long-form and cut-downs.',
			},
			{
				n: '04',
				h: 'Destination & hospitality films',
				p: 'For tourism boards, lodges and hotels: films that sell a place through the people and landscapes around it, in 16:9 and 9:16.',
			},
		]
	: [
			{
				n: '01',
				h: 'Expeditions- & Bergfilm',
				p: 'Ich begleite eure Expedition, Skidurchquerung oder Klettertour als Kamera: leichtes Kit, autark und fit genug, um auch in der Höhe weiterzudrehen, wenn es darauf ankommt.',
			},
			{
				n: '02',
				h: 'Kameramann',
				p: 'Second Unit oder Solo-Kamera für Creators, Outdoor-Marken und Produktionen. Cinema-Kamera, Drohne und FPV – weltweit vor Ort.',
			},
			{
				n: '03',
				h: 'Dokumentarfilm-Schnitt',
				p: 'Story-first-Schnitt für Dokumentarfilme mit Wirkung: Struktur, Rhythmus und die Momente, die berühren. Langform und Cut-downs.',
			},
			{
				n: '04',
				h: 'Destinations- & Hotelfilme',
				p: 'Für Tourismusverbände, Lodges und Hotels: Imagefilme, die einen Ort über seine Menschen und Landschaften verkaufen – in 16:9 und 9:16.',
			},
		];

const field = en
	? [
			['Highest shoot', 'Kilimanjaro summit, 5,895 m'],
			['Longest shoot', '4 weeks, Bolivian Andes'],
			['Kit', 'Sony full-frame cinema, drone, FPV'],
			['Languages', 'German · English'],
			['Base', 'On the road full-time since 2024'],
			['Biggest doc audience', '1.4M views (Drivers Eye)'],
		]
	: [
			['Höchster Dreh', 'Kilimandscharo-Gipfel, 5.895 m'],
			['Längster Dreh', '4 Wochen, bolivianische Anden'],
			['Kit', 'Sony Vollformat-Cinema, Drohne, FPV'],
			['Sprachen', 'Deutsch · Englisch'],
			['Basis', 'Seit 2024 dauerhaft unterwegs'],
			['Größte Doku-Reichweite', '1,4 Mio. Aufrufe (Drivers Eye)'],
		];

const next = en
	? [
			['Feb 2027', 'Laponia midwinter ski traverse, Swedish Lapland', 'Planned'],
			['Feb 2027', 'Lyngen Alps ski touring, Norway', 'Planned'],
			['Jul 2027', 'Arctic Circle Trail, Greenland', 'Planned'],
		]
	: [
			['Feb. 2027', 'Laponia-Skidurchquerung im Hochwinter, Schwedisch-Lappland', 'Geplant'],
			['Feb. 2027', 'Skitouren in den Lyngen-Alpen, Norwegen', 'Geplant'],
			['Jul. 2027', 'Arctic Circle Trail, Grönland', 'Geplant'],
		];

const title = en
	? 'Micha Rössler – Expedition & Adventure Filmmaker, Camera Operator'
	: 'Micha Rössler – Expeditionsfilmer, Outdoor-Filmemacher & Kameramann';
const description = en
	? 'Expedition & adventure filmmaker for outdoor brands, expedition teams and tourism boards: mountain film, camera operator, documentary editing.'
	: 'Expeditions- & Outdoor-Filmemacher für Outdoor-Marken, Expeditionsteams und Tourismus: Bergfilm, Kameramann, Dokumentarfilm-Schnitt.';
---

<Base lang={lang} title={title} description={description} alt={{ en: '/', de: '/de/' }}>
	<section class="hero">
		<Image
			src={pic('bolivia-ridge-climbers')}
			alt={en ? 'Two climbers on a snowy ridge in the Bolivian Andes at dusk' : 'Zwei Bergsteiger auf einem verschneiten Grat in den bolivianischen Anden in der Dämmerung'}
			widths={[640, 960, 1280, 1920, 2560]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			class="hero-img"
		/>
		<div class="hero-shade"></div>
		<div class="wrap hero-in">
			<p class="meta hero-meta">
				<span>{en ? 'Sajama region, Bolivia' : 'Sajama-Region, Bolivien'}</span>
				<span>4,000 m+</span>
				<span>2024</span>
			</p>
			<h1>
				<span class="wordmark">Micha Rössler</span>
				<span class="h1-role">{t.role}</span>
			</h1>
			<div class="hero-actions">
				<a class="btn btn--signal" href={href(lang, 'contact')}>{t.cta}</a>
				<a class="btn" href="#work">{en ? 'See the films' : 'Filme ansehen'}</a>
			</div>
		</div>
	</section>

	<section class="intro wrap">
		<p class="meta reveal">{en ? 'What I do' : 'Was ich mache'}</p>
		<p class="intro-lead">
			{
				(en
					? 'I film people at the edge of what they can do – on mountains, in snow, on multi-day journeys – and edit it into stories that are honest about what it took.'
					: 'Ich filme Menschen an der Grenze ihrer Möglichkeiten – am Berg, im Schnee, auf mehrtägigen Touren – und schneide daraus Geschichten, die ehrlich zeigen, was es gekostet hat.'
				)
					.split(' ')
					.map((w) => <span class="w">{w} </span>)
			}
		</p>
		<ol class="services">
			{
				services.map((s) => (
					<li class="reveal">
						<span class="meta">{s.n}</span>
						<h2>{s.h}</h2>
						<p>{s.p}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section id="work" class="work wrap" aria-labelledby="work-h">
		<div class="sec-head">
			<h2 id="work-h">{en ? 'Selected work' : 'Ausgewählte Projekte'}</h2>
			<a class="meta" href={href(lang, 'work')}>{t.allWork} →</a>
		</div>
		<ul class="grid">
			{
				projects.map((p, i) => (
					<li class:list={['card', 'reveal', { wide: i === 0 || (i === projects.length - 1 && projects.length % 2 === 0) }]}>
						<a href={href(lang, p.slug)}>
							<div class="card-img" style={`view-transition-name: p-${p.slug}`}>
								<Image
									src={pic(p.cover)}
									alt={p.title[lang]}
									widths={i === 0 ? [640, 960, 1440, 1920] : [480, 720, 960]}
									sizes={i === 0 ? '(min-width: 900px) 92vw, 100vw' : '(min-width: 900px) 45vw, 100vw'}
								/>
							</div>
							<div class="card-txt">
								<p class="meta">
									{p.kicker[lang]}
									{p.year && <> · {p.year}</>}
								</p>
								<h3>{p.title[lang]}</h3>
								<p class="card-sum">{p.summary[lang]}</p>
								<p class="meta card-role">
									{p.roles[lang]}
									{p.client && <> · {p.client}</>}
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
		<span class="pill" aria-hidden="true">{t.viewFilm} →</span>
	</section>

	<section class="wrap mapsec" aria-labelledby="map-h">
		<div class="sec-head">
			<h2 id="map-h">{en ? 'Where I have filmed' : 'Wo ich gedreht habe'}</h2>
			<p class="meta">{en ? 'Hover or tap a pin' : 'Pin antippen oder überfahren'}</p>
		</div>
		<ExpeditionMap lang={lang} />
	</section>

	<section class="field" aria-labelledby="field-h">
		<div class="wrap field-in">
			<div>
				<p class="meta">{en ? 'For expedition teams' : 'Für Expeditionsteams'}</p>
				<h2 id="field-h">{en ? 'In the field' : 'Im Gelände'}</h2>
				<p class="prose field-p">
					{
						en
							? 'An expedition camera has to carry its own weight. I travel full-time, I am used to long days in cold and thin air, and I plan the shoot around the objective – never the other way round.'
							: 'Eine Expeditionskamera muss ihr eigenes Gewicht tragen. Ich reise dauerhaft, bin lange Tage in Kälte und dünner Luft gewohnt und plane den Dreh um das Ziel herum – nie umgekehrt.'
					}
				</p>
			</div>
			<dl class="facts">
				{
					field.map(([k, v]) => (
						<div class="reveal">
							<dt class="meta">{k}</dt>
							<dd>{v}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="names wrap" aria-labelledby="names-h">
		<h2 id="names-h" class="meta">{en ? 'Brands & creators I have worked with' : 'Marken & Creators, mit denen ich gearbeitet habe'}</h2>
		<p class="names-list reveal">
			{brands.join(' · ')}
		</p>
		<p class="names-list names-list--c reveal">
			{creators.join(' · ')}
		</p>
	</section>

	<section class="next wrap" aria-labelledby="next-h">
		<div class="sec-head">
			<h2 id="next-h">{en ? 'Next expeditions' : 'Nächste Expeditionen'}</h2>
			<p class="meta">{en ? 'Open for partners & sponsors' : 'Offen für Partner & Sponsoren'}</p>
		</div>
		<ul class="next-list">
			{
				next.map(([d, what, s]) => (
					<li class="reveal">
						<span class="meta">{d}</span>
						<span class="next-what">{what}</span>
						<span class="meta next-s">{s}</span>
					</li>
				))
			}
		</ul>
		<a class="btn btn--signal" href={href(lang, 'contact')}>{en ? 'Partner on a film' : 'Film unterstützen'}</a>
	</section>
</Base>

<script>
	// "View project" pill follows the cursor over work cards (fine pointers only).
	if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
		const pill = document.querySelector<HTMLElement>('.pill');
		const cards = document.querySelectorAll<HTMLElement>('.card a');
		if (pill) {
			let x = 0, y = 0, raf = 0;
			const move = () => {
				pill.style.transform = `translate(${x + 14}px, ${y + 14}px)`;
				raf = 0;
			};
			cards.forEach((c) => {
				c.addEventListener('pointerenter', () => pill.classList.add('on'));
				c.addEventListener('pointerleave', () => pill.classList.remove('on'));
				c.addEventListener('pointermove', (e) => {
					x = e.clientX;
					y = e.clientY;
					if (!raf) raf = requestAnimationFrame(move);
				});
			});
		}
	}
</script>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: grid;
		align-items: end;
		overflow: hidden;
	}
	.hero-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
		animation: drift 30s var(--ease) both;
	}
	@keyframes drift {
		from {
			scale: 1.08;
		}
		to {
			scale: 1;
		}
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgb(14 15 13 / 0.92) 0%, rgb(14 15 13 / 0.35) 45%, rgb(14 15 13 / 0) 70%),
			linear-gradient(to bottom, rgb(14 15 13 / 0.5), transparent 20%);
	}
	.hero-in {
		position: relative;
		padding-bottom: clamp(2rem, 6vw, 4.5rem);
	}
	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
		color: var(--firn);
		opacity: 0.85;
	}
	.hero-meta span + span::before {
		content: '';
		display: inline-block;
		width: 1.5rem;
		height: 1px;
		background: currentColor;
		vertical-align: middle;
		margin-right: 1.5rem;
		opacity: 0.5;
	}
	@media (max-width: 600px) {
		.hero-meta {
			gap: 0.3rem 0.9rem;
		}
		.hero-meta span + span::before {
			display: none;
		}
	}
	h1 {
		margin-top: 1rem;
		text-transform: none;
	}
	.wordmark {
		display: block;
		font-size: clamp(3.6rem, 15.5vw, 10rem);
		font-stretch: 62%;
		font-weight: 800;
		text-transform: uppercase;
		line-height: 0.82;
		letter-spacing: -0.02em;
	}
	.h1-role {
		display: block;
		margin-top: 1rem;
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
		font-size: var(--step-3);
		line-height: 1.1;
		letter-spacing: 0;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.intro {
		padding-top: clamp(5rem, 12vw, 10rem);
	}
	.intro-lead {
		margin-top: 1.25rem;
		font-family: var(--serif);
		font-size: clamp(1.6rem, 3.6vw, 3rem);
		line-height: 1.18;
		max-width: 24em;
	}
	.services {
		list-style: none;
		margin: clamp(3rem, 7vw, 5rem) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		border-top: 1px solid var(--moraine-2);
	}
	.services li {
		padding: 1.75rem 1.5rem 2rem 0;
		border-bottom: 1px solid var(--moraine-2);
	}
	.services h2 {
		font-size: var(--step-3);
		margin: 0.75rem 0 1rem;
	}
	.services p {
		color: #c9c7c0;
		max-width: 30em;
	}

	.sec-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.sec-head h2 {
		font-size: var(--step-6);
	}
	.sec-head a {
		text-decoration: none;
	}
	.sec-head a:hover {
		color: var(--signal);
	}

	.work {
		padding-top: clamp(5rem, 12vw, 9rem);
	}
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 3vw, 2.5rem);
	}
	@media (min-width: 900px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.card.wide {
			grid-column: 1 / -1;
		}
		.card.wide .card-img {
			aspect-ratio: 21 / 9;
		}
	}
	.card a {
		text-decoration: none;
		display: block;
	}
	.card-img {
		overflow: hidden;
		aspect-ratio: 3 / 2;
		background: var(--moraine);
	}
	.card-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			scale 0.8s var(--ease),
			filter 0.8s var(--ease);
		filter: saturate(0.92);
	}
	.card a:hover .card-img img {
		scale: 1.035;
		filter: saturate(1.05);
	}
	.card-txt {
		padding-top: 1.1rem;
	}
	.card h3 {
		font-size: var(--step-4);
		margin: 0.5rem 0 0.75rem;
		transition: color 0.3s;
	}
	.card a:hover h3 {
		color: var(--signal);
	}
	.card-sum {
		font-family: var(--serif);
		font-size: 1.15rem;
		line-height: 1.45;
		color: #d6d4cd;
		max-width: 34em;
	}
	.card-role {
		margin-top: 0.9rem;
	}

	/* Scroll-driven word reveal (progressive: without support the text is simply fully visible). */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.intro-lead .w {
				animation: word linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 38%;
			}
		}
	}
	@keyframes word {
		from {
			opacity: 0.16;
		}
		to {
			opacity: 1;
		}
	}

	.pill {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 40;
		padding: 0.7em 1.1em;
		border-radius: 999px;
		background: var(--signal);
		color: #fff;
		font-weight: 650;
		font-stretch: 90%;
		font-size: var(--step--1);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		pointer-events: none;
		opacity: 0;
		scale: 0.6;
		transition:
			opacity 0.2s var(--ease),
			scale 0.2s var(--ease);
		white-space: nowrap;
	}
	.pill.on {
		opacity: 1;
		scale: 1;
	}

	.mapsec {
		padding-top: clamp(5rem, 12vw, 9rem);
	}

	.field {
		margin-top: clamp(5rem, 12vw, 9rem);
		background: var(--paper);
		color: var(--basalt);
		padding-block: clamp(4rem, 9vw, 7rem);
	}
	.field .meta {
		color: #5d625a;
	}
	.field-in {
		display: grid;
		gap: 3rem;
	}
	@media (min-width: 900px) {
		.field-in {
			grid-template-columns: 1fr 1.2fr;
			align-items: start;
		}
	}
	.field h2 {
		font-size: var(--step-6);
		margin: 0.75rem 0 1.5rem;
	}
	.facts {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		border-top: 1px solid #cfccc3;
	}
	.facts div {
		padding: 1.25rem 1rem 1.25rem 0;
		border-bottom: 1px solid #cfccc3;
	}
	.facts dd {
		margin: 0.4rem 0 0;
		font-weight: 650;
		font-stretch: 80%;
		font-size: var(--step-1);
		line-height: 1.2;
	}

	.names {
		padding-top: clamp(5rem, 10vw, 8rem);
	}
	.names-list {
		margin-top: 1.25rem;
		font-weight: 750;
		font-stretch: 65%;
		text-transform: uppercase;
		font-size: clamp(1.6rem, 4.6vw, 3.6rem);
		line-height: 1.05;
	}
	.names-list--c {
		color: var(--lichen);
	}

	.next {
		padding-top: clamp(5rem, 10vw, 8rem);
	}
	.next-list {
		list-style: none;
		margin: 0 0 2.5rem;
		padding: 0;
		border-top: 1px solid var(--moraine-2);
	}
	.next-list li {
		display: grid;
		grid-template-columns: 7rem 1fr auto;
		gap: 1rem;
		align-items: baseline;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--moraine-2);
	}
	.next-what {
		font-family: var(--serif);
		font-size: var(--step-1);
	}
	.next-s {
		color: var(--glacier);
	}
	@media (max-width: 600px) {
		.next-list li {
			grid-template-columns: 1fr auto;
		}
		.next-what {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
