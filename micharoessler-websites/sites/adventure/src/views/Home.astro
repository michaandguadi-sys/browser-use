---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { href, ui, type Lang } from '../i18n';
import { projects, brands, creators, pic } from '../data/projects';
import ExpeditionMap from '../components/ExpeditionMap.astro';
import Terrain from '../components/Terrain.astro';
import Log from '../components/Log.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { places, dms } from '../data/terrain';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';

const services = en
	? [
			{
				n: '01',
				h: 'Expedition & mountain film',
				p: 'I join your expedition, ski traverse or climb as the camera: light kit, self-sufficient, fit enough to keep filming at altitude when it matters.',
			},
			{
				n: '02',
				h: 'Camera operator',
				p: 'Second unit or solo camera for creators, outdoor brands and productions. Cinema camera, drone and FPV, on location worldwide.',
			},
			{
				n: '03',
				h: 'Documentary editing',
				p: 'Story-first edits for documentaries with impact: structure, pacing and the moments that make people care. Long-form and cut-downs.',
			},
			{
				n: '04',
				h: 'Destination & hospitality films',
				p: 'For tourism boards, lodges and hotels: films that sell a place through the people and landscapes around it, in 16:9 and 9:16.',
			},
		]
	: [
			{
				n: '01',
				h: 'Expeditions- & Bergfilm',
				p: 'Ich begleite eure Expedition, Skidurchquerung oder Klettertour als Kamera: leichtes Kit, autark und fit genug, um auch in der Höhe weiterzudrehen, wenn es darauf ankommt.',
			},
			{
				n: '02',
				h: 'Kameramann',
				p: 'Second Unit oder Solo-Kamera für Creators, Outdoor-Marken und Produktionen. Cinema-Kamera, Drohne und FPV – weltweit vor Ort.',
			},
			{
				n: '03',
				h: 'Dokumentarfilm-Schnitt',
				p: 'Story-first-Schnitt für Dokumentarfilme mit Wirkung: Struktur, Rhythmus und die Momente, die berühren. Langform und Cut-downs.',
			},
			{
				n: '04',
				h: 'Destinations- & Hotelfilme',
				p: 'Für Tourismusverbände, Lodges und Hotels: Imagefilme, die einen Ort über seine Menschen und Landschaften verkaufen – in 16:9 und 9:16.',
			},
		];

const field = en
	? [
			['Highest shoot', 'Kilimanjaro summit, 5,895 m'],
			['Longest shoot', '4 weeks, Bolivian Andes'],
			['Kit', 'Sony A7S III · A7 IV, drone, FPV'],
			['Languages', 'German · English'],
			['Base', 'On the road full-time since 2024'],
			['Biggest doc audience', '1.4M views (Drivers Eye)'],
		]
	: [
			['Höchster Dreh', 'Kilimandscharo-Gipfel, 5.895 m'],
			['Längster Dreh', '4 Wochen, bolivianische Anden'],
			['Kit', 'Sony A7S III · A7 IV, Drohne, FPV'],
			['Sprachen', 'Deutsch · Englisch'],
			['Basis', 'Seit 2024 dauerhaft unterwegs'],
			['Größte Doku-Reichweite', '1,4 Mio. Aufrufe (Drivers Eye)'],
		];

const next = en
	? [
			['Feb 2027', 'Laponia midwinter ski traverse, Swedish Lapland', 'Planned'],
			['Feb 2027', 'Lyngen Alps ski touring, Norway', 'Planned'],
			['Jul 2027', 'Arctic Circle Trail, Greenland', 'Planned'],
		]
	: [
			['Feb. 2027', 'Laponia-Skidurchquerung im Hochwinter, Schwedisch-Lappland', 'Geplant'],
			['Feb. 2027', 'Skitouren in den Lyngen-Alpen, Norwegen', 'Geplant'],
			['Jul. 2027', 'Arctic Circle Trail, Grönland', 'Geplant'],
		];

const title = en
	? 'Micha Rössler – Expedition & Adventure Filmmaker, Camera Operator'
	: 'Micha Rössler – Expeditionsfilmer, Outdoor-Filmemacher & Kameramann';
const description = en
	? 'Expedition & adventure filmmaker for outdoor brands, expedition teams and tourism boards: mountain film, camera operator, documentary editing.'
	: 'Expeditions- & Outdoor-Filmemacher für Outdoor-Marken, Expeditionsteams und Tourismus: Bergfilm, Kameramann, Dokumentarfilm-Schnitt.';
const plate = en ? 'Plate' : 'Tafel';
const pad = (n: number) => String(n).padStart(2, '0');
const heroPlace = dms(places['bolivia-andes'], lang);
const sahara = projects.find((p) => p.slug === 'moroccan-sahara')!;
const roll = [
	{ src: 'sahara-dusk-dunes', alt: en ? 'Dunes of the Moroccan Sahara at dusk' : 'Dünen der marokkanischen Sahara in der Dämmerung' },
	{ src: 'sahara-lone-walker', alt: en ? 'A man with a backpack standing on a dune in the Moroccan Sahara' : 'Ein Mann mit Rucksack auf einer Düne in der marokkanischen Sahara' },
	{ src: 'sahara-dunes', alt: en ? 'A man carrying palm fronds below the dunes of the Moroccan Sahara' : 'Ein Mann mit Palmwedeln unterhalb der Dünen der marokkanischen Sahara' },
	{ src: 'sahara-flag-plain', alt: en ? 'Two people with a flag on a gravel plain in the Moroccan Sahara' : 'Zwei Personen mit einer Fahne auf einer Geröllebene in der marokkanischen Sahara' },
	{ src: 'sahara-mesa-vertical', alt: en ? 'Rock formations in the Moroccan Sahara' : 'Felsformationen in der marokkanischen Sahara' },
];
---

<Base lang={lang} title={title} description={description} alt={{ en: '/', de: '/de/' }} sheet="A/01" place={places['bolivia-andes']}>
	<section class="hero sheet sheet--basalt">
		<div class="wrap">
			<p class="meta hero-top">
				<span>{heroPlace.lat} {heroPlace.lon}</span>
				<span>2.39 : 1</span>
			</p>
			<div class="hero-frame grain">
				<Image
					src={pic('bolivia-ridge-climbers')}
					alt={en ? 'Two climbers on a snowy ridge in the Bolivian Andes at dusk' : 'Zwei Bergsteiger auf einem verschneiten Grat in den bolivianischen Anden in der Dämmerung'}
					widths={[640, 960, 1280, 1440, 1920, 2560]}
					sizes="(min-width: 1440px) 1330px, 94vw"
					loading="eager"
					fetchpriority="high"
					class="hero-img"
				/>
			</div>
			<div class="hero-card">
				<h1>
					<span class="display wordmark">Micha Rössler</span>
					<span class="lede h1-role">{t.role}</span>
				</h1>
				<dl class="hero-credits">
					<div><dt class="meta">{t.location_l}</dt><dd>{en ? 'Sajama region, Bolivia' : 'Sajama-Region, Bolivien'}</dd></div>
					<div><dt class="meta">{en ? 'Altitude' : 'Höhe'}</dt><dd>4,000 m+</dd></div>
					<div><dt class="meta">{t.year_l}</dt><dd>2024</dd></div>
				</dl>
				<div class="hero-actions">
					<a class="btn btn--primary" href={href(lang, 'contact')}>{t.cta}</a>
					<a class="ulink" href="#work">{en ? 'See the films' : 'Filme ansehen'}</a>
				</div>
			</div>
		</div>
	</section>

	<section class="intro sheet sheet--firn" aria-labelledby="intro-h">
		<div class="wrap g12">
			<p class="meta intro-k" id="intro-h">{en ? 'What I do' : 'Was ich mache'}</p>
			<p class="lede intro-lead">
				{
					en
						? 'I film people at the edge of what they can do – on mountains, in snow, on multi-day journeys – and edit it into stories that are honest about what it took.'
						: 'Ich filme Menschen an der Grenze ihrer Möglichkeiten – am Berg, im Schnee, auf mehrtägigen Touren – und schneide daraus Geschichten, die ehrlich zeigen, was es gekostet hat.'
				}
			</p>
			<ol class="services">
				{
					services.map((s) => (
						<li>
							<span class="svc-n" aria-hidden="true">{s.n}</span>
							<h2>{s.h}</h2>
							<p>{s.p}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="work" class="work sheet sheet--basalt" aria-labelledby="work-h">
		<div class="wrap">
			<div class="sec-head">
				<h2 id="work-h" class="h2">{en ? 'Selected work' : 'Ausgewählte Projekte'}</h2>
				<a class="ulink" href={href(lang, 'work')}>{t.allWork} →</a>
			</div>
			<ul class="grid">
				{
					projects.map((p, i) => (
						<li class:list={['card', { wide: i === 0 || (i === projects.length - 1 && projects.length % 2 === 0) }]}>
							<a href={href(lang, p.slug)}>
								<div class="card-img grain" style={`view-transition-name: p-${p.slug}`}>
									<Image
										src={pic(p.cover)}
										alt={p.title[lang]}
										widths={i === 0 ? [640, 960, 1440, 1920] : [480, 720, 960]}
										sizes={i === 0 ? '(min-width: 900px) 92vw, 100vw' : '(min-width: 900px) 45vw, 100vw'}
									/>
								</div>
								<div class="card-txt">
									<p class="card-line">
										<span class="plate">
											{plate} <b>{pad(i + 1)}</b> / {pad(projects.length)}
										</span>
										<span class="meta">
											{p.kicker[lang]}
											{p.year && <> · {p.year}</>}
										</span>
									</p>
									<h3>{p.title[lang]}</h3>
									<p class="card-sum">{p.summary[lang]}</p>
									<p class="meta card-role">
										{p.roles[lang]}
										{p.client && <> · {p.client}</>}
									</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<span class="pill" aria-hidden="true">{t.viewFilm} →</span>
		<div class="roll">
			<ContactStrip
				lang={lang}
				frames={roll}
				pick={1}
				href={href(lang, sahara.slug)}
				label={sahara.title[lang]}
				caption={`${sahara.title[lang]} · ${sahara.location[lang]} · ${sahara.year} · ${en ? 'Photos' : 'Fotos'}: Fabian Baggeler`}
			/>
		</div>
	</section>

	<section class="mapsec sheet sheet--firn" aria-labelledby="map-h">
		<div class="wrap">
			<div class="sec-head">
				<h2 id="map-h" class="h2">{en ? 'Where I have filmed' : 'Wo ich gedreht habe'}</h2>
				<p class="meta">{en ? 'Hover or tap a pin' : 'Pin antippen oder überfahren'}</p>
			</div>
			<ExpeditionMap lang={lang} />
		</div>
	</section>

	<section class="field sheet sheet--basalt" aria-labelledby="field-h">
		<div class="wrap field-in">
			<div class="field-txt">
				<p class="meta">{en ? 'For expedition teams' : 'Für Expeditionsteams'}</p>
				<h2 id="field-h" class="h2">{en ? 'In the field' : 'Im Gelände'}</h2>
				<p class="prose field-p">
					{
						en
							? 'An expedition camera has to carry its own weight. I travel full-time, I am used to long days in cold and thin air, and I plan the shoot around the objective – never the other way round.'
							: 'Eine Expeditionskamera muss ihr eigenes Gewicht tragen. Ich reise dauerhaft, bin lange Tage in Kälte und dünner Luft gewohnt und plane den Dreh um das Ziel herum – nie umgekehrt.'
					}
				</p>
				<Log lang={lang} id="log-h" title={en ? 'Log' : 'Protokoll'} rows={field as [string, string][]} />
			</div>
			<div class="field-map">
				<Terrain id="kilimanjaro" lang={lang} section name={en ? 'Uhuru Peak, 5,895 m' : 'Uhuru Peak, 5.895 m'} />
			</div>
		</div>
	</section>

	<section class="names sheet sheet--firn" aria-labelledby="names-h">
		<div class="wrap g12">
			<h2 id="names-h" class="meta names-h">{en ? 'Brands & creators I have worked with' : 'Marken & Creators, mit denen ich gearbeitet habe'}</h2>
			<p class="names-list">
				{brands.join(' · ')}
			</p>
			<p class="names-list names-list--c">
				{creators.join(' · ')}
			</p>
		</div>
	</section>

	<section class="me sheet sheet--basalt" aria-labelledby="me-h">
		<div class="wrap me-in">
			<div class="me-img grain reveal">
				<Image src={portrait} alt="Micha Rössler" widths={[400, 640, 900]} sizes="(min-width: 900px) 34vw, 80vw" />
			</div>
			<div class="me-txt">
				<p class="meta">{en ? 'Who you will work with' : 'Mit wem du arbeitest'}</p>
				<h2 id="me-h" class="h2">{en ? 'Hi, I am Micha.' : 'Hi, ich bin Micha.'}</h2>
				<p class="prose">
					{
						en
							? 'No agency, no account manager. When you write, I answer – and I am the one carrying the camera up the mountain and sitting in the edit afterwards.'
							: 'Keine Agentur, kein Account-Manager. Wenn du schreibst, antworte ich – und ich bin derjenige, der die Kamera auf den Berg trägt und danach im Schnitt sitzt.'
					}
				</p>
				<div class="me-actions">
					<a class="btn btn--primary" href={href(lang, 'contact')}>{t.cta}</a>
					<a class="ulink" href={href(lang, 'about')}>{en ? 'My story' : 'Meine Geschichte'}</a>
				</div>
			</div>
		</div>

		<div class="wrap next" aria-labelledby="next-h" role="region">
			<div class="sec-head">
				<h2 id="next-h" class="h2">{en ? 'Next expeditions' : 'Nächste Expeditionen'}</h2>
				<p class="meta">{en ? 'Open for partners & sponsors' : 'Offen für Partner & Sponsoren'}</p>
			</div>
			<ul class="next-list">
				{
					next.map(([d, what, s]) => (
						<li>
							<span class="next-d">{d}</span>
							<span class="next-what">{what}</span>
							<span class="meta next-s">{s}</span>
						</li>
					))
				}
			</ul>
			<a class="btn btn--primary" href={href(lang, 'contact')}>{en ? 'Partner on a film' : 'Film unterstützen'}</a>
		</div>
	</section>
</Base>

<script>
	// "View project" label follows the cursor over work cards (fine pointers only).
	if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
		const pill = document.querySelector<HTMLElement>('.pill');
		const cards = document.querySelectorAll<HTMLElement>('.card a');
		if (pill) {
			let x = 0,
				y = 0,
				raf = 0;
			const move = () => {
				pill.style.transform = `translate3d(${x + 16}px, ${y + 16}px, 0)`;
				raf = 0;
			};
			cards.forEach((c) => {
				c.addEventListener('pointerenter', () => pill.classList.add('on'));
				c.addEventListener('pointerleave', () => pill.classList.remove('on'));
				c.addEventListener('pointermove', (e) => {
					x = e.clientX;
					y = e.clientY;
					if (!raf) raf = requestAnimationFrame(move);
				});
			});
		}
	}
</script>

<style>
	/* Title card: 2.39:1 letterboxed frame, serif name, credit lines in mono. */
	.hero {
		padding-top: calc(var(--neat) + 56px + clamp(0.75rem, 2vw, 1.5rem));
		padding-bottom: clamp(3rem, 7vw, 6rem);
	}
	.hero-top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.6rem;
		color: var(--firn);
	}
	.hero-frame {
		aspect-ratio: 4 / 3;
		width: 100%;
	}
	@media (min-width: 700px) {
		.hero-frame {
			aspect-ratio: 2.39 / 1;
			width: min(100%, calc((100svh - 330px) * 2.39));
			min-width: min(100%, 640px);
		}
	}
	.hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 62%;
	}
	.hero-card {
		display: grid;
		gap: 1.5rem 2rem;
		padding-top: clamp(0.9rem, 1.8vw, 1.6rem);
	}
	h1 {
		display: grid;
		gap: clamp(0.6rem, 1.4vw, 1.2rem);
	}
	.wordmark {
		display: block;
		margin-left: -0.04em;
	}
	.h1-role {
		font-style: italic;
		color: var(--firn);
	}
	.hero-credits {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, auto);
		justify-content: start;
		gap: 0.5rem 2.5rem;
	}
	.hero-credits dd {
		margin: 0.1rem 0 0;
		font-family: var(--mono);
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.75rem;
	}
	@media (min-width: 1000px) {
		.hero-card {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--colgap);
			align-items: end;
		}
		h1 {
			grid-column: 1 / 10;
			grid-row: 1 / 3;
		}
		.hero-credits {
			grid-column: 10 / 13;
			grid-row: 1;
			grid-template-columns: 1fr;
			align-self: end;
			border-left: 1px solid var(--rule);
			padding-left: 1rem;
		}
		.hero-actions {
			grid-column: 10 / 13;
			grid-row: 2;
		}
	}
	@media (max-width: 520px) {
		.hero-credits {
			grid-template-columns: repeat(2, auto);
		}
	}

	.intro {
		padding-block: clamp(4.5rem, 10vw, 9rem);
	}
	.intro-k {
		align-self: start;
		padding-top: 0.7rem;
	}
	.intro-lead {
		margin-top: 1rem;
	}
	@media (min-width: 960px) {
		.intro-k {
			grid-column: 1 / 2;
		}
		.intro-lead {
			grid-column: 2 / 11;
			margin-top: 0;
		}
		.services {
			grid-column: 2 / 13 !important;
		}
	}
	.services {
		list-style: none;
		margin: clamp(3rem, 7vw, 5.5rem) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		column-gap: clamp(1.5rem, 4vw, 4rem);
		border-top: 1px solid var(--ink);
	}
	.services li {
		display: grid;
		grid-template-columns: 3.4rem 1fr;
		column-gap: 0.75rem;
		padding: 1.5rem 1.5rem 2.25rem 0;
		border-bottom: 1px solid var(--rule);
	}
	@media (min-width: 760px) {
		.services {
			grid-template-columns: 1fr 1fr;
		}
	}
	.svc-n {
		grid-row: 1 / 3;
		font-size: 28px;
		font-weight: 300;
		line-height: 1;
		color: var(--ochre);
		font-variant-numeric: tabular-nums;
	}
	.services h2 {
		font-size: var(--t-h3);
		margin: 0 0 0.8rem;
	}
	.services p {
		grid-column: 2;
		max-width: 38ch;
	}

	.sec-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--rule);
	}

	.work {
		padding-top: clamp(4.5rem, 10vw, 8rem);
	}
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(3rem, 5vw, 4.5rem) var(--colgap);
	}
	@media (min-width: 900px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.card.wide {
			grid-column: 1 / -1;
		}
		.card.wide .card-img {
			aspect-ratio: 2.39 / 1;
		}
		.card.wide .card-txt {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--colgap);
		}
		.card.wide .card-txt > * {
			grid-column: 1 / 8;
		}
		.card.wide .card-txt > .card-line {
			grid-column: 1 / -1;
		}
	}
	.card a {
		text-decoration: none;
		display: block;
	}
	.card-img {
		aspect-ratio: 3 / 2;
	}
	.card-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.9);
		transition: filter 0.5s var(--ease);
	}
	.card a:hover .card-img :global(img) {
		filter: saturate(1.05);
	}
	.card-txt {
		padding-top: 0.75rem;
	}
	.card-line {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--rule);
	}
	.card h3 {
		font-size: var(--t-h3);
		margin: 1rem 0 0.6rem;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
		transition: text-decoration-color 0.25s var(--ease);
	}
	.card a:hover h3 {
		text-decoration-color: var(--ochre);
	}
	.card-sum {
		max-width: 52ch;
		color: #d8d6cf;
	}
	.card-role {
		margin-top: 0.9rem;
	}
	.pill {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 40;
		padding: 0.55em 0.9em;
		background: var(--basalt);
		color: var(--firn);
		border: 1px solid var(--firn);
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s var(--ease);
		white-space: nowrap;
	}
	.pill.on {
		opacity: 1;
	}
	.roll {
