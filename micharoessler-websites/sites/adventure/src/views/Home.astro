---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Reel from '../components/Reel.astro';
import WorkGrid from '../components/WorkGrid.astro';
import FilmStrip from '../components/FilmStrip.astro';
import ExpeditionMap from '../components/ExpeditionMap.astro';
import Testimonials from '../components/Testimonials.astro';
import { href, ui, type Lang } from '../i18n';
import { projects, brands, creators, pic } from '../data/projects';
import { timelineOf } from '../data/timeline';
import { faq } from '../data/faq';
import { buildArt } from '../lib/img';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';

const services = en
	? [
			{
				n: '01',
				h: 'Expedition & mountain film',
				p: 'I join your expedition, ski traverse or climb as the camera: light kit, self-sufficient, fit enough to keep filming at altitude when it matters.',
			},
			{
				n: '02',
				h: 'Camera operator',
				p: 'Second unit or solo camera for creators, outdoor brands and productions. Cinema camera, drone and FPV, on location worldwide.',
			},
			{
				n: '03',
				h: 'Documentary editing',
				p: 'Story-first edits for documentaries with impact: structure, pacing and the moments that make people care. Long-form and cut-downs.',
			},
			{
				n: '04',
				h: 'Destination & hospitality films',
				p: 'For tourism boards, lodges and hotels: films that sell a place through the people and landscapes around it, in 16:9 and 9:16.',
			},
		]
	: [
			{
				n: '01',
				h: 'Expeditions- & Bergfilm',
				p: 'Ich begleite eure Expedition, Skidurchquerung oder Klettertour als Kamera: leichtes Kit, autark und fit genug, um auch in der Höhe weiterzudrehen, wenn es darauf ankommt.',
			},
			{
				n: '02',
				h: 'Kameramann',
				p: 'Second Unit oder Solo-Kamera für Creators, Outdoor-Marken und Produktionen. Cinema-Kamera, Drohne und FPV – weltweit vor Ort.',
			},
			{
				n: '03',
				h: 'Dokumentarfilm-Schnitt',
				p: 'Story-first-Schnitt für Dokumentarfilme mit Wirkung: Struktur, Rhythmus und die Momente, die berühren. Langform und Cut-downs.',
			},
			{
				n: '04',
				h: 'Destinations- & Hotelfilme',
				p: 'Für Tourismusverbände, Lodges und Hotels: Imagefilme, die einen Ort über seine Menschen und Landschaften verkaufen – in 16:9 und 9:16.',
			},
		];

const field = en
	? [
			['Highest shoot', 'Kilimanjaro summit, 5,895 m'],
			['Longest shoot', '4 weeks, Bolivian Andes'],
			['Kit', 'Sony A7S III · A7 IV, drone, FPV'],
			['Languages', 'German · English'],
			['Base', 'On the road full-time since 2024'],
			['Biggest doc audience', '1.4M views (Drivers Eye)'],
		]
	: [
			['Höchster Dreh', 'Kilimandscharo-Gipfel, 5.895 m'],
			['Längster Dreh', '4 Wochen, bolivianische Anden'],
			['Kit', 'Sony A7S III · A7 IV, Drohne, FPV'],
			['Sprachen', 'Deutsch · Englisch'],
			['Basis', 'Seit 2024 dauerhaft unterwegs'],
			['Größte Doku-Reichweite', '1,4 Mio. Aufrufe (Drivers Eye)'],
		];

const next = en
	? [
			['Feb 2027', 'Laponia midwinter ski traverse, Swedish Lapland', 'Planned'],
			['Feb 2027', 'Lyngen Alps ski touring, Norway', 'Planned'],
			['Jul 2027', 'Arctic Circle Trail, Greenland', 'Planned'],
		]
	: [
			['Feb. 2027', 'Laponia-Skidurchquerung im Hochwinter, Schwedisch-Lappland', 'Geplant'],
			['Feb. 2027', 'Skitouren in den Lyngen-Alpen, Norwegen', 'Geplant'],
			['Jul. 2027', 'Arctic Circle Trail, Grönland', 'Geplant'],
		];

// <title> ≤ 60, description ≤ 155 characters
const title = en ? 'Expedition & Documentary Filmmaker – Micha Rössler' : 'Micha Rössler – Kameramann & Expeditionsfilmer';
const description = en
	? 'Expedition & documentary filmmaker and camera operator for outdoor brands, expedition teams and tourism boards: mountain film, camera and editing.'
	: 'Kameramann & Expeditionsfilmer buchen – für Outdoor-Marken, Expeditionsteams und Tourismus: Bergfilm, Abenteuer-Dokumentation, Kamera und Schnitt.';
const faqLd = {
	'@type': 'FAQPage',
	'@id': `${new URL(href(lang, 'home'), Astro.site).href}#faq`,
	inLanguage: lang,
	mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
};
// Hero statement: the existing lede, split at its first dash into headline + continuation (text unchanged).
const lede = en
	? 'I film people at the edge of what they can do – on mountains, in snow, on multi-day journeys – and edit it into stories that are honest about what it took.'
	: 'Ich filme Menschen an der Grenze ihrer Möglichkeiten – am Berg, im Schnee, auf mehrtägigen Touren – und schneide daraus Geschichten, die ehrlich zeigen, was es gekostet hat.';
const cut = lede.indexOf(' – ');
const ledeHead = lede.slice(0, cut);
const ledeRest = lede.slice(cut + 1);

// Stats band: numbers taken from the "field" facts above (no new data).
const pick = (v: string, re: RegExp) => v.match(re)?.[1] ?? v;
const stats = [
	{ n: pick(field[5][1], /^([\d.,]+\s?(?:Mio\.|M))/), l: field[5][0] },
	{ n: pick(field[0][1], /([\d.,]+ m)$/), l: field[0][0] },
	{ n: pick(field[1][1], /^(\d+ \S+?),/), l: field[1][0] },
];
// Slate layout: highest, longest, kit (wide), languages, base, biggest audience (wide).
const slate = field.map(([k, v], i) => ({ k, v, wide: i === 2 || i === 5, left: i === 0 || i === 3 }));

const grid = projects.filter((p) => !p.youtube);
const films = projects.filter((p) => p.youtube);
const andes = projects.find((p) => p.slug === 'bolivia-andes')!;
const timeline = timelineOf(lang);
const pad = (n: number) => String(n).padStart(2, '0');

const art = await buildArt(pic('bolivia-ridge-climbers'), [
	{ media: '(max-width: 700px)', ratio: 4 / 5, widths: [480, 720, 960, 1200], sizes: 'calc(100vw - 32px)' },
	{ ratio: 2, widths: [960, 1280, 1440, 1920, 2560], sizes: '100vw' },
]);
const chapters = [
	['#top', en ? 'Start' : 'Start'],
	['#work', t.nav.work],
	['#field', en ? 'In the field' : 'Im Gelände'],
	['#log', en ? 'Logbook' : 'Logbuch'],
	['#contact', t.nav.contact],
];
---

<Base lang={lang} title={title} description={description} alt={{ en: '/', de: '/de/' }} jsonLd={[faqLd]} preload={art.sources.map((s) => ({ srcset: s.avif, sizes: s.sizes, media: s.media ?? '(min-width: 701px)' }))}>
	<div class="rail" aria-hidden="true">
		{
			chapters.map(([h, l], i) => (
				<a href={h} tabindex="-1" class:list={{ on: i === 0 }}>
					<span>
						{pad(i + 1)} {l}
					</span>
				</a>
			))
		}
	</div>
	<div class="tc" aria-hidden="true"><i></i>TC <span data-tc>00:00:00:00</span></div>

	<section class="hero" id="top">
		<div class="wrap">
			<p class="eyebrow k"><span class="hide-m">Micha Rössler</span> <span class="rule hide-m"></span> {t.role}</p>
			<div class="hero-grid">
				<h1>{ledeHead}</h1>
				<div class="hero-side">
					<p>{ledeRest}</p>
					<ul class="meta-row">
						<li><Icon name="pin" />{en ? 'Available worldwide · based on the road' : 'Weltweit verfügbar · zuhause unterwegs'}</li>
						<li><a href="mailto:hello@micharoessler.com"><Icon name="mail" />hello@micharoessler.com</a></li>
					</ul>
				</div>
			</div>
		</div>
		<Reel
			lang={lang}
			art={art}
			alt={en ? 'Two climbers on a snowy ridge in the Bolivian Andes at dusk' : 'Zwei Bergsteiger auf einem verschneiten Grat in den bolivianischen Anden in der Dämmerung'}
			caption={`${andes.title[lang]} · ${andes.year}`}
			link={{ href: href(lang, andes.slug), label: t.viewFilm }}
		/>
	</section>

	<section class="names wrap" aria-labelledby="names-h">
		<h2 id="names-h" class="k">{en ? 'Brands & creators I have worked with' : 'Marken & Creators, mit denen ich gearbeitet habe'}</h2>
		<div class="marquee">
			<div class="track">
				<ul>{brands.map((b) => <li>{b}</li>)}</ul>
				<ul class="dup" aria-hidden="true">{brands.map((b) => <li>{b}</li>)}</ul>
			</div>
		</div>
		<ul class="creators">{creators.map((c) => <li>{c}</li>)}</ul>
	</section>

	<section id="work" class="wrap sec" aria-labelledby="work-h">
		<div class="head">
			<h2 id="work-h" class="h2">{en ? 'Selected work' : 'Ausgewählte Projekte'}<sup>({pad(projects.length)})</sup></h2>
			<a class="lnk" href={href(lang, 'work')}>{t.allWork} →</a>
		</div>
		<WorkGrid lang={lang} items={grid} />
		<FilmStrip lang={lang} items={films} />
	</section>

	<section class="wrap sec" aria-labelledby="svc-h">
		<div class="head"><h2 id="svc-h" class="h2">{en ? 'What I do' : 'Was ich mache'}</h2></div>
		<ol class="svc">
			{
				services.map((s) => (
					<li>
						<span class="k">{s.n}</span>
						<h3>{s.h}</h3>
						<p>{s.p}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="wrap sec" aria-labelledby="talk-h">
		<div class="band">
			<Photo src="bolivia-snowfield" alt="" widths={[640, 960, 1280, 1600, 1920]} sizes="(min-width: 1520px) 1424px, 94vw" class="band-img" />
			<div class="band-in">
				<h2 id="talk-h" class="k band-k">{en ? "Let's talk" : 'Lass uns reden'}</h2>
				<dl class="stats">
					{
						stats.map((s) => (
							<div class="stat">
								<dt>{s.l}</dt>
								<dd>{s.n}</dd>
							</div>
						))
					}
				</dl>
				<a class="btn" href={href(lang, 'contact')}>{t.cta}<Icon name="arrow" /></a>
			</div>
		</div>
	</section>

	<section id="field" class="wrap sec field" aria-labelledby="field-h">
		<div>
			<p class="k">{en ? 'For expedition teams' : 'Für Expeditionsteams'}</p>
			<h2 id="field-h" class="h2 mt">{en ? 'In the field' : 'Im Gelände'}</h2>
			<p class="lead field-p">
				{
					en
						? 'An expedition camera has to carry its own weight. I travel full-time, I am used to long days in cold and thin air, and I plan the shoot around the objective – never the other way round.'
						: 'Eine Expeditionskamera muss ihr eigenes Gewicht tragen. Ich reise dauerhaft, bin lange Tage in Kälte und dünner Luft gewohnt und plane den Dreh um das Ziel herum – nie umgekehrt.'
				}
			</p>
		</div>
		<div class="slate reveal">
			<div class="slate-top" aria-hidden="true"></div>
			<p class="slate-h"><span>{en ? 'Field log' : 'Drehprotokoll'}</span><span>Micha Rössler</span></p>
			<dl>
				{
					slate.map((r) => (
						<div class:list={{ wide: r.wide, l: r.left }}>
							<dt>{r.k}</dt>
							<dd>{r.v}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section id="log" class="wrap sec" aria-labelledby="log-h">
		<div class="head">
			<h2 id="log-h" class="h2">{en ? 'Logbook' : 'Logbuch'}<sup>{timeline[0][0]} → {timeline[timeline.length - 1][0]}</sup></h2>
			<span class="k">{en ? 'Where I have filmed' : 'Wo ich gedreht habe'}</span>
		</div>
		<div class="log">
			<ExpeditionMap lang={lang} />
			<ol class="tl">
				{
					timeline.map(([y, txt], i) => (
						<li class:list={{ pl: i === timeline.length - 1 }}>
							<span>{y}</span>
							<span>{txt}</span>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<Testimonials lang={lang} />

	<section class="wrap sec me" aria-labelledby="me-h">
		<div class="m me-img reveal">
			<Photo src={portrait} alt="Micha Rössler" widths={[480, 800, 1000]} sizes="(min-width: 1000px) 34vw, 92vw" />
		</div>
		<div>
			<p class="k">{en ? 'Who you will work with' : 'Mit wem du arbeitest'}</p>
			<h2 id="me-h" class="h2 mt">{en ? 'Hi, I am Micha.' : 'Hi, ich bin Micha.'}</h2>
			<p class="lead me-p">
				{
					en
						? 'No agency, no account manager. When you write, I answer – and I am the one carrying the camera up the mountain and sitting in the edit afterwards.'
						: 'Keine Agentur, kein Account-Manager. Wenn du schreibst, antworte ich – und ich bin derjenige, der die Kamera auf den Berg trägt und danach im Schnitt sitzt.'
				}
			</p>
			<div class="acts">
				<a class="btn" href={href(lang, 'contact')}>{t.cta}<Icon name="arrow" /></a>
				<a class="lnk" href={href(lang, 'about')}>{en ? 'My story' : 'Meine Geschichte'} →</a>
			</div>
		</div>
	</section>

	<section class="wrap sec" aria-labelledby="next-h">
		<div class="head">
			<h2 id="next-h" class="h2">{en ? 'Next expeditions' : 'Nächste Expeditionen'}</h2>
			<span class="k">{en ? 'Open for partners & sponsors' : 'Offen für Partner & Sponsoren'}</span>
		</div>
		<ul class="next">
			{
				next.map(([d, what, s]) => (
					<li>
						<span class="k">{d}</span>
						<span class="w">{what}</span>
						<span class="s">{s}</span>
					</li>
				))
			}
		</ul>
		<div class="next-cta">
			<a class="btn btn--ghost" href={href(lang, 'contact')}>{en ? 'Partner on a film' : 'Film unterstützen'}<Icon name="arrow" /></a>
		</div>
	</section>

	<section class="wrap sec faq" aria-labelledby="faq-h">
		<div><h2 id="faq-h" class="h2">{en ? 'Frequently asked questions' : 'Häufige Fragen'}</h2></div>
		<div>
			{
				faq.map((f, i) => (
					<details name="faq" open={i === 0}>
						<summary>{f.q[lang]}</summary>
						<p>{f.a[lang]}</p>
					</details>
				))
			}
		</div>
	</section>
</Base>

<script>
	// Chapter rail + scroll timecode (desktop only; rail is hidden below 1100px).
	const rail = [...document.querySelectorAll<HTMLAnchorElement>('.rail a')];
	const tc = document.querySelector<HTMLElement>('[data-tc]');
	if (rail.length && tc && matchMedia('(min-width: 1100px)').matches) {
		const secs = rail.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!));
		const pad = (n: number) => String(n).padStart(2, '0');
		let raf = 0;
		const tick = () => {
			raf = 0;
			const f = Math.round(scrollY / 6); // 1 frame per 6px scrolled, 25 fps
			tc.textContent = `00:${pad(Math.floor(f / 1500) % 60)}:${pad(Math.floor(f / 25) % 60)}:${pad(f % 25)}`;
			let on = 0;
			secs.forEach((s, k) => {
				if (s && s.getBoundingClientRect().top < innerHeight * 0.4) on = k;
			});
			rail.forEach((a, k) => a.classList.toggle('on', k === on));
		};
		addEventListener('scroll', () => (raf ||= requestAnimationFrame(tick)), { passive: true });
		tick();
	}
</script>

<style>
	/* chapter rail + timecode */
	.rail {
		position: fixed;
		right: 22px;
		top: 50%;
		transform: translateY(-50%);
		z-index: 40;
		display: grid;
		gap: 14px;
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.rail a {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 10px;
		color: var(--muted);
	}
	.rail a::after {
		content: '';
		width: 14px;
		height: 1px;
		background: var(--line-2);
		transition: 0.3s;
	}
	.rail a span {
		opacity: 0;
		transform: translateX(6px);
		transition: 0.3s;
	}
	.rail:hover a span,
	.rail a.on span {
		opacity: 1;
		transform: none;
	}
	.rail a.on {
		color: var(--ink);
	}
	.rail a.on::after {
		width: 30px;
		background: var(--ink);
	}
	.tc {
		position: fixed;
		right: 22px;
		bottom: 20px;
		z-index: 40;
		display: flex;
		gap: 10px;
		align-items: center;
		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.tc i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--signal);
		animation: blink 1.6s infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0.25;
		}
	}
	@media (max-width: 1099px) {
		.rail,
		.tc {
			display: none;
		}
	}

	/* hero */
	.hero {
		padding-top: clamp(16px, 3vw, 40px);
	}
	.eyebrow {
		display: flex;
		gap: 14px;
		align-items: center;
		margin-bottom: 28px;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 24px clamp(32px, 6vw, 120px);
		align-items: end;
	}
	h1 {
		text-wrap: wrap;
		font-size: clamp(34px, 4.7vw, 72px);
		line-height: 1.08;
		letter-spacing: -0.03em;
		font-variation-settings: 'wdth' 86;
	}
	.hero-side p {
		font-size: clamp(16px, 1.25vw, 19px);
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 34ch;
	}
	.meta-row {
		display: grid;
		gap: 2px;
		margin-top: 22px;
		font-size: 14px;
		color: var(--ink-2);
	}
	.meta-row li,
	.meta-row a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 32px;
	}
	.meta-row a:hover {
		color: var(--ink);
	}
	.meta-row :global(.icon) {
		color: var(--muted);
	}

	/* logos */
	.names {
		padding: clamp(72px, 9vw, 128px) var(--gut) 0;
		text-align: center;
	}
	.names h2 {
		font-weight: 400;
	}
	.marquee {
		overflow: hidden;
		margin-top: 34px;
		-webkit-mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}
	.track {
		display: flex;
		width: max-content;
		animation: mq 38s linear infinite;
	}
	.marquee:hover .track {
		animation-play-state: paused;
	}
	.track ul {
		display: flex;
		align-items: center;
	}
	.track li {
		display: flex;
		align-items: center;
		font-size: clamp(17px, 1.5vw, 23px);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #e4e0d8;
		white-space: nowrap;
		font-variation-settings: 'wdth' 80;
	}
	.track li::after {
		content: '';
		width: 56px;
		height: 1px;
		margin: 0 34px;
		background: var(--line-2);
	}
	@keyframes mq {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee {
			-webkit-mask: none;
			mask: none;
		}
		.track {
			width: auto;
			justify-content: center;
		}
		.track ul {
			flex-wrap: wrap;
			justify-content: center;
			row-gap: 12px;
		}
		.track .dup {
			display: none;
		}
		.track li:last-child::after {
			display: none;
		}
	}
	.creators {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px 26px;
		margin-top: 22px;
		font-size: 13px;
		color: var(--muted);
	}

	/* services */
	.svc {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border-top: 1px solid var(--line);
	}
	.svc li {
		display: grid;
		gap: 12px;
		align-content: start;
		padding: 26px 26px 0 0;
	}
	.svc li + li {
		padding-left: 26px;
		border-left: 1px solid var(--line);
	}
	.svc h3 {
		font-weight: 500;
		font-size: 19px;
		line-height: 1.3;
	}
	.svc p {
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--muted);
	}

	/* stats band */
	.band {
		position: relative;
		min-height: clamp(520px, 46vw, 680px);
		border-radius: 6px;
		overflow: hidden;
		display: grid;
		place-items: center;
		text-align: center;
	}
	.band :global(picture),
	.band :global(.band-img) {
		position: absolute;
		inset: 0;
	}
	.band :global(.band-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.band::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at center, rgb(8 10 12 / 0.55), rgb(8 10 12 / 0.82));
	}
