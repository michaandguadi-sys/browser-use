---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { type Lang } from '../i18n';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';
const L = en
	? {
			h: 'Planning an expedition or campaign?',
			p: 'Tell me where, when and what you need. I answer within two working days.',
			name: 'Your name',
			org: 'Organisation / brand (optional)',
			type: 'What is it?',
			types: ['Expedition / mountain film', 'Camera operator', 'Documentary edit', 'Destination / hotel film', 'Partnership on a planned expedition', 'Something else'],
			when: 'Dates or time window',
			where: 'Region / location',
			deliver: 'What should come out of it?',
			send: 'Write email',
			note: 'This opens your email app with the details filled in. Nothing is stored on this website.',
			direct: 'Or write directly:',
		}
	: {
			h: 'Expedition oder Kampagne geplant?',
			p: 'Schreib mir wo, wann und was du brauchst. Ich antworte innerhalb von zwei Werktagen.',
			name: 'Dein Name',
			org: 'Organisation / Marke (optional)',
			type: 'Worum geht es?',
			types: ['Expeditions- / Bergfilm', 'Kameramann', 'Doku-Schnitt', 'Destinations- / Hotelfilm', 'Partnerschaft bei geplanter Expedition', 'Etwas anderes'],
			when: 'Termin oder Zeitraum',
			where: 'Region / Ort',
			deliver: 'Was soll am Ende rauskommen?',
			send: 'E-Mail schreiben',
			note: 'Öffnet dein E-Mail-Programm mit den ausgefüllten Angaben. Auf dieser Website wird nichts gespeichert.',
			direct: 'Oder direkt schreiben:',
		};
---

<Base
	lang={lang}
	title={en ? 'Contact – Book an Expedition Filmmaker | Micha Rössler' : 'Kontakt – Outdoor-Filmemacher buchen | Micha Rössler'}
	description={en ? 'Book Micha Rössler as expedition filmmaker, camera operator or documentary editor. Reply within two working days.' : 'Micha Rössler als Expeditionsfilmer, Kameramann oder Doku-Cutter anfragen. Antwort innerhalb von zwei Werktagen.'}
	alt={{ en: '/contact/', de: '/de/kontakt/' }}
	sheet="A/04"
	solidHeader
>
	<div class="sheet sheet--firn c-sheet">
		<div class="wrap g12 c">
			<div class="c-head">
				<p class="meta">{en ? 'Contact' : 'Kontakt'}</p>
				<h1 class="h2">{L.h}</h1>
				<svg class="c-trace" viewBox="0 0 600 12" preserveAspectRatio="none" aria-hidden="true" data-trace>
					<path class="trace" pathLength="1" d="M4 6H596"></path>
					<circle cx="4" cy="6" r="3.5"></circle>
					<path class="c-end" d="M596 0V12"></path>
				</svg>
				<div class="who">
					<Image src={portrait} alt="Micha Rössler" width={160} height={160} widths={[96, 160]} sizes="80px" class="avatar" />
					<p class="prose c-p">{L.p} {en ? 'You are writing to me directly – Micha.' : 'Du schreibst direkt mir – Micha.'}</p>
				</div>
			</div>

			<form class="f" id="brief" data-subject={en ? 'Shoot request' : 'Drehanfrage'}>
				<label><span class="meta">{L.name}</span><input name={L.name} required autocomplete="name" /></label>
				<label><span class="meta">{L.org}</span><input name={L.org} autocomplete="organization" /></label>
				<label class="full">
					<span class="meta">{L.type}</span>
					<select name={L.type}>{L.types.map((x) => <option>{x}</option>)}</select>
				</label>
				<label><span class="meta">{L.when}</span><input name={L.when} /></label>
				<label><span class="meta">{L.where}</span><input name={L.where} /></label>
				<label class="full"><span class="meta">{L.deliver}</span><textarea name={L.deliver} rows="5"></textarea></label>
				<div class="full f-send">
					<button class="btn btn--primary" type="submit">{L.send} →</button>
					<p class="meta f-note">{L.note}</p>
				</div>
			</form>

			<p class="direct">
				<span class="meta">{L.direct}</span>
				<a href="mailto:hello@micharoessler.com">hello@micharoessler.com</a>
			</p>
		</div>
	</div>
</Base>

<script>
	const f = document.getElementById('brief') as HTMLFormElement;
	f?.addEventListener('submit', (e) => {
		e.preventDefault();
		const lines = [...new FormData(f).entries()].filter(([, v]) => String(v).trim()).map(([k, v]) => `${k}: ${v}`);
		location.href = `mailto:hello@micharoessler.com?subject=${encodeURIComponent(f.dataset.subject ?? '')}&body=${encodeURIComponent(lines.join('\n\n'))}`;
	});
</script>

<style>
	.c-sheet {
		padding-top: calc(var(--neat) + 56px + clamp(3rem, 7vw, 6rem));
		padding-bottom: clamp(4rem, 9vw, 7rem);
	}
	@media (min-width: 960px) {
		.c-head {
			grid-column: 1 / 9 !important;
		}
		.f {
			grid-column: 2 / 10 !important;
		}
		.direct {
			grid-column: 2 / 13 !important;
		}
	}
	h1 {
		margin: 0.75rem 0 1.5rem;
		max-width: 16ch;
	}
	.c-trace {
		display: block;
		width: min(100%, 560px);
		height: 12px;
		overflow: visible;
		margin-bottom: 2rem;
	}
	.c-trace .trace {
		stroke-width: 1.5;
	}
	.c-trace circle,
	.c-end {
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.25;
		vector-effect: non-scaling-stroke;
	}
	.who {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.avatar {
		width: 80px;
		height: 80px;
		flex: none;
		border-radius: 50%;
		object-fit: cover;
		object-position: 50% 18%;
		background: var(--basalt);
	}
	.c-p {
		max-width: 46ch;
	}
	.f {
		margin-top: 3.5rem;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem var(--colgap);
		border-top: 1px solid var(--ink);
		padding-top: 2rem;
	}
	.full {
		grid-column: 1 / -1;
	}
	@media (min-width: 700px) {
		.f {
			grid-template-columns: 1fr 1fr;
		}
	}
	label {
		display: grid;
		gap: 0.35rem;
	}
	input,
	select,
	textarea {
		font: inherit;
		font-size: 18px;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		padding: 0.55rem 0;
		width: 100%;
	}
	textarea {
		border: 1px solid var(--ink);
		padding: 0.75rem;
		resize: vertical;
	}
	select {
		appearance: none;
		background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
		background-position:
			calc(100% - 12px) 55%,
			calc(100% - 7px) 55%;
		background-size: 5px 5px;
		background-repeat: no-repeat;
		padding-right: 2rem;
	}
	input:focus,
	select:focus,
	textarea:focus {
		outline: none;
		border-color: var(--ochre);
		box-shadow: 0 1px 0 var(--ochre);
	}
	.f-send {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
	}
	.f-note {
		text-transform: none;
		letter-spacing: 0.02em;
		max-width: 40em;
	}
	.direct {
		margin-top: 3.5rem;
		display: grid;
		gap: 0.5rem;
	}
	.direct a {
		font-size: clamp(30px, 4.6vw, 64px);
		font-weight: 250;
		font-variation-settings: 'opsz' 60;
		letter-spacing: -0.03em;
		line-height: 1;
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.direct a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--ochre);
	}
</style>
