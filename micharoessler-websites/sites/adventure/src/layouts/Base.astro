---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { href, other, ui, type Lang } from '../i18n';
import { pic } from '../data/projects';
import portrait from '../assets/micha-portrait.jpg';
import monoFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import sansFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import Icon from '../components/Icon.astro';

interface Props {
	lang: Lang;
	title: string;
	description: string;
	alt: Record<Lang, string>; // same page in both languages, for hreflang + switcher
	ogImage?: string;
	jsonLd?: Record<string, unknown>[];
	hero?: { src: ImageMetadata; widths: number[]; sizes: string }; // LCP image to preload (AVIF)
	terrainCredit?: boolean; // page shows real-terrain contours
}

const { lang, title, description, alt, ogImage = 'bolivia-ridge-climbers', jsonLd = [], hero, terrainCredit = false } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
const site = Astro.site!;
const canonical = new URL(alt[lang], site).href;
const og = await getImage({ src: pic(ogImage), width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, site).href;
const face = await getImage({ src: portrait, width: 800, format: 'jpg' });
const heroPre = hero ? await getImage({ src: hero.src, widths: hero.widths, format: 'avif', quality: 78 }) : null;

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': 'https://micharoessler.com/#person',
	name: 'Micha Rössler',
	alternateName: 'Micha Roessler',
	jobTitle: en ? 'Expedition & adventure filmmaker' : 'Expeditions- & Outdoor-Filmemacher',
	url: 'https://micharoessler.com/',
	email: 'mailto:hello@micharoessler.com',
	knowsLanguage: ['de', 'en'],
	image: new URL(face.src, site).href,
	worksFor: { '@type': 'Organization', name: 'Micha Roessler LLC' },
	sameAs: ['https://www.instagram.com/michaaroessler/', 'https://www.youtube.com/@GuadiandMicha', 'https://formatschnitt.de/'],
};
const path = Astro.url.pathname;
const current = (p: string) => (path.startsWith(href(lang, p)) ? 'page' : undefined);
---

<!doctype html>
<html lang={lang === 'de' ? 'de-DE' : 'en'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
		<link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
		{heroPre && <link rel="preload" as="image" type="image/avif" imagesrcset={heroPre.srcSet.attribute} imagesizes={hero!.sizes} fetchpriority="high" />}
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={new URL(alt.en, site).href} />
		<link rel="alternate" hreflang="de-DE" href={new URL(alt.de, site).href} />
		<link rel="alternate" hreflang="x-default" href={new URL(alt.en, site).href} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#0f0f0f" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Micha Rössler" />
		<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="speculationrules" is:inline>
			{ "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }
		</script>
		<script type="application/ld+json" set:html={JSON.stringify([person, ...jsonLd])} />
	</head>
	<body>
		<a class="skip" href="#main">{t.skip}</a>

		<header class="site-header">
			<div class="wrap bar">
				<a class="brand" href={href(lang, 'home')}>Micha Rössler</a>
				<nav aria-label={en ? 'Main' : 'Hauptnavigation'}>
					<ul>
						<li><a href={href(lang, 'work')} aria-current={current('work')}>{t.nav.work}</a></li>
						<li><a href={href(lang, 'about')} aria-current={current('about')}>{t.nav.about}</a></li>
						<li>
							<a class="lang" href={alt[other(lang)]} hreflang={other(lang)} lang={other(lang)}>
								{other(lang).toUpperCase()}<span class="sr-only"> – {t.switch}</span>
							</a>
						</li>
						<li class="nav-rule" aria-hidden="true"></li>
						<li><a class="nav-cta" href={href(lang, 'contact')} aria-current={current('contact')}>{t.nav.contact}</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<ul class="socials">
					<li>
						<a href="https://www.instagram.com/michaaroessler/" rel="me noopener"><Icon name="instagram" />Instagram</a>
					</li>
					<li aria-hidden="true" class="rule"></li>
					<li>
						<a href="https://www.youtube.com/@GuadiandMicha" rel="me noopener"><Icon name="youtube" />YouTube · Guadi &amp; Micha</a>
					</li>
					<li aria-hidden="true" class="rule"></li>
					<li>
						<a href="https://formatschnitt.de/" rel="me">{en ? 'Format editing & workflow → formatschnitt.de' : 'Format-Schnitt & Workflow → formatschnitt.de'}</a>
					</li>
				</ul>
			</div>
			<div class="foot">
				<div class="wrap foot-bar">
					<div class="foot-id">
						<a class="brand" href={href(lang, 'home')}>Micha Rössler</a>
						<span class="rule" aria-hidden="true"></span>
						<a class="foot-mail" href="mailto:hello@micharoessler.com"><Icon name="mail" />hello@micharoessler.com</a>
					</div>
					<ul class="foot-nav">
						<li><a href={href(lang, 'work')}>{t.nav.work}</a></li>
						<li><a href={href(lang, 'about')}>{t.nav.about}</a></li>
						<li><a href={href(lang, 'contact')}>{t.nav.contact}</a></li>
					</ul>
				</div>
				<div class="wrap foot-legal">
					<p class="meta">{en ? 'Available worldwide · based on the road' : 'Weltweit verfügbar · zuhause unterwegs'}</p>
					<p class="meta">© {new Date().getFullYear()} Micha Roessler LLC</p>
					<p class="meta foot-links">
						<a href={href(lang, 'imprint')}>{t.imprint}</a>
						<a href={href(lang, 'privacy')}>{t.privacy}</a>
					</p>
					{
						terrainCredit && (
							<p class="meta foot-terrain">
								{en
									? 'Terrain: AWS Terrain Tiles (Mapzen) · SRTM and GMTED2010 terrain data courtesy of the U.S. Geological Survey'
									: 'Gelände: AWS Terrain Tiles (Mapzen) · SRTM- und GMTED2010-Geländedaten mit freundlicher Genehmigung des U.S. Geological Survey'}
							</p>
						)
					}
				</div>
			</div>
		</footer>

		<script>
			const io = new IntersectionObserver(
				(es) =>
					es.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add('in');
							io.unobserve(e.target);
						}
					}),
				{ rootMargin: '0px 0px -6% 0px' },
			);
			document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		</script>

		<style>
			.site-header {
				position: relative;
				z-index: 20;
			}
			.bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				height: clamp(76px, 8vw, 120px);
			}
			.brand {
				font-family: var(--mono);
				font-size: 16px;
				font-weight: 500;
				letter-spacing: -0.01em;
				text-decoration: none;
				white-space: nowrap;
			}
			nav ul {
				display: flex;
				align-items: center;
				gap: clamp(14px, 2.4vw, 32px);
				margin: 0;
				padding: 0;
				list-style: none;
			}
			nav a {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				font-family: var(--mono);
				font-size: 13px;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				text-decoration: none;
			}
			nav a:hover,
			nav a[aria-current='page'] {
				text-decoration: underline;
				text-underline-offset: 0.45em;
			}
			.lang {
				color: var(--muted);
			}
			.nav-rule {
				width: 48px;
				height: 1px;
				background: var(--line-2);
			}
			.nav-cta {
				min-height: 40px !important;
				padding: 0 18px;
				border-radius: 6px;
				background: var(--ink);
				color: var(--bg);
				transition:
					background 0.3s var(--ease),
					color 0.3s var(--ease);
			}
			.nav-cta:hover,
			.nav-cta[aria-current='page'] {
				text-decoration: none !important;
				background: transparent;
				color: var(--ink);
				box-shadow: inset 0 0 0 1px var(--ink);
			}
			@media (max-width: 640px) {
				.brand {
					font-size: 14px;
				}
				nav ul {
					gap: 12px;
				}
				nav a {
					font-size: 11px;
					letter-spacing: 0.02em;
				}
				.nav-rule {
					display: none;
				}
				.nav-cta {
					padding: 0;
					background: none;
					color: var(--ink);
				}
				.nav-cta:hover,
				.nav-cta[aria-current='page'] {
					box-shadow: none;
					text-decoration: underline !important;
				}
			}

			.site-footer {
				margin-top: var(--section);
			}
			.socials {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.5rem 2rem;
				margin: 0;
				padding: 0 0 var(--section);
				list-style: none;
				font-family: var(--mono);
				font-size: 14px;
			}
			.socials a {
				display: inline-flex;
				align-items: center;
				gap: 0.7em;
				min-height: 44px;
				text-decoration: none;
			}
			.socials a:hover {
				text-decoration: underline;
			}
			.rule {
				display: block;
				width: 48px;
				height: 1px;
				background: var(--line-2);
			}
			.foot {
				background: var(--bg-2);
				padding-block: clamp(48px, 6vw, 80px) 40px;
			}
			.foot-bar {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem 2rem;
			}
			.foot-id {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem 2rem;
			}
			.foot-mail {
				display: inline-flex;
				align-items: center;
				gap: 0.7em;
				min-height: 44px;
				font-family: var(--mono);
				font-size: 14px;
				text-decoration: none;
			}
			.foot-mail:hover {
				text-decoration: underline;
			}
			.foot-nav {
				display: flex;
				gap: 2rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.foot-nav a,
			.foot-links a {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				font-family: var(--mono);
				font-size: 13px;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				text-decoration: none;
				color: var(--ink);
			}
			.foot-nav a:hover,
			.foot-links a:hover {
				text-decoration: underline;
			}
			.foot-legal {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem 2rem;
				margin-top: clamp(32px, 4vw, 56px);
				padding-top: 1.25rem;
				border-top: 1px solid var(--line);
				font-size: 13px;
			}
			.foot-links {
				display: flex;
				gap: 1.75rem;
			}
			.foot-terrain {
				flex-basis: 100%;
				font-size: 12px;
			}
			@media (max-width: 640px) {
				.socials {
					flex-direction: column;
					gap: 0.25rem;
					text-align: center;
				}
				.socials .rule {
					width: 1px;
					height: 20px;
				}
				.foot-id .rule {
					display: none;
				}
			}
		</style>
	</body>
</html>
