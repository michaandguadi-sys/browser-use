---
// Click-to-load YouTube facade: the poster is a local image; nothing is requested from Google
// until the visitor presses play (GDPR + speed).
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
	id: string;
	title: string;
	lang: 'en' | 'de';
	poster: ImageMetadata;
	alt?: string;
	eager?: boolean;
	widths?: number[];
	sizes?: string;
	position?: string; // crop anchor when the poster is not 16:9
}
const { id, title, lang, poster, alt = '', eager = false, widths = [640, 960, 1280, 1920, 2560], sizes = '(min-width: 1520px) 1424px, 94vw', position } = Astro.props;
const de = lang === 'de';
const label = de ? `Video abspielen: ${title}` : `Play video: ${title}`;
const note = de ? 'Beim Abspielen wird YouTube (Google) geladen.' : 'Playing loads YouTube (Google).';
---

<div class="yt" data-yt={id} data-title={title}>
	<button type="button" class="yt-btn" aria-label={label}>
		<Photo src={poster} alt={alt} widths={widths} sizes={sizes} eager={eager} crop={{ ratio: 16 / 9, position }} />
		<span class="plb" aria-hidden="true">
			<svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5Z"></path></svg>
		</span>
	</button>
	<p class="yt-note">{note}</p>
</div>

<script>
	for (const el of document.querySelectorAll<HTMLElement>('.yt')) {
		el.querySelector('button')?.addEventListener(
			'click',
			() => {
				const f = document.createElement('iframe');
				f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
				f.title = el.dataset.title ?? '';
				f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
				f.allowFullscreen = true;
				el.replaceChildren(f);
			},
			{ once: true },
		);
	}
</script>

<style>
	.yt {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 3px;
		background: #151515;
	}
	.yt :global(iframe),
	.yt-btn,
	.yt-btn :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.yt-btn {
		padding: 0;
		cursor: pointer;
		background: none;
	}
	.yt-btn :global(picture) {
		display: contents;
	}
	.yt-btn :global(img) {
		object-fit: cover;
		filter: saturate(0.85) contrast(1.05);
		transition:
			transform 1s var(--ease),
			filter 0.6s;
	}
	.yt-btn:hover :global(img) {
		transform: scale(1.04);
		filter: none;
	}
	.plb {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 64px;
		height: 64px;
		margin: -32px 0 0 -32px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: rgb(255 255 255 / 0.14);
		backdrop-filter: blur(8px);
		border: 1px solid rgb(255 255 255 / 0.35);
		transition: transform 0.4s var(--ease);
	}
	.yt-btn:hover .plb {
		transform: scale(1.08);
	}
	.plb svg {
		width: 22px;
		fill: #fff;
	}
	.yt-note {
		position: absolute;
		right: 10px;
		bottom: 8px;
		margin: 0;
		font-size: 11px;
		letter-spacing: 0.04em;
		color: rgb(242 239 233 / 0.85);
		pointer-events: none;
	}
</style>
