---
// Dotted world map rendered at build time (no map library shipped to the browser).
// Pins are plain HTML links on top of the SVG, so they stay accessible and crawlable.
import { href, type Lang } from '../i18n';
import { projection, W, H } from '../lib/map';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';

type Pin = { name: { en: string; de: string }; lonlat: [number, number]; when: string; slug?: string; planned?: boolean; short?: { en: string; de: string }; left?: boolean; nolink?: boolean };
const pins: Pin[] = [
	{ name: { en: 'Andes Expedition, Bolivia', de: 'Anden-Expedition, Bolivien' }, lonlat: [-68.88, -18.1], when: '2024', slug: 'bolivia-andes', short: { en: 'Bolivia · 2024', de: 'Bolivien · 2024' } },
	{ name: { en: 'Kilimanjaro, 5,895 m', de: 'Kilimandscharo, 5.895 m' }, lonlat: [37.35, -3.07], when: '2023', slug: 'kilimanjaro', short: { en: 'Kilimanjaro · 5,895 m', de: 'Kilimandscharo · 5.895 m' } },
	{ name: { en: '24 Hours in the Sahara', de: '24 Stunden in der Sahara' }, lonlat: [-4.0, 31.1], when: '2023', slug: 'moroccan-sahara', short: { en: 'Sahara · 2023', de: 'Sahara · 2023' }, left: true },
	{ name: { en: 'Drivers Eye – Nürburgring', de: 'Drivers Eye – Nürburgring' }, lonlat: [6.95, 50.33], when: '2021', slug: 'drivers-eye-24h-nurburgring', short: { en: 'Nürburgring · 2021', de: 'Nürburgring · 2021' } },
	{ name: { en: 'Hotrodtour – Cologne to Ibiza', de: 'Hotrodtour – Köln bis Ibiza' }, lonlat: [1.43, 38.98], when: '', slug: 'hotrodtour-cologne-ibiza', nolink: true },
	{ name: { en: 'Großvenediger glacier tour, 3,660 m', de: 'Großvenediger-Gletschertour, 3.660 m' }, lonlat: [12.35, 47.1], when: '2023' },
	{ name: { en: 'Trolltunga winter hike', de: 'Trolltunga im Winter' }, lonlat: [6.74, 60.12], when: '2023' },
	{ name: { en: 'Laponia ski traverse + Lyngen Alps', de: 'Laponia-Skidurchquerung + Lyngen-Alpen' }, lonlat: [20.2, 68.2], when: 'Feb 2027', planned: true, short: { en: 'Laponia + Lyngen · Feb 2027', de: 'Laponia + Lyngen · Feb. 2027' } },
	{ name: { en: 'Arctic Circle Trail, Greenland', de: 'Arctic Circle Trail, Grönland' }, lonlat: [-51.0, 66.9], when: 'Jul 2027', planned: true, short: { en: 'Arctic Circle Trail · Jul 2027', de: 'Arctic Circle Trail · Jul. 2027' }, left: true },
];
const placed = pins.map((p) => {
	const [x, y] = projection(p.lonlat)!;
	return { ...p, x: (x / W) * 100, y: (y / H) * 100 };
});
const [cx, cy] = projection([6.96, 50.94])!;
const [ix, iy] = projection([1.43, 38.98])!;
---

<div class="map" data-map>
	<img class="map-img" src="/world-dots.svg" alt="" width={W} height={H} loading="lazy" decoding="async" />
	<svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" class="map-svg">
		<path d={`M${cx} ${cy} Q ${(cx + ix) / 2 - 40} ${(cy + iy) / 2} ${ix} ${iy}`} class="route"></path>
	</svg>
	<ul class="pins">
		{
			placed.map((p) => (
				<li class:list={['pin', { planned: p.planned, minor: !p.slug && !p.planned, left: p.left }]} style={`--x:${p.x}%;--y:${p.y}%`}>
					{p.slug && !p.nolink ? (
						<a href={href(lang, p.slug)} class="dot" aria-describedby={`pin-${p.lonlat.join('')}`}>
							<span class="sr-only">{p.name[lang]}</span>
						</a>
					) : (
						<span class="dot" role="img" aria-label={p.name[lang]} />
					)}
					{p.short && (
						<span class="lbl" aria-hidden="true">
							{p.short[lang]}
						</span>
					)}
					<span class="tip" role="tooltip" id={`pin-${p.lonlat.join('')}`}>
						<span class="meta">{p.planned ? (en ? 'Planned' : 'Geplant') : en ? 'Filmed' : 'Gedreht'}{p.when && ` · ${p.when}`}</span>
						<span class="tip-name">{p.name[lang]}</span>
						{p.slug && !p.nolink && <span class="meta tip-go">{en ? 'Open project →' : 'Projekt öffnen →'}</span>}
					</span>
				</li>
			))
		}
	</ul>
	<p class="legend meta">
		<span><i class="lg-dot"></i>{en ? 'Filmed' : 'Gedreht'}</span>
		<span><i class="lg-dot lg-minor"></i>{en ? 'Field experience' : 'Bergerfahrung'}</span>
		<span><i class="lg-dot lg-planned"></i>{en ? 'Planned 2027' : 'Geplant 2027'}</span>
	</p>
</div>

<style>
	.map {
		position: relative;
	}
	.map-img {
		width: 100%;
		height: auto;
		display: block;
	}
	.map-svg {
		position: absolute;
		inset: 0 0 auto 0;
		width: 100%;
		height: auto;
	}
	.route {
		fill: none;
		stroke: var(--muted);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.pins {
		position: absolute;
		inset: 0 0 auto 0;
		aspect-ratio: 1000 / 470;
	}
	.pin {
		position: absolute;
		left: var(--x);
		top: var(--y);
	}
	.dot {
		position: absolute;
		left: 0;
		top: 0;
		translate: -50% -50%;
		width: 26px;
		height: 26px;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		display: grid;
		place-items: center;
	}
	.dot::before {
		content: '';
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--ink);
		box-shadow: 0 0 0 5px rgb(242 239 233 / 0.12);
		transition: scale 0.3s var(--ease);
	}
	.minor .dot::before {
		width: 6px;
		height: 6px;
		background: var(--muted);
		box-shadow: none;
	}
	.planned .dot::before {
		background: transparent;
		border: 1.5px solid var(--signal);
		box-shadow: 0 0 0 6px rgb(255 91 46 / 0.12);
	}
	.dot:hover::before,
	.dot:focus-visible::before {
		scale: 1.3;
	}
	.lbl {
		position: absolute;
		left: 16px;
		top: 0;
		translate: 0 -50%;
		padding: 3px 7px;
		border-radius: 3px;
		background: rgb(15 15 15 / 0.8);
		font-size: 11px;
		letter-spacing: 0.08em;
		color: var(--ink-2);
		white-space: nowrap;
		pointer-events: none;
	}
	.planned .lbl {
		color: var(--signal);
	}
	.left .lbl {
		left: auto;
		right: 16px;
	}
	.tip {
		position: absolute;
		left: 0;
		bottom: 22px;
		translate: -50% 0;
		display: grid;
		gap: 0.25rem;
		min-width: 220px;
		padding: 0.75rem 0.9rem;
		background: var(--bg-3);
		border: 1px solid var(--line-2);
		border-radius: 4px;
		color: var(--ink);
		pointer-events: none;
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.25s var(--ease),
			transform 0.25s var(--ease);
		z-index: 5;
	}
	.tip .meta {
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.tip-name {
		font-size: 16px;
		line-height: 1.3;
	}
	.tip-go {
		color: var(--ink) !important;
	}
	.pin:hover .tip,
	.pin:focus-within .tip {
		opacity: 1;
		transform: none;
	}
	.pin:hover,
	.pin:focus-within {
		z-index: 6;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 22px;
		margin-top: 20px;
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.lg-dot {
		display: inline-block;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--ink);
		margin-right: 8px;
	}
	.lg-minor {
		width: 6px;
		height: 6px;
		background: var(--muted);
	}
	.lg-planned {
		background: transparent;
		border: 1.5px solid var(--signal);
	}
	@media (max-width: 700px) {
		.lbl {
			display: none;
		}
		.tip {
			min-width: 160px;
		}
		.dot::before {
			width: 8px;
			height: 8px;
		}
	}
</style>
