---
// Telemetry block ("Log" / "Protokoll"): existing facts as a mono table.
// Numbers already in the strings count up once on reveal (linear); the HTML always holds the final text.
import type { Lang } from '../i18n';

interface Props {
	lang: Lang;
	title: string;
	rows: [string, string][];
	id?: string;
}
const { lang, title, rows, id } = Astro.props;

// Split a value into text + countable numbers. Years (19xx/20xx) stay static.
const NUM = /(^|[\s(])(\d[\d.,]*\d|\d)(?=$|[\s)%+M]|[,.]\s)/g;
const split = (v: string) => {
	const out: { t: string; n?: boolean }[] = [];
	let last = 0;
	for (const m of v.matchAll(NUM)) {
		const start = m.index! + m[1].length;
		const tok = m[2];
		if (/^(19|20)\d\d$/.test(tok)) continue;
		out.push({ t: v.slice(last, start) }, { t: tok, n: true });
		last = start + tok.length;
	}
	out.push({ t: v.slice(last) });
	return out.filter((p) => p.t);
};
---

<section class="log" aria-labelledby={id} data-lang={lang}>
	<p class="meta log-h" id={id}>{title}</p>
	<dl>
		{
			rows.map(([k, v], i) => (
				<div>
					<dt class="meta">
						<span class="log-n">{String(i + 1).padStart(2, '0')}</span>
						{k}
					</dt>
					<dd>
						{split(v).map((p) =>
							p.n ? (
								<span class="count" data-to={p.t} style={`min-width:${p.t.length}ch`}>{p.t}</span>
							) : (
								p.t
							),
						)}
					</dd>
				</div>
			))
		}
	</dl>
</section>

<script>
	const parse = (s: string, de: boolean) => {
		const dec = de ? ',' : '.';
		const grp = de ? '.' : ',';
		const hasGrp = s.includes(grp) && /\d{3}$/.test(s);
		const clean = s.split(grp).join('').replace(dec, '.');
		const decimals = clean.includes('.') ? clean.split('.')[1].length : 0;
		return { v: parseFloat(clean), decimals, hasGrp };
	};
	const run = (log: HTMLElement) => {
		const de = log.dataset.lang === 'de';
		const nf = (d: number, g: boolean) =>
			new Intl.NumberFormat(de ? 'de-DE' : 'en-US', { minimumFractionDigits: d, maximumFractionDigits: d, useGrouping: g });
		const items = [...log.querySelectorAll<HTMLElement>('.count')].map((el) => ({ el, to: el.dataset.to!, ...parse(el.dataset.to!, de) }));
		const T = 1400;
		let t0 = 0;
		const step = (now: number) => {
			if (!t0) t0 = now;
			const k = Math.min(1, (now - t0) / T); // linear: measured values
			for (const it of items) {
				const f = nf(it.decimals, it.hasGrp);
				it.el.textContent = k < 1 ? f.format(it.v * k) : it.to;
			}
			if (k < 1) requestAnimationFrame(step);
		};
		requestAnimationFrame(step);
	};
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const io = new IntersectionObserver(
			(es) =>
				es.forEach((e) => {
					if (!e.isIntersecting) return;
					io.unobserve(e.target);
					run(e.target as HTMLElement);
				}),
			{ rootMargin: '0px 0px -15% 0px' },
		);
		document.querySelectorAll<HTMLElement>('.log').forEach((l) => io.observe(l));
	}
</script>

<style>
	.log {
		border-top: 1px solid var(--ink);
	}
	.log-h {
		display: flex;
		justify-content: space-between;
		padding: 0.6rem 0;
		color: var(--ink);
		border-bottom: 1px solid var(--rule);
	}
	dl {
		margin: 0;
	}
	dl > div {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
		gap: 0.25rem 1.25rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--rule);
		align-items: baseline;
	}
	dt {
		display: flex;
		gap: 0.9em;
	}
	.log-n {
		color: var(--num);
	}
	dd {
		margin: 0;
		font-family: var(--mono);
		font-size: 14px;
		line-height: 1.45;
		font-variant-numeric: tabular-nums;
	}
	.count {
		display: inline-block;
		text-align: right;
	}
	@media (max-width: 520px) {
		dl > div {
			grid-template-columns: 1fr;
		}
	}
</style>
