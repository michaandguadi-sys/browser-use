---
// Two-column staggered work grid: image + hairline meta rows (title / client or type / year).
import Photo from './Photo.astro';
import { href, type Lang } from '../i18n';
import type { Project } from '../data/projects';

interface Props {
	lang: Lang;
	items: Project[];
	headingLevel?: 'h2' | 'h3';
	eagerFirst?: boolean; // first row is above the fold (Work index)
}
const { lang, items, headingLevel = 'h3', eagerFirst = false } = Astro.props;
const H = headingLevel;
---

<ul class="work-grid">
	{
		items.map((p, i) => (
			<li>
				<a href={href(lang, p.slug)}>
					<div class:list={['media card-img', { reveal: !(eagerFirst && i < 2) }]} style={`view-transition-name: p-${p.slug}`}>
						<Photo eager={eagerFirst && i < 2} src={p.cover} alt={p.title[lang]} widths={[480, 640, 800, 1200, 1600]} sizes="(min-width: 1440px) 620px, (min-width: 760px) 44vw, 92vw" />
					</div>
					<ul class="rows card-rows">
						<li>
							<H class="card-title">{p.title[lang]}</H>
						</li>
						<li class="meta">{p.client ?? p.kicker[lang]}</li>
						<li class="meta">{p.year || p.location[lang]}</li>
					</ul>
				</a>
			</li>
		))
	}
</ul>

<style>
	.work-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(48px, 6vw, 72px) clamp(24px, 4.5vw, 64px);
	}
	@media (min-width: 760px) {
		.work-grid {
			grid-template-columns: 1fr 1fr;
		}
		.work-grid > li:nth-child(even) {
			margin-top: clamp(48px, 7vw, 112px);
		}
	}
	a {
		display: block;
		text-decoration: none;
	}
	.card-img {
		aspect-ratio: 16 / 10;
	}
	.card-img :global(img) {
		transition: scale 0.6s var(--ease);
	}
	a:hover .card-img :global(img) {
		scale: 1.03;
	}
	.card-rows {
		margin-top: 18px;
	}
	.card-rows > li:first-child {
		padding-top: 0;
	}
	.card-title {
		font-size: var(--t-title);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}
</style>
