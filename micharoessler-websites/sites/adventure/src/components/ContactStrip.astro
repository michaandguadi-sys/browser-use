---
// Contact-strip stills: one roll of film frames, natively scroll-snapped, with one grease-pencil selection.
import { Image } from 'astro:assets';
import { pic } from '../data/projects';
import type { Lang } from '../i18n';

interface Props {
	lang: Lang;
	frames: { src: string; alt: string }[];
	pick: number; // index of the frame marked with the grease pencil
	href: string; // where the marked frame leads
	label: string; // accessible name of the strip
	caption: string;
}
const { lang, frames, pick, href, label, caption } = Astro.props;
const en = lang === 'en';
const total = String(frames.length).padStart(2, '0');
---

<figure class="strip" data-strip>
	<div class="strip-film">
		<ol class="strip-row" aria-label={label} tabindex="0">
			{
				frames.map((f, i) => (
					<li class:list={['fr', { pick: i === pick }]}>
						<span class="fr-n meta" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
							{i === pick ? ' ▸' : ''}
						</span>
						{i === pick ? (
							<a href={href} class="fr-img grain">
								<Image src={pic(f.src)} alt={f.alt} widths={[360, 540, 720]} sizes="(min-width: 900px) 26vw, 72vw" />
								<svg class="grease" viewBox="0 0 200 140" preserveAspectRatio="none" aria-hidden="true">
									<path d="M40 30C78 8 150 10 184 44c22 24 6 66-40 82-46 16-110 8-130-24C-2 76 16 42 52 24c22-10 52-14 74-10" />
								</svg>
							</a>
						) : (
							<span class="fr-img grain">
								<Image src={pic(f.src)} alt={f.alt} widths={[360, 540, 720]} sizes="(min-width: 900px) 26vw, 72vw" />
							</span>
						)}
					</li>
				))
			}
		</ol>
	</div>
	<div class="strip-ctl">
		<figcaption class="caption">{caption}</figcaption>
		<div class="strip-nav">
			<button type="button" class="btn strip-btn" data-dir="-1" aria-label={en ? 'Previous frame' : 'Vorheriges Bild'}>←</button>
			<span class="meta strip-count" aria-live="polite"><span data-cur>01</span> / {total}</span>
			<button type="button" class="btn strip-btn" data-dir="1" aria-label={en ? 'Next frame' : 'Nächstes Bild'}>→</button>
		</div>
	</div>
</figure>

<script>
	for (const strip of document.querySelectorAll<HTMLElement>('[data-strip]')) {
		const row = strip.querySelector<HTMLElement>('.strip-row')!;
		const frames = [...row.querySelectorAll<HTMLElement>('.fr')];
		const cur = strip.querySelector<HTMLElement>('[data-cur]')!;
		const [prev, next] = strip.querySelectorAll<HTMLButtonElement>('.strip-btn');
		const step = () => (frames[1] ? frames[1].offsetLeft - frames[0].offsetLeft : 1);
		const max = () => row.scrollWidth - row.clientWidth;
		// At the end of the roll the last frame counts as current, even if it never reaches the left edge.
		const at = () => (row.scrollLeft >= max() - 4 ? frames.length - 1 : Math.round(row.scrollLeft / step()));
		const update = () => {
			const i = at();
			cur.textContent = String(i + 1).padStart(2, '0');
			prev.disabled = i === 0;
			next.disabled = i === frames.length - 1;
		};
		row.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
		for (const b of [prev, next])
			b.addEventListener('click', () => {
				const i = Math.max(0, Math.min(frames.length - 1, at() + Number(b.dataset.dir)));
				const left = i === frames.length - 1 ? max() : Math.min(i * step(), max());
				row.scrollTo({ left, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
			});
		update();
	}
</script>

<style>
	.strip {
		margin: 0;
	}
	.strip-film {
		position: relative;
		background: #0a0b0c;
		padding-block: 8px;
		border-block: 1px solid var(--rule-basalt);
	}
	/* Sprocket holes. */
	.strip-film::before,
	.strip-film::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 7px;
		background: repeating-linear-gradient(90deg, rgb(232 230 223 / 0.2) 0 9px, transparent 9px 22px);
	}
	.strip-film::before {
		top: 7px;
	}
	.strip-film::after {
		bottom: 7px;
	}
	.strip-row {
		list-style: none;
		margin: 0;
		padding: 22px var(--gutter) 24px;
		display: flex;
		gap: 12px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
		scroll-padding-inline: var(--gutter);
		scrollbar-width: none;
	}
	.strip-row::-webkit-scrollbar {
		display: none;
	}
	.fr {
		flex: none;
		width: clamp(220px, 26vw, 380px);
		scroll-snap-align: start;
		display: grid;
		gap: 6px;
	}
	.fr-n {
		color: var(--ochre);
		font-size: 10px;
	}
	.fr-img {
		display: block;
		aspect-ratio: 3 / 2;
	}
	.fr-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.9);
	}
	.pick .fr-img {
		overflow: visible;
	}
	.pick .fr-img::after {
		z-index: 1;
	}
	.grease {
		position: absolute;
		inset: -9% -7%;
		width: 114%;
		height: 118%;
		pointer-events: none;
		z-index: 2;
	}
	.grease path {
		fill: none;
		stroke: var(--ochre);
		stroke-width: 3.2;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
		opacity: 0.95;
	}
	.strip-ctl {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem 2rem;
		padding: 0.9rem var(--gutter) 0;
	}
	.strip-nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.strip-btn {
		min-width: 44px;
		justify-content: center;
		padding: 0.5em 0.8em;
		font-size: 14px;
	}
	.strip-btn:disabled {
		opacity: 0.35;
		cursor: default;
		background: transparent;
		color: inherit;
	}
	.strip-count {
		min-width: 6ch;
		text-align: center;
	}
</style>
