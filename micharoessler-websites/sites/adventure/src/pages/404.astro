---
import Base from '../layouts/Base.astro';
---

<Base lang="en" title="Page not found | Micha Rössler" description="This page does not exist." alt={{ en: '/', de: '/de/' }}>
	<div class="wrap nf">
		<p class="label">404 · Off route</p>
		<h1>This trail ends here.</h1>
		<p class="prose">The page you were looking for does not exist (anymore). <span lang="de">Diese Seite gibt es nicht (mehr).</span></p>
		<p class="nf-links">
			<a class="btn" href="/">Home</a>
			<a class="btn btn--ghost" href="/work/">Work</a>
			<a class="btn btn--ghost" href="/de/">Deutsch</a>
		</p>
	</div>
</Base>

<style>
	.nf {
		padding-top: clamp(48px, 8vw, 120px);
		min-height: 50vh;
	}
	h1 {
		margin: 14px 0 24px;
		font-size: clamp(30px, 2.4vw + 14px, 52px);
		letter-spacing: -0.025em;
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}
</style>
