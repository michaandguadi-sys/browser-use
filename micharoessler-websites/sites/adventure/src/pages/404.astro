---
import Base from '../layouts/Base.astro';
import Terrain from '../components/Terrain.astro';
---

<Base lang="en" title="Page not found | Micha Rössler" description="This page does not exist." alt={{ en: '/', de: '/de/' }} terrainCredit cta={false}>
	<div class="wrap nf">
		<div>
			<p class="k">404 · Off route</p>
			<h1>This trail ends here.</h1>
			<p class="lead">The page you were looking for does not exist (anymore). <span lang="de">Diese Seite gibt es nicht (mehr).</span></p>
			<p class="nf-links">
				<a class="btn" href="/">Home</a>
				<a class="btn btn--ghost" href="/work/">Work</a>
				<a class="btn btn--ghost" href="/de/">Deutsch</a>
			</p>
		</div>
		<Terrain id="sajama" lang="en" />
	</div>
</Base>

<style>
	.nf {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px clamp(32px, 6vw, 110px);
		align-items: center;
		padding-top: clamp(32px, 6vw, 96px);
	}
	h1 {
		margin: 22px 0 24px;
		font-size: clamp(34px, 4.4vw, 68px);
		line-height: 1.08;
		letter-spacing: -0.03em;
		font-variation-settings: 'wdth' 86;
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}
	@media (max-width: 900px) {
		.nf {
			grid-template-columns: 1fr;
		}
	}
</style>
