---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { packages, audience, solution, benefits, faq } from '../data/content';
import GlassSystem from '../components/GlassSystem.astro';
import Calculator from '../components/Calculator.astro';
import FilmPlayer from '../components/FilmPlayer.tsx';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

const title = de
	? 'Formatschnitt – Freelance-Cutter für YouTube-Formate von Unternehmen'
	: 'Formatschnitt – Freelance Video Editor for Company YouTube Formats';
const description = de
	? 'Keine Zeit fürs Editing? Individuelle Schnitt-Systeme für Unternehmen mit YouTube-Format: einmal einrichten, jede Folge im gleichen Standard. Festpreise ab 1.950 €.'
	: 'No time for editing? Custom editing systems for companies with a YouTube format: set up once, every episode to the same standard. Fixed prices from €1,950.';

// Posters rendered from the hero film (scripts/render-film.mjs) — shown before the player hydrates.
const files = import.meta.glob<ImageMetadata>('../assets/film/*.webp', { eager: true, import: 'default' });
const poster = async (tag: 'wide' | 'tall', at: 'start' | 'end') => {
	const src = files[`../assets/film/${tag}-${lang}-${at}.webp`];
	const widths = tag === 'wide' ? [960, 1440, 1920] : [540, 810, 1080];
	const [avif, webp] = await Promise.all([
		getImage({ src, widths, format: 'avif', quality: 60 }),
		getImage({ src, widths, format: 'webp', quality: 74 }),
	]);
	return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src };
};
const P = {
	wideStart: await poster('wide', 'start'),
	wideEnd: await poster('wide', 'end'),
	tallStart: await poster('tall', 'start'),
	tallEnd: await poster('tall', 'end'),
};
const filmSizes = '(max-width: 719px) 92vw, min(1240px, 92vw)';
const filmLabels = de
	? { play: 'Abspielen', pause: 'Pause', replay: 'Nochmal abspielen', position: 'Film-Position', of: 'von' }
	: { play: 'Play', pause: 'Pause', replay: 'Replay', position: 'Film position', of: 'of' };

const budgets = de
	? ['Pilot (1.950 €)', 'bis 5.000 €', '5.000–10.000 € / Monat', 'über 10.000 € / Monat', 'Weiß ich noch nicht']
	: ['Pilot (€1,950)', 'up to €5k', '€5–10k / month', 'over €10k / month', 'Not sure yet'];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
};
const offerLd = {
	'@context': 'https://schema.org',
	'@type': 'OfferCatalog',
	name: de ? 'Formatschnitt Pakete' : 'Formatschnitt packages',
	itemListElement: packages.map((p) => ({
		'@type': 'Offer',
		name: p.name[lang],
		priceCurrency: 'EUR',
		price: Number(p.price.de.replace(/[^\d]/g, '')),
		description: p.points.map((x) => x[lang]).join('; '),
	})),
};
---

<Base lang={lang} title={title} description={description} alt={{ de: '/', en: '/en/' }} jsonLd={[faqLd, offerLd]}>
	<section class="hero" aria-labelledby="hero-h">
		<div class="aura" aria-hidden="true"></div>
		<div class="hero-in">
			<figure class="film" data-film aria-label={de ? 'Film: Keine Zeit fürs Editing? Wir nehmen euch diese Zeit ab.' : 'Film: No time for editing? We take this time off your hands.'}>
				<div class="film-screen">
					<picture class="film-poster">
						<source media="(max-width: 719px) and (prefers-reduced-motion: reduce)" type="image/avif" srcset={P.tallEnd.avif} sizes={filmSizes} />
						<source media="(max-width: 719px)" type="image/avif" srcset={P.tallStart.avif} sizes={filmSizes} />
						<source media="(prefers-reduced-motion: reduce)" type="image/avif" srcset={P.wideEnd.avif} sizes={filmSizes} />
						<source type="image/avif" srcset={P.wideStart.avif} sizes={filmSizes} />
						<source media="(max-width: 719px)" type="image/webp" srcset={P.tallStart.webp} sizes={filmSizes} />
						<img src={P.wideStart.src} srcset={P.wideStart.webp} sizes={filmSizes} width="1920" height="1080" alt="" fetchpriority="high" decoding="async" />
					</picture>
					<noscript>
						<video class="film-video" controls muted playsinline preload="none" poster={P.wideEnd.src}>
							<source src={`/media/edit-film-wide-${lang}.mp4`} type="video/mp4" />
						</video>
					</noscript>
				</div>
				<div class="film-bar" aria-hidden="true"></div>
				<div class="film-island">
					<FilmPlayer client:only="react" lang={lang} labels={filmLabels} />
				</div>
				<figcaption class="sr-only">
					{
						de
							? 'Film: „Keine Zeit fürs Editing?“ – Stunden zählen hoch: 6 h, plus 6 h, plus 6 h. Die Zahlen zerbrechen, darunter läuft ein schneller Schnitt, bis daraus eine Linie wird, die schreibt: „Wir nehmen euch diese Zeit ab.“ Dann: Individuelle Schnitt-Systeme – schnell, zuverlässig, professionell. Einmal einrichten, läuft jede Folge. Mehr Zeit, weniger Kosten, höhere Qualität. Erstgespräch buchen.'
							: 'Film: “No time for editing?” – hours count up: 6 h, plus 6 h, plus 6 h. The numbers shatter, a fast edit races underneath until it turns into one line that writes: “We take this time off your hands.” Then: custom editing systems – fast, reliable, professional. Set up once, runs every episode. More time, lower cost, higher quality. Book an intro call.'
					}
				</figcaption>
			</figure>
			<div class="hero-row">
				<h1 id="hero-h" data-split>{de ? 'Euer YouTube-Format als Schnitt-System.' : 'Your YouTube format as an edit system.'}</h1>
				<div class="hero-cta">
					<a class="btn btn--primary" data-magnetic href="#kontakt">{de ? 'Erstgespräch buchen' : 'Book an intro call'} <span class="arr">→</span></a>
					<a class="btn" href="#loesung">{de ? 'So funktioniert’s' : 'How it works'}</a>
				</div>
			</div>
		</div>
	</section>

	<section id="loesung" class="sec solution">
		<div class="wrap">
			<div class="sec-h">
				<p class="eyebrow">{de ? 'Die Lösung' : 'The solution'}</p>
				<h2 data-split>{de ? 'Wir nehmen euch diese Zeit ab.' : 'We take this time off your hands.'}</h2>
				<p>
					{
						de
							? 'Individuelle Schnitt-Systeme für euer Videoformat – schnell, zuverlässig, professionell. Einmal einrichten, dann läuft jede Folge.'
							: 'Custom editing systems for your video format – fast, reliable, professional. Set up once, then every episode runs.'
					}
				</p>
			</div>
			<div class="sol-grid">
				<ol class="sol-steps">
					{
						solution.map((x, i) => (
							<li class="sol-step glass reveal" data-tilt style={`--i:${i}`}>
								<span class="sol-n">{x.n}</span>
								<div>
									<h3>{x.title[lang]}</h3>
									<p class="muted">{x.text[lang]}</p>
								</div>
							</li>
						))
					}
				</ol>
				<GlassSystem />
			</div>
		</div>
	</section>

	<section id="vorteile" class="sec benefits">
		<div class="aura aura--b" aria-hidden="true"></div>
		<div class="wrap">
			<div class="sec-h">
				<p class="eyebrow">{de ? 'Was ihr davon habt' : 'What you get out of it'}</p>
				<h2 data-split>{de ? 'Mehr Zeit. Weniger Kosten. Höhere Qualität.' : 'More time. Lower cost. Higher quality.'}</h2>
			</div>
			<div class="bn">
				{
					benefits.map((b, i) => (
						<article class="bn-card glass reveal" data-tilt style={`--i:${i}`}>
							<p class="bn-k">{b.title[lang]}</p>
							<p class="bn-v">
								{b.prefix?.[lang]}
								<span data-count={b.value}>{b.value.toLocaleString(de ? 'de-DE' : 'en-GB')}</span>
								<span class:list={['bn-sfx', { 'bn-word': /[a-z]/i.test(b.suffix[lang]) }]}>{b.suffix[lang]}</span>
							</p>
							<p class="muted">{b.text[lang]}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="sec who" aria-labelledby="who-h">
		<div class="wrap">
			<div class="sec-h">
				<p class="eyebrow">{de ? 'Für wen' : 'Who it’s for'}</p>
				<h2 id="who-h" data-split>{de ? 'Kommt euch das bekannt vor?' : 'Sound familiar?'}</h2>
			</div>
			<ul class="who-list">
				{
					audience.map((a, i) => (
						<li class="glass reveal" data-tilt style={`--i:${i}`}>
							<span class="who-n" aria-hidden="true">{i + 1}</span>
							<p>{a[lang]}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id="pakete" class="sec">
		<div class="aura aura--b" aria-hidden="true"></div>
		<div class="wrap">
			<div class="sec-h">
				<p class="eyebrow">{de ? 'Pakete & Preise' : 'Packages & pricing'}</p>
				<h2>{de ? 'Festpreise. Schriftlich. Vorab.' : 'Fixed prices. In writing. Upfront.'}</h2>
				<p>{de ? 'Tagessatz 750 €. Pakete sind günstiger – das System macht die Arbeit schneller.' : 'Day rate €750. Packages cost less – the system makes the work faster.'}</p>
			</div>
			<div class="pk">
				{
					packages.map((p, i) => (
						<article class:list={['pk-card', 'glass', 'reveal', { hl: p.highlight }]} style={`--i:${i % 3}`}>
							<div class="pk-top">
								<h3>{p.name[lang]}</h3>
								{p.highlight && <span class="pk-tag">{de ? 'Empfohlener Einstieg' : 'Recommended start'}</span>}
							</div>
							<p class="pk-sub">{p.sub[lang]}</p>
							<p class="pk-price">{p.price[lang]}</p>
							<p class="pk-meta muted">
								{p.unit[lang]} · {p.days[lang]}
							</p>
							<dl class="pk-dl">
								<div>
									<dt>{de ? 'Für wen' : 'For'}</dt>
									<dd>{p.for[lang]}</dd>
								</div>
								<div>
									<dt>{de ? 'Ihr bekommt' : 'You get'}</dt>
									<dd>
										<ul>
											{p.points.map((x) => (
												<li>{x[lang]}</li>
											))}
										</ul>
									</dd>
								</div>
								<div>
									<dt>{de ? 'Ergebnis' : 'Result'}</dt>
									<dd>{p.result[lang]}</dd>
								</div>
							</dl>
							<a class:list={['btn', 'pk-cta', { 'btn--primary': p.highlight }]} href="#kontakt" data-pkg={p.name[lang]}>
								{de ? 'Anfragen' : 'Enquire'}
								<span class="sr-only">: {p.name[lang]}</span> <span class="arr" aria-hidden="true">→</span>
							</a>
						</article>
					))
				}
			</div>
			<p class="pk-note muted">
				{
					de
						? 'Alle Preise netto. Abrechnung über Micha Roessler LLC (USA); B2B-Kunden in der EU: Reverse-Charge, keine deutsche USt. auf der Rechnung. USD-Preise auf Anfrage.'
						: 'All prices net. Invoiced by Micha Roessler LLC (USA); EU B2B clients: reverse charge. USD pricing on request.'
				}
			</p>
		</div>
	</section>

	<section id="rechner" class="sec sec--tight">
		<div class="wrap">
			<div class="sec-h">
				<p class="eyebrow">{de ? 'Rechner' : 'Calculator'}</p>
				<h2>{de ? 'Was spart euch ein System?' : 'What would a system save you?'}</h2>
			</div>
			<Calculator lang={lang} />
		</div>
	</section>

	<section class="sec about">
		<div class="wrap">
			<div class="about-card glass reveal">
				<Image src={portrait} alt="Micha Rössler" widths={[320, 640, 960]} sizes="(min-width: 900px) 360px, 80vw" class="about-img" />
				<div class="about-t">
					<p class="eyebrow">{de ? 'Wer dahinter steht' : 'Who is behind it'}</p>
					<h2 data-split>{de ? 'Eine Person. Schnitt und System.' : 'One person. Edit and system.'}</h2>
					<p class="about-p muted">
						{
							de
								? 'Ich bin Micha Rössler, Editor und Filmemacher. Ich schneide Serienformate für Unternehmen – so, dass jede Folge im gleichen Standard entsteht und euer Team weniger abstimmen muss.'
								: 'I am Micha Rössler, editor and filmmaker. I edit series formats for companies – so every episode is made to the same standard and your team has less to coordinate.'
						}
					</p>
					<p class="trust-line">
						{de ? 'Geschnitten u. a. für Carwow DE und Felix von der Laden (1,2 / 1,4 Mio. Aufrufe).' : 'Edited for, among others, Carwow DE and Felix von der Laden (1.2M / 1.4M views).'}
					</p>
					<a class="btn" href={de ? 'https://micharoessler.com/de/' : 'https://micharoessler.com/'}>micharoessler.com <span class="arr">↗</span></a>
				</div>
			</div>
		</div>
	</section>

	<section id="faq" class="sec">
		<div class="wrap">
			<div class="sec-h">
				<p class="eyebrow">FAQ</p>
				<h2>{de ? 'Häufige Fragen' : 'Common questions'}</h2>
			</div>
			<div class="faq glass">
				{
					faq.map((f) => (
						<details name="faq">
							<summary>
								<span>{f.q[lang]}</span>
								<i class="q-x" aria-hidden="true" />
							</summary>
							<p class="muted">{f.a[lang]}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section id="kontakt" class="sec contact">
		<div class="aura" aria-hidden="true"></div>
		<div class="wrap">
			<div class="c-card glass">
				<div class="c-txt">
					<p class="eyebrow">{de ? 'Kontakt' : 'Contact'}</p>
					<h2>{de ? 'Erzählt mir von eurem Format.' : 'Tell me about your format.'}</h2>
					<div class="c-who">
						<Image src={portrait} alt="" width={112} height={112} widths={[56, 112]} sizes="56px" class="c-avatar" />
						<p><b>Micha Rössler</b><br /><span class="muted">{de ? 'antwortet persönlich' : 'replies personally'}</span></p>
					</div>
					<p class="c-mail muted">
						{de ? 'Antwort innerhalb von zwei Werktagen. Oder direkt: ' : 'Reply within two working days. Or directly: '}
						<a href="mailto:hello@micharoessler.com">hello@micharoessler.com</a>
					</p>
					<ul class="trust">
						<li>{de ? 'Direkt mit mir – keine Agentur, kein Vertrieb.' : 'Directly with me – no agency, no sales team.'}</li>
						<li>{de ? 'Festpreis schriftlich vor Start. Überzeugt der Pilot nicht, endet es dort – ohne Folgekosten.' : 'Fixed price in writing before we start. If the pilot does not convince you, it ends there – no follow-on costs.'}</li>
						<li>{de ? 'Remote, auf Deutsch oder Englisch. Abrechnung über Micha Roessler LLC.' : 'Remote, in German or English. Invoiced via Micha Roessler LLC.'}</li>
					</ul>
				</div>
				<form class="f" id="brief" data-subject={de ? 'Anfrage Formatschnitt' : 'Formatschnitt enquiry'}>
					<div class="f-row">
						<label><span>{de ? 'Name' : 'Name'}</span><input name="Name" required autocomplete="name" /></label>
						<label><span>{de ? 'Firma / Kanal' : 'Company / channel'}</span><input name={de ? 'Firma' : 'Company'} autocomplete="organization" /></label>
					</div>
					<div class="f-row">
						<label><span>{de ? 'Link zum Format' : 'Link to the format'}</span><input name={de ? 'Format-Link' : 'Format link'} type="url" placeholder="https://youtube.com/…" /></label>
						<label><span>{de ? 'Folgen pro Monat' : 'Episodes per month'}</span><input name={de ? 'Folgen/Monat' : 'Episodes/month'} inputmode="numeric" /></label>
					</div>
					<fieldset>
						<legend>{de ? 'Budget' : 'Budget'}</legend>
						<div class="chips">
							{
								budgets.map((b, i) => (
									<label class="chip">
										<input type="radio" name="Budget" value={b} checked={i === 0} />
										<span>{b}</span>
									</label>
								))
							}
						</div>
					</fieldset>
					<label><span>{de ? 'Start' : 'Start'}</span><input name="Start" placeholder={de ? 'z. B. Januar' : 'e.g. January'} /></label>
					<label><span>{de ? 'Was soll besser werden?' : 'What should get better?'}</span><textarea name={de ? 'Ziel' : 'Goal'} rows="4"></textarea></label>
					<div class="f-send">
						<button class="btn btn--primary" type="submit">{de ? 'E-Mail vorbereiten' : 'Prepare email'} <span class="arr">→</span></button>
						<p class="f-note muted">{de ? 'Öffnet euer Mailprogramm. Auf dieser Seite wird nichts gespeichert.' : 'Opens your email app. Nothing is stored on this site.'}</p>
					</div>
				</form>
			</div>
		</div>
	</section>
</Base>

<script>
	// Package CTAs carry the chosen package into the brief.
	document.querySelectorAll<HTMLAnchorElement>('[data-pkg]').forEach((a) =>
		a.addEventListener('click', () => {
			const goal = document.querySelector<HTMLTextAreaElement>('#brief textarea');
			const line = `${document.documentElement.lang.startsWith('de') ? 'Paket' : 'Package'}: ${a.dataset.pkg}`;
			if (goal && !goal.value.includes(line)) goal.value = (goal.value ? goal.value + '\n' : '') + line;
		}),
	);

	const f = document.getElementById('brief') as HTMLFormElement;
	f?.addEventListener('submit', (e) => {
		e.preventDefault();
		const lines = [...new FormData(f).entries()].filter(([, v]) => String(v).trim()).map(([k, v]) => `${k}: ${v}`);
		location.href = `mailto:hello@micharoessler.com?subject=${encodeURIComponent(f.dataset.subject ?? '')}&body=${encodeURIComponent(lines.join('\n\n'))}`;
	});

	// Page motion (GSAP: split headings, counters, magnetic CTA, glass tilt) — loaded after first paint,
	// never part of the first-viewport budget. Skipped entirely under prefers-reduced-motion.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const go = () => import('../scripts/motion').then((m) => m.init());
		if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 2500 });
		else setTimeout(go, 1200);
	}
</script>

<style>
	/* ---------- hero: the film is the first screen ---------- */
	.hero {
		position: relative;
		isolation: isolate;
	}
	.hero .aura {
		bottom: -40vh;
	}
	.hero-in {
		display: grid;
		justify-items: center;
		gap: clamp(14px, 2vh, 22px);
		padding: 10px var(--gutter) clamp(28px, 4vw, 56px);
	}
	.film {
		--bar: 60px;
		position: relative;
		margin: 0;
		width: min(1240px, 100%, calc((100svh - 66px - 196px) * 16 / 9));
		padding: 10px;
		border-radius: 30px;
		background: var(--glass-bg);
		border: var(--glass-edge);
		box-shadow: var(--glass-shadow);
	}
	.film-screen {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 22px;
		overflow: hidden;
		background: #eef0f5;
	}
	.film-poster img,
	.film-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.film-bar {
		height: var(--bar);
	}
	.film-island {
		position: absolute;
		inset: 10px;
	}
	@media (max-width: 719px) {
		.film {
			width: min(100%, calc((100svh - 66px - 24px - var(--bar)) * 9 / 16));
			padding: 8px;
			border-radius: 26px;
		}
		.film-screen {
			aspect-ratio: 9 / 16;
			border-radius: 19px;
		}
		.film-island {
			inset: 8px;
		}
	}
	.hero-row {
		width: min(1240px, 100%);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 14px 28px;
		padding-inline: 6px;
	}
	h1 {
		font-size: clamp(28px, 3.1vw, 46px);
		font-weight: 680;
		letter-spacing: -0.04em;
		line-height: 1.04;
		max-width: 16em;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	@media (max-width: 719px) {
		.hero-row {
			justify-content: center;
			text-align: center;
		}
		.hero-cta {
			justify-content: center;
		}
	}
	.film :global(.fp) {
		display: grid;
		grid-template-rows: auto var(--bar);
		height: 100%;
	}
	.film :global(.fp-screen) {
		border-radius: 22px;
		overflow: hidden;
		background: #eef0f5;
	}
	@media (max-width: 719px) {
		.film :global(.fp-screen) {
			border-radius: 19px;
		}
	}
	.film :global(.fp-bar) {
		display: grid;
		grid-template-columns: 44px 1fr auto 44px;
		align-items: center;
		gap: 12px;
		padding: 10px 4px 0;
	}
	.film :global(.fp-btn) {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		color: var(--ink);
		background: rgba(255, 255, 255, 0.9);
		box-shadow:
			inset 0 1px 0 #fff,
			0 0 0 1px rgba(29, 29, 31, 0.08),
			0 4px 12px -6px rgba(16, 24, 40, 0.25);
		transition: transform 0.2s var(--ease);
	}
	.film :global(.fp-btn:hover) {
		transform: scale(1.06);
	}
	.film :global(.fp-btn svg) {
		width: 20px;
		height: 20px;
		fill: currentColor;
	}
	.film :global(.fp-btn:last-child svg) {
		fill: none;
	}
	.film :global(.fp-time) {
