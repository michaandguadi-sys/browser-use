---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { packages, systemParts, proof, tools, faq } from '../data/content';
import SpecDemo from '../components/SpecDemo.astro';
import Calculator from '../components/Calculator.astro';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

const title = de
	? 'Formatschnitt – Cutter Freelancer für YouTube-Formate & Schnitt-Systeme'
	: 'Formatschnitt – Format Video Editor & Edit Systems for YouTube Teams';
const description = de
	? 'Freelance-Cutter für wiederkehrende YouTube-Formate: Schnitt-Templates, datengetriebene Grafiken, Shorts-Pipeline und Retainer. Festpreise ab 1.950 €, Tagessatz 750 €.'
	: 'Freelance editor for recurring YouTube formats: edit templates, data-driven graphics, shorts pipeline and retainers. Fixed prices from €1,950, day rate €750.';

// Timeline clips for the hero diagram: [track, start%, width%, colour, label]
const clips: [number, number, number, string, string][] = [
	[0, 0, 9, 'var(--clip-red)', 'Hook'],
	[0, 9, 11, 'var(--clip-blue)', 'Intro'],
	[0, 20, 24, 'var(--clip-blue)', de ? 'Test A' : 'Segment A'],
	[0, 44, 24, 'var(--clip-blue)', de ? 'Test B' : 'Segment B'],
	[0, 68, 20, 'var(--clip-blue)', 'Verdict'],
	[0, 88, 12, 'var(--clip-green)', 'End'],
	[1, 3, 10, 'var(--clip-yellow)', 'Title'],
	[1, 22, 9, 'var(--clip-yellow)', 'Spec'],
	[1, 46, 9, 'var(--clip-yellow)', 'Spec'],
	[1, 70, 13, 'var(--clip-yellow)', 'Score'],
	[2, 0, 100, 'var(--clip-green)', ''],
];
const tracks = ['V1', 'GFX', 'A1'];

// What the system automates at each beat – shown when the playhead crosses it.
const beats: [number, number, string][] = de
	? [
			[0, 9, 'Hook · aus der Hook-Bank, 3 Varianten pro Folge vorbereitet'],
			[9, 20, 'Intro · Template mit Titelkarte aus der Tabelle'],
			[20, 44, 'Test A · Spec-Card automatisch befüllt'],
			[44, 68, 'Test B · gleiche Grafik, neue Daten – kein Neu-Animieren'],
			[68, 88, 'Verdict · Score-Overlay aus der Tabelle'],
			[88, 100, 'Endscreen · Export-Preset + 3–6 Shorts aus Transkript-Selects'],
		]
	: [
			[0, 9, 'Hook · from the hook bank, 3 variants prepared per episode'],
			[9, 20, 'Intro · template with title card from the sheet'],
			[20, 44, 'Segment A · spec card filled automatically'],
			[44, 68, 'Segment B · same graphic, new data – no re-animating'],
			[68, 88, 'Verdict · score overlay from the sheet'],
			[88, 100, 'End screen · export preset + 3–6 shorts from transcript selects'],
		];

const steps = de
	? [
			['01', 'Erstgespräch', '15 Minuten, kostenlos. Ihr zeigt mir euer Format, ich sage ehrlich, ob ein System sich lohnt.', 'Kostenlos'],
			['02', 'Pilot', 'Eine Folge plus drei Shorts aus eurem Material – zum Festpreis.', '1.950 € · ≈ 1 Woche'],
			['03', 'Setup', 'Audit, Templates, Grafik-Kit, Shorts-Pipeline, SOP.', '3.500 € · 3–4 Wochen'],
			['04', 'Retainer', 'Ich schneide auf dem System, monatlich planbar.', 'ab 4.200 € / Monat'],
		]
	: [
			['01', 'Intro call', '15 minutes, free. Show me your format; I will tell you honestly whether a system is worth it.', 'Free'],
			['02', 'Pilot', 'One episode plus three shorts from your footage, at a fixed price.', '€1,950 · ≈ 1 week'],
			['03', 'Setup', 'Audit, templates, graphics kit, shorts pipeline, SOP.', '€3,500 · 3–4 weeks'],
			['04', 'Retainer', 'I edit on the system, plannable month to month.', 'from €4,200 / month'],
		];

const budgets = de
	? ['Pilot (1.950 €)', 'bis 5.000 €', '5.000–10.000 € / Monat', 'über 10.000 € / Monat', 'Weiß ich noch nicht']
	: ['Pilot (€1,950)', 'up to €5k', '€5–10k / month', 'over €10k / month', 'Not sure yet'];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
};
const offerLd = {
	'@context': 'https://schema.org',
	'@type': 'OfferCatalog',
	name: de ? 'Formatschnitt Pakete' : 'Formatschnitt packages',
	itemListElement: packages.map((p) => ({
		'@type': 'Offer',
		name: p.name[lang],
		priceCurrency: 'EUR',
		price: Number(p.price.de.replace(/[^\d]/g, '')),
		description: p.points.map((x) => x[lang]).join('; '),
	})),
};
---

<Base lang={lang} title={title} description={description} alt={{ de: '/', en: '/en/' }} jsonLd={[faqLd, offerLd]}>
	<section class="hero wrap">
		<div class="hero-txt">
			<p class="mono label">{de ? 'Freelance-Cutter · Workflow · Retainer' : 'Freelance editor · Workflow · Retainer'}</p>
			<h1>
				{de ? 'Euer YouTube-Format als Schnitt-System.' : 'Your YouTube format as an edit system.'}
			</h1>
			<p class="hero-sub">
				{
					de
						? 'Weniger Handarbeit pro Folge, mehr Shorts aus jedem Dreh. Ich baue für euer wiederkehrendes Format Templates, datengetriebene Grafiken, eine Shorts-Pipeline und eine saubere Review-Schleife – und schneide darauf im Retainer oder übergebe alles an euer Team.'
						: 'Less manual work per episode, more shorts from every shoot. I build templates, data-driven graphics, a shorts pipeline and a clean review loop for your recurring format – then edit on it for you on retainer, or hand it all to your team.'
				}
			</p>
			<div class="hero-cta">
				<a class="btn btn--ink" href="#kontakt">{de ? 'Erstgespräch buchen' : 'Book an intro call'} <span class="arr">→</span></a>
				<a class="btn" href="#system">{de ? 'System ansehen' : 'See the system'}</a>
			</div>
			<dl class="spec">
				<div><dt class="mono">{de ? 'Tagessatz' : 'Day rate'}</dt><dd>{de ? '750 €' : '€750'}</dd></div>
				<div><dt class="mono">{de ? 'Einstieg' : 'Start'}</dt><dd>{de ? 'Pilot, Festpreis' : 'Fixed-price pilot'}</dd></div>
				<div><dt class="mono">{de ? 'Tools' : 'Tools'}</dt><dd>Premiere · Resolve · Remotion</dd></div>
				<div><dt class="mono">{de ? 'Sprachen' : 'Languages'}</dt><dd>DE · EN</dd></div>
			</dl>
		</div>

		<figure class="tl" tabindex="0" data-beats={JSON.stringify(beats)} aria-label={de ? 'Schema einer Format-Timeline: Hook, Intro, Segmente, Verdict, Endscreen mit Grafik-Spur' : 'Diagram of a format timeline: hook, intro, segments, verdict, end screen with graphics track'}>
			<div class="tl-head mono">
				<span>EP_042_{de ? 'Vergleichstest' : 'comparison'}.prproj</span>
				<span class="tc">00:12:48:16</span>
			</div>
			<div class="tl-ruler mono" aria-hidden="true">
				{['00:00', '02:00', '04:00', '06:00', '08:00', '10:00', '12:00'].map((x) => <span>{x}</span>)}
			</div>
			<div class="tl-tracks" aria-hidden="true">
				{
					tracks.map((name, ti) => (
						<div class="track">
							<span class="mono tn">{name}</span>
							<div class="lane">
								{clips
									.filter((c) => c[0] === ti)
									.map(([, x, w, c, l], i) => (
										<span class="clip" style={`--x:${x}%;--w:${w}%;--c:${c};--d:${(ti * 6 + i) * 70}ms`}>
											{l}
										</span>
									))}
								{ti === 2 && (
									<svg class="wave" viewBox="0 0 400 20" preserveAspectRatio="none">
										<path d={Array.from({ length: 100 }, (_, i) => `M${i * 4} ${10 - ((i * 7919) % 9)}V${10 + ((i * 104729) % 9)}`).join('')} stroke="#2a6b33" stroke-width="1.6" />
									</svg>
								)}
							</div>
						</div>
					))
				}
				<span class="playhead"></span>
			</div>
			<p class="mono tl-note" aria-live="polite" data-note>{beats[0][2]}</p>
			<figcaption class="mono tl-cap">
				<span>{de ? 'Template' : 'Template'}: 11 Clips · 4 {de ? 'Grafik-Beats aus Tabelle' : 'graphic beats from sheet'}</span>
				<span class="tl-keys">{de ? 'Ziehen oder' : 'Drag or'} <kbd>J</kbd><kbd>K</kbd><kbd>L</kbd></span>
			</figcaption>
		</figure>
	</section>

	<section class="strip">
		<div class="wrap strip-in">
			<p class="mono">{de ? 'Geschnitten für' : 'Edited for'}</p>
			<ul>
				<li>Carwow DE <span class="mono">{de ? '· 3 Review-Folgen, 2025' : '· 3 review episodes, 2025'}</span></li>
				<li>Felix von der Laden <span class="mono">· 2 {de ? 'Langform-Dokus' : 'long-form docs'}</span></li>
			</ul>
			<p class="mono strip-n">
				{de ? 'Selbst prüfen:' : 'Check for yourself:'}
				<a href="https://www.youtube.com/watch?v=7Kt9NFOXqF4" rel="noopener">Drivers Eye ↗</a>
				<a href="https://www.youtube.com/watch?v=ER8HBwDKMGw" rel="noopener">Hotrodtour ↗</a>
			</p>
		</div>
	</section>

	<section id="system" class="sec wrap">
		<div class="sec-h">
			<p class="mono label">{de ? 'Das System' : 'The system'}</p>
			<h2>{de ? 'Euer Format als System' : 'Your format as a system'}</h2>
			<p>
				{
					de
						? 'Wer jede Woche dieselbe Show produziert, sollte nicht jede Woche dieselben Dinge neu bauen. Sechs Bausteine, die ich für euer Format aufsetze:'
						: 'If you ship the same show every week, you should not rebuild the same things every week. Six building blocks I set up for your format:'
				}
			</p>
		</div>
		<ol class="parts">
			{
				systemParts.map((s) => (
					<li class="reveal">
						<span class="mono n">{s.n}</span>
						<h3>{s.title[lang]}</h3>
						<p>{s.text[lang]}</p>
					</li>
				))
			}
		</ol>
		<p class="ai mono">
			{de ? 'KI hilft. Der Schnitt entscheidet. Keine generierten Moderatoren, kein Auto-Slop.' : 'AI assists. The edit decides. No generated presenters, no auto-slop.'}
		</p>
	</section>

	<section id="demo" class="sec wrap">
		<div class="sec-h">
			<p class="mono label">{de ? 'Live-Demo' : 'Live demo'}</p>
			<h2>{de ? 'Grafik aus der Tabelle. Probiert es aus.' : 'Graphics from a spreadsheet. Try it.'}</h2>
			<p>
				{
					de
						? 'So funktionieren datengetriebene Grafiken: Ihr pflegt Werte, das Template rendert – in 16:9 und 9:16. Ändert eine Zahl.'
						: 'This is how data-driven graphics work: you maintain values, the template renders – in 16:9 and 9:16. Change a number.'
				}
			</p>
		</div>
		<SpecDemo lang={lang} />
	</section>

	<section id="ablauf" class="sec wrap">
		<div class="sec-h">
			<p class="mono label">{de ? 'Ablauf' : 'Process'}</p>
			<h2>{de ? 'Klein anfangen, dann skalieren' : 'Start small, then scale'}</h2>
		</div>
		<ol class="steps">
			{
				steps.map(([n, h, p, s]) => (
					<li class="reveal">
						<span class="mono n">{n}</span>
						<h3>{h}</h3>
						<p>{p}</p>
						<p class="mono s">{s}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section id="rechner" class="sec wrap">
		<div class="sec-h">
			<p class="mono label">{de ? 'Rechner' : 'Calculator'}</p>
			<h2>{de ? 'Was spart euch ein System?' : 'What would a system save you?'}</h2>
			<p>{de ? 'Eure Zahlen rein, Schätzung raus – inklusive passendem Paket.' : 'Your numbers in, an estimate out – including the matching package.'}</p>
		</div>
		<Calculator lang={lang} />
	</section>

	<section id="pakete" class="sec wrap">
		<div class="sec-h">
			<p class="mono label">{de ? 'Pakete & Preise' : 'Packages & pricing'}</p>
			<h2>{de ? 'Festpreise. Schriftlich. Vorab.' : 'Fixed prices. In writing. Upfront.'}</h2>
			<p>
				{
					de
						? 'Basis ist ein Tagessatz von 750 €. Pakete sind günstiger als Einzeltage, weil das System die Arbeit schneller macht – das ist der Punkt.'
						: 'Base day rate is €750. Packages cost less than single days because the system makes the work faster – that is the point.'
				}
			</p>
			<a class="mono calc-link" href="#rechner">{de ? 'Unsicher? Rechner nutzen ↑' : 'Not sure? Use the calculator ↑'}</a>
		</div>
		<div class="pk">
			{
				packages.map((p) => (
					<article class:list={['pk-card', 'reveal', { hl: p.highlight }]}>
						{p.highlight && <p class="mono pk-tag">{de ? 'Empfohlener Einstieg' : 'Recommended start'}</p>}
						<h3>{p.name[lang]}</h3>
						<p class="pk-price">
							{p.price[lang]} <span class="mono">{p.unit[lang]}</span>
						</p>
						<p class="mono pk-days">{p.days[lang]}</p>
						<ul>
							{p.points.map((x) => (
								<li>{x[lang]}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
		<p class="mono pk-note">
			{
				de
					? 'Alle Preise netto. Abrechnung über Micha Roessler LLC (USA); B2B-Kunden in der EU: Reverse-Charge, keine deutsche USt. auf der Rechnung. USD-Preise auf Anfrage.'
					: 'All prices net. Invoiced by Micha Roessler LLC (USA); EU B2B clients: reverse charge. USD pricing on request.'
			}
		</p>
	</section>

	<section id="arbeiten" class="sec wrap">
		<div class="sec-h">
			<p class="mono label">{de ? 'Arbeiten' : 'Work'}</p>
			<h2>{de ? 'Was ich gebaut und geschnitten habe' : 'What I have built and edited'}</h2>
			<p>
				{
					de
						? 'Ehrlich eingeordnet: Format-Schnitt für Marken ist ein junger Schwerpunkt bei mir, Workflows baue ich seit Jahren für meine eigenen Produktionen. Große Agentur-Logos habe ich nicht – deshalb startet jede Zusammenarbeit mit einem bezahlten Pilot statt mit Versprechen. Keine erfundenen Zahlen; Kunden ohne Freigabe bleiben anonym.'
						: 'Honestly put: format editing for brands is a young focus for me; I have been building workflows for my own productions for years. I do not have big agency logos – which is why every engagement starts with a paid pilot instead of promises. No invented numbers; clients who have not approved being named stay anonymous.'
				}
			</p>
		</div>
		<div class="cases">
			{
				proof.map((c) => (
					<article class="case reveal">
						<p class="mono">{c.tag[lang]}</p>
						<h3>{c.title[lang]}</h3>
						<p>{c.text[lang]}</p>
					</article>
				))
			}
		</div>
		<div class="tools">
			<p class="mono label">{de ? 'Werkzeuge, die ich selbst baue und nutze' : 'Tools I build and use'}</p>
			<dl>
				{
					tools.map((t) => (
						<div class="reveal">
							<dt>{t.name}</dt>
							<dd>{t.text[lang]}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="sec wrap about">
		<div class="sec-h">
			<p class="mono label">{de ? 'Wer dahinter steht' : 'Who is behind it'}</p>
			<h2>{de ? 'Eine Person. Schnitt und System.' : 'One person. Edit and system.'}</h2>
		</div>
		<div class="about-grid">
			<p class="about-p">
				{
					de
						? 'Ich bin Micha Rössler, Editor und Filmemacher. Gelernt habe ich das Handwerk bei Langform-Dokus für YouTube – 1,2 und 1,4 Mio. Aufrufe für Felix von der Laden. Heute schneide ich Serienformate wie Auto-Reviews und baue die Systeme dahinter: Templates, Remotion-Grafiken und eigene Tools wie eine Offload-App für den Ingest. Wenn ich nicht im Schnitt sitze, drehe ich Expeditionsfilme.'
						: 'I am Micha Rössler, editor and filmmaker. I learned the craft on long-form YouTube docs – 1.2M and 1.4M views for Felix von der Laden. Today I edit series formats like car reviews and build the systems behind them: templates, Remotion graphics and my own tools such as an offload app for ingest. When I am not editing, I shoot expedition films.'
				}
			</p>
			<a class="btn" href={de ? 'https://micharoessler.com/de/' : 'https://micharoessler.com/'}>micharoessler.com <span class="arr">↗</span></a>
		</div>
	</section>

	<section id="faq" class="sec wrap">
		<div class="sec-h">
			<p class="mono label">FAQ</p>
			<h2>{de ? 'Häufige Fragen' : 'Common questions'}</h2>
		</div>
		<div class="faq">
			{
				faq.map((f) => (
					<details>
						<summary>{f.q[lang]}</summary>
						<p>{f.a[lang]}</p>
					</details>
				))
			}
		</div>
	</section>

	<section id="kontakt" class="contact">
		<div class="wrap c-in">
			<div class="c-txt">
				<p class="mono label">{de ? 'Kontakt' : 'Contact'}</p>
				<h2>{de ? 'Erzählt mir von eurem Format.' : 'Tell me about your format.'}</h2>
				<p>
					{de ? 'Antwort innerhalb von zwei Werktagen. Oder direkt: ' : 'Reply within two working days. Or directly: '}
					<a href="mailto:hello@micharoessler.com">hello@micharoessler.com</a>
				</p>
				<ul class="trust">
					<li>{de ? 'Ihr schreibt direkt mit mir – keine Agentur, kein Vertrieb, kein Subunternehmer.' : 'You talk to me directly – no agency, no sales team, no subcontractors.'}</li>
					<li>{de ? 'Festpreis schriftlich vor Start. Überzeugt euch der Pilot nicht, endet die Zusammenarbeit dort – ohne Folgekosten.' : 'Fixed price in writing before we start. If the pilot does not convince you, it ends there – no follow-on costs.'}</li>
					<li>{de ? 'Ich bin Deutscher, arbeite remote von unterwegs und rechne über meine US-Firma Micha Roessler LLC ab.' : 'I am German, work remotely while travelling and invoice through my US company, Micha Roessler LLC.'}</li>
				</ul>
			</div>
			<form class="f" id="brief" data-subject={de ? 'Anfrage Formatschnitt' : 'Formatschnitt enquiry'}>
				<fieldset>
					<legend class="mono">01 · {de ? 'Ihr' : 'You'}</legend>
					<label><span class="mono">{de ? 'Name' : 'Name'}</span><input name="Name" required autocomplete="name" /></label>
					<label><span class="mono">{de ? 'Firma / Kanal' : 'Company / channel'}</span><input name={de ? 'Firma' : 'Company'} autocomplete="organization" /></label>
				</fieldset>
				<fieldset>
					<legend class="mono">02 · {de ? 'Das Format' : 'The format'}</legend>
					<label><span class="mono">{de ? 'Link zum Format' : 'Link to the format'}</span><input name={de ? 'Format-Link' : 'Format link'} type="url" placeholder="https://youtube.com/…" /></label>
					<label><span class="mono">{de ? 'Folgen pro Monat' : 'Episodes per month'}</span><input name={de ? 'Folgen/Monat' : 'Episodes/month'} inputmode="numeric" /></label>
				</fieldset>
				<fieldset>
					<legend class="mono">03 · {de ? 'Der Rahmen' : 'The frame'}</legend>
					<div class="chips" role="radiogroup" aria-label={de ? 'Budget' : 'Budget'}>
						{
							budgets.map((b, i) => (
								<label class="chip">
									<input type="radio" name="Budget" value={b} checked={i === 0} />
									<span>{b}</span>
								</label>
							))
						}
					</div>
					<label><span class="mono">{de ? 'Start' : 'Start'}</span><input name="Start" placeholder={de ? 'z. B. Januar' : 'e.g. January'} /></label>
					<label><span class="mono">{de ? 'Was soll besser werden?' : 'What should get better?'}</span><textarea name={de ? 'Ziel' : 'Goal'} rows="4"></textarea></label>
				</fieldset>
				<div class="f-send">
					<button class="btn btn--ink" type="submit">{de ? 'E-Mail vorbereiten' : 'Prepare email'} <span class="arr">→</span></button>
					<p class="mono f-note">{de ? 'Öffnet euer Mailprogramm. Auf dieser Seite wird nichts gespeichert.' : 'Opens your email app. Nothing is stored on this site.'}</p>
				</div>
			</form>
		</div>
	</section>
</Base>

<script>
	// Hero timeline: drag the playhead or use J/K/L like in an NLE.
	const tl = document.querySelector<HTMLElement>('.tl');
	if (tl) {
		const beats: [number, number, string][] = JSON.parse(tl.dataset.beats ?? '[]');
		const lanes = tl.querySelector<HTMLElement>('.tl-tracks')!;
		const head = tl.querySelector<HTMLElement>('.playhead')!;
		const tc = tl.querySelector<HTMLElement>('.tc')!;
		const note = tl.querySelector<HTMLElement>('[data-note]')!;
		const total = 12 * 60 + 48; // seconds in the mock episode
		let p = 0;
		let raf = 0;
		const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
		const set = (v: number) => {
			p = Math.min(1, Math.max(0, v));
			tl.classList.add('live');
			head.style.setProperty('--p', String(p));
			const t = p * total;
			tc.textContent = `00:${pad(t / 60)}:${pad(t % 60)}:${pad((t % 1) * 25)}`;
			const pct = p * 100;
			const beat = beats.find(([a, b]) => pct >= a && pct < b) ?? beats[beats.length - 1];
			if (beat && note.textContent !== beat[2]) note.textContent = beat[2];
			tl.querySelectorAll<HTMLElement>('.clip').forEach((c) => {
				const x = parseFloat(c.style.getPropertyValue('--x'));
				const w = parseFloat(c.style.getPropertyValue('--w'));
				c.classList.toggle('hot', pct >= x && pct < x + w && w < 100);
			});
		};
		const fromPointer = (e: PointerEvent) => {
			const lane = lanes.querySelector<HTMLElement>('.lane')!.getBoundingClientRect();
			set((e.clientX - lane.left) / lane.width);
		};
		const stop = () => {
			cancelAnimationFrame(raf);
			raf = 0;
		};
		const play = (dir: number) => {
			stop();
			let last = performance.now();
			const tick = (now: number) => {
				set(p + ((now - last) / 9000) * dir);
				last = now;
				if ((dir > 0 && p < 1) || (dir < 0 && p > 0)) raf = requestAnimationFrame(tick);
			};
			raf = requestAnimationFrame(tick);
		};
		lanes.addEventListener('pointerdown', (e) => {
			stop();
			lanes.setPointerCapture(e.pointerId);
			fromPointer(e);
			const move = (ev: PointerEvent) => fromPointer(ev);
			lanes.addEventListener('pointermove', move);
			lanes.addEventListener('pointerup', () => lanes.removeEventListener('pointermove', move), { once: true });
		});
		tl.addEventListener('keydown', (e) => {
			const k = e.key.toLowerCase();
			if (k === 'l') play(1);
			else if (k === 'j') play(-1);
			else if (k === 'k' || k === ' ') raf ? stop() : play(1);
			else if (k === 'arrowright') set(p + 0.02);
			else if (k === 'arrowleft') set(p - 0.02);
			else return;
			e.preventDefault();
		});
	}

	const f = document.getElementById('brief') as HTMLFormElement;
	f?.addEventListener('submit', (e) => {
		e.preventDefault();
		const lines = [...new FormData(f).entries()].filter(([, v]) => String(v).trim()).map(([k, v]) => `${k}: ${v}`);
		location.href = `mailto:hello@micharoessler.com?subject=${encodeURIComponent(f.dataset.subject ?? '')}&body=${encodeURIComponent(lines.join('\n\n'))}`;
	});
</script>

