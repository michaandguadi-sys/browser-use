---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { packages, systemParts, proof, tools, faq } from '../data/content';
import SpecDemo from '../components/SpecDemo.astro';
import Calculator from '../components/Calculator.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

const title = de
	? 'Formatschnitt – Cutter Freelancer für YouTube-Formate & Schnitt-Systeme'
	: 'Formatschnitt – Format Video Editor & Edit Systems for YouTube Teams';
const description = de
	? 'Freelance-Cutter für wiederkehrende YouTube-Formate: Schnitt-Templates, datengetriebene Grafiken, Shorts-Pipeline und Retainer. Festpreise ab 1.950 €, Tagessatz 750 €.'
	: 'Freelance editor for recurring YouTube formats: edit templates, data-driven graphics, shorts pipeline and retainers. Fixed prices from €1,950, day rate €750.';

const steps = de
	? [
			['01', 'Erstgespräch', '15 Minuten, kostenlos. Ihr zeigt mir euer Format, ich sage ehrlich, ob ein System sich lohnt.', 'Kostenlos'],
			['02', 'Pilot', 'Eine Folge plus drei Shorts aus eurem Material – zum Festpreis.', '1.950 € · ≈ 1 Woche'],
			['03', 'Setup', 'Audit, Templates, Grafik-Kit, Shorts-Pipeline, SOP.', '3.500 € · 3–4 Wochen'],
			['04', 'Retainer', 'Ich schneide auf dem System, monatlich planbar.', 'ab 4.200 € / Monat'],
		]
	: [
			['01', 'Intro call', '15 minutes, free. Show me your format; I will tell you honestly whether a system is worth it.', 'Free'],
			['02', 'Pilot', 'One episode plus three shorts from your footage, at a fixed price.', '€1,950 · ≈ 1 week'],
			['03', 'Setup', 'Audit, templates, graphics kit, shorts pipeline, SOP.', '€3,500 · 3–4 weeks'],
			['04', 'Retainer', 'I edit on the system, plannable month to month.', 'from €4,200 / month'],
		];

const budgets = de
	? ['Pilot (1.950 €)', 'bis 5.000 €', '5.000–10.000 € / Monat', 'über 10.000 € / Monat', 'Weiß ich noch nicht']
	: ['Pilot (€1,950)', 'up to €5k', '€5–10k / month', 'over €10k / month', 'Not sure yet'];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
};
const offerLd = {
	'@context': 'https://schema.org',
	'@type': 'OfferCatalog',
	name: de ? 'Formatschnitt Pakete' : 'Formatschnitt packages',
	itemListElement: packages.map((p) => ({
		'@type': 'Offer',
		name: p.name[lang],
		priceCurrency: 'EUR',
		price: Number(p.price.de.replace(/[^\d]/g, '')),
		description: p.points.map((x) => x[lang]).join('; '),
	})),
};

// Hero "multiplier wall": one episode, six vertical clips (example rate, labelled as such).
const perEp = 6;
const startEps = 4;
const ticks = [8, 22, 37, 54, 69, 86];
const ep = de ? 'Folge' : 'Episode';
const eps = (n: number) => (de ? (n === 1 ? 'Folge' : 'Folgen') : n === 1 ? 'episode' : 'episodes');
const mwCap = de
	? `Beispielrechnung: Aus jeder Folge entstehen ${perEp} Hochkant-Clips. Bei ${startEps} Folgen pro Monat sind das ${startEps * (1 + perEp)} Inhalte.`
	: `Example calculation: every episode yields ${perEp} vertical clips. At ${startEps} episodes per month, that is ${startEps * (1 + perEp)} pieces of content.`;
// Repetition band: the same word, every row, one row inverted.
const repWord = de ? 'FOLGE' : 'EPISODE';
const sec = (n: number) => `${String(n).padStart(2, '0')}/09`;
---

<Base lang={lang} title={title} description={description} alt={{ de: '/', en: '/en/' }} jsonLd={[faqLd, offerLd]}>
	<section class="hero">
		<div class="wrap hero-in">
			<div class="guides grid" aria-hidden="true">{Array.from({ length: 12 }, () => <span />)}</div>
			<div class="grid hero-g">
				<p class="mono label hero-k">{de ? 'Freelance-Cutter · Workflow · Retainer' : 'Freelance editor · Workflow · Retainer'}</p>
				<h1 class="display">
					{de ? 'Euer YouTube-Format als Schnitt-System.' : 'Your YouTube format as an edit system.'}
				</h1>
				<div class="hero-txt">
					<p class="hero-sub">
						{
							de
								? 'Weniger Handarbeit pro Folge, mehr Shorts aus jedem Dreh. Ich baue für euer wiederkehrendes Format Templates, datengetriebene Grafiken, eine Shorts-Pipeline und eine saubere Review-Schleife – und schneide darauf im Retainer oder übergebe alles an euer Team.'
								: 'Less manual work per episode, more shorts from every shoot. I build templates, data-driven graphics, a shorts pipeline and a clean review loop for your recurring format – then edit on it for you on retainer, or hand it all to your team.'
						}
					</p>
					<div class="hero-cta">
						<a class="btn btn--ink" href="#kontakt">{de ? 'Erstgespräch buchen' : 'Book an intro call'} <span class="arr">→</span></a>
						<a class="btn" href="#system">{de ? 'System ansehen' : 'See the system'}</a>
					</div>
					<dl class="spec">
						<div><dt class="mono">{de ? 'Tagessatz' : 'Day rate'}</dt><dd>{de ? '750 €' : '€750'}</dd></div>
						<div><dt class="mono">{de ? 'Einstieg' : 'Start'}</dt><dd>{de ? 'Pilot, Festpreis' : 'Fixed-price pilot'}</dd></div>
						<div><dt class="mono">{de ? 'Tools' : 'Tools'}</dt><dd>Premiere · Resolve · Remotion</dd></div>
						<div><dt class="mono">{de ? 'Sprachen' : 'Languages'}</dt><dd>DE · EN</dd></div>
					</dl>
				</div>

				<figure class="mw" data-mw data-io data-lang={lang} data-per={perEp} style="--base:18" aria-labelledby="mw-cap">
					<div class="mw-head mono">
						<span>{de ? `Beispielrechnung: ${perEp} Clips pro Folge` : `Example calculation: ${perEp} clips per episode`}</span>
						<span aria-hidden="true">16:9 → 9:16</span>
					</div>
					<div class="unit" aria-hidden="true">
						<div class="tile ep" style="--d:0">
							<span class="mono t-l">{ep.toUpperCase()} 01</span>
							<span class="mono t-f">16:9</span>
							<span class="tl">{ticks.map((x, i) => <i style={`--x:${x}%;--d:${3 + i * 2}`} />)}</span>
						</div>
						{
							Array.from({ length: perEp }, (_, i) => (
								<div class="tile clip" style={`--d:${3 + i * 2}`}>
									<span class="mono t-l">
										CLIP
										<br />
										{String(i + 1).padStart(2, '0')}
									</span>
									<span class="mono t-f">9:16</span>
								</div>
							))
						}
					</div>
					<div class="wall" aria-hidden="true">
						{
							Array.from({ length: 8 }, (_, s) => (
								<div class:list={['slot', { on: s < startEps }]} style={`--s:${s}`}>
									<span class="mono s-n">{String(s + 1).padStart(2, '0')}</span>
									<div class="s-t">
										{Array.from({ length: 1 + perEp }, (_, k) => (
											<i style={`--k:${k}`} />
										))}
									</div>
								</div>
							))
						}
					</div>
					<div class="mw-ctrl">
						<label for="mw-n" class="mono">{de ? 'Folgen pro Monat' : 'Episodes per month'}</label>
						<output for="mw-n" class="mono mw-v" data-o="n">{startEps}</output>
						<input id="mw-n" type="range" min="1" max="8" step="1" value={startEps} aria-valuetext={`${startEps} ${eps(startEps)} → ${startEps * (1 + perEp)} ${de ? 'Inhalte' : 'pieces of content'}`} />
					</div>
					<div class="mw-eq" aria-live="polite">
						<p class="eq eq-n"><b data-o="n">{startEps}</b><span class="mono" data-o="nl">{eps(startEps)}</span></p>
						<span class="eq-arr" aria-hidden="true">→</span>
						<p class="eq eq-t"><b data-o="t">{startEps * (1 + perEp)}</b><span class="mono">{de ? 'Inhalte pro Monat' : 'pieces of content per month'}</span></p>
					</div>
					<p class="mono mw-f" aria-hidden="true">
						<span data-o="n">{startEps}</span> × (1 {de ? 'Folge' : 'episode'} + {perEp} {de ? 'Clips' : 'clips'}) = <span data-o="t">{startEps * (1 + perEp)}</span>
					</p>
					<figcaption id="mw-cap" class="sr-only">{mwCap}</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<section class="strip">
		<div class="wrap grid strip-in">
			<p class="mono strip-k">{de ? 'Geschnitten für' : 'Edited for'}</p>
			<ul>
				<li>Carwow DE <span class="mono">{de ? '· 3 Review-Folgen, 2025' : '· 3 review episodes, 2025'}</span></li>
				<li>Felix von der Laden <span class="mono">· 2 {de ? 'Langform-Dokus' : 'long-form docs'}</span></li>
			</ul>
			<p class="mono strip-n">
				{de ? 'Selbst prüfen:' : 'Check for yourself:'}
				<a href="https://www.youtube.com/watch?v=7Kt9NFOXqF4" rel="noopener">Drivers Eye ↗</a>
				<a href="https://www.youtube.com/watch?v=ER8HBwDKMGw" rel="noopener">Hotrodtour ↗</a>
			</p>
		</div>
	</section>

	<section id="system" class="sec">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Das System' : 'The system'}</p>
				<p class="mono idx" aria-hidden="true">{sec(1)}</p>
				<h2>{de ? 'Euer Format als System' : 'Your format as a system'}</h2>
				<p>
					{
						de
							? 'Wer jede Woche dieselbe Show produziert, sollte nicht jede Woche dieselben Dinge neu bauen. Sechs Bausteine, die ich für euer Format aufsetze:'
							: 'If you ship the same show every week, you should not rebuild the same things every week. Six building blocks I set up for your format:'
					}
				</p>
			</div>
			<ol class="parts">
				{
					systemParts.map((s) => (
						<li class="part grid reveal">
							<span class="p-n">{s.n}</span>
							<h3>{s.title[lang]}</h3>
							<p>{s.text[lang]}</p>
						</li>
					))
				}
			</ol>
			<p class="ai mono label">
				{de ? 'KI hilft. Der Schnitt entscheidet. Keine generierten Moderatoren, kein Auto-Slop.' : 'AI assists. The edit decides. No generated presenters, no auto-slop.'}
			</p>
		</div>
	</section>

	<section id="demo" class="sec sec--tight">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Live-Demo' : 'Live demo'}</p>
				<p class="mono idx" aria-hidden="true">{sec(2)}</p>
				<h2>{de ? 'Grafik aus der Tabelle. Probiert es aus.' : 'Graphics from a spreadsheet. Try it.'}</h2>
				<p>
					{
						de
							? 'So funktionieren datengetriebene Grafiken: Ihr pflegt Werte, das Template rendert – in 16:9 und 9:16. Ändert eine Zahl.'
							: 'This is how data-driven graphics work: you maintain values, the template renders – in 16:9 and 9:16. Change a number.'
					}
				</p>
			</div>
			<SpecDemo lang={lang} />
		</div>
	</section>

	<section id="ablauf" class="sec sec--ink">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Ablauf' : 'Process'}</p>
				<p class="mono idx" aria-hidden="true">{sec(3)}</p>
				<h2 class="bw">
					<span class="bw-txt">{de ? 'Klein anfangen, dann skalieren' : 'Start small, then scale'}</span>
					<span class="bw-bars" aria-hidden="true"><i /><i /><i /><i /></span>
				</h2>
			</div>
			<ol class="steps grid">
				{
					steps.map(([n, h, p, s]) => (
						<li class="reveal">
							<span class="st-n">{n}</span>
							<h3>{h}</h3>
							<p>{p}</p>
							<p class="mono st-s">{s}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="rechner" class="sec">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Rechner' : 'Calculator'}</p>
				<p class="mono idx" aria-hidden="true">{sec(4)}</p>
				<h2>{de ? 'Was spart euch ein System?' : 'What would a system save you?'}</h2>
				<p>{de ? 'Eure Zahlen rein, Schätzung raus – inklusive passendem Paket.' : 'Your numbers in, an estimate out – including the matching package.'}</p>
			</div>
			<Calculator lang={lang} />
		</div>
	</section>

	<div class="rep-wrap">
		<div class="rep" data-lang={lang} aria-hidden="true">
			<div class="rep-rows">
				{
					[0, 1, 2, 3, 4].map((r) =>
						r === 3 ? (
							<div class="rep-row rep-inv">
								<span class="wrap">
									<span>{repWord} 01 <em>=</em></span> <span>{repWord} 52</span>
								</span>
							</div>
						) : (
							<div class="rep-row">
								<span class="wrap">{Array.from({ length: 6 }, () => repWord).join(' ')}</span>
							</div>
						),
					)
				}
			</div>
		</div>
		<p class="sr-only">{de ? 'Gleiche Qualität in jeder Folge: Folge 52 sieht so gut aus wie Folge 01.' : 'Consistent quality in every episode: episode 52 looks as good as episode 01.'}</p>
	</div>

	<section id="pakete" class="sec">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Pakete & Preise' : 'Packages & pricing'}</p>
				<p class="mono idx" aria-hidden="true">{sec(5)}</p>
				<h2>{de ? 'Festpreise. Schriftlich. Vorab.' : 'Fixed prices. In writing. Upfront.'}</h2>
				<div class="aside">
					<p>
						{
							de
								? 'Basis ist ein Tagessatz von 750 €. Pakete sind günstiger als Einzeltage, weil das System die Arbeit schneller macht – das ist der Punkt.'
								: 'Base day rate is €750. Packages cost less than single days because the system makes the work faster – that is the point.'
						}
					</p>
					<a class="mono calc-link" href="#rechner">{de ? 'Unsicher? Rechner nutzen ↑' : 'Not sure? Use the calculator ↑'}</a>
				</div>
			</div>
			<div class="pk">
				{
					packages.map((p, i) => {
						const m = p.price[lang].match(/^(ab|from)\s+(.+)$/);
						return (
							<article class:list={['pk-col', { hl: p.highlight }]}>
								<p class="mono pk-top">
									<span aria-hidden="true">P/{String(i + 1).padStart(2, '0')}</span>
									{p.highlight && <span class="pk-tag">{de ? 'Empfohlener Einstieg' : 'Recommended start'}</span>}
								</p>
								<h3>{p.name[lang]}</h3>
								<p class="pk-price">
									{m ? (
										<>
											<span class="pk-pre">{m[1]}</span> {m[2]}
										</>
									) : (
										p.price[lang]
									)}{' '}
									<span class="mono">{p.unit[lang]}</span>
								</p>
								<p class="mono pk-days">{p.days[lang]}</p>
								<ul>
									{p.points.map((x) => (
										<li>{x[lang]}</li>
									))}
								</ul>
							</article>
						);
					})
				}
			</div>
			<p class="mono pk-note">
				{
					de
						? 'Alle Preise netto. Abrechnung über Micha Roessler LLC (USA); B2B-Kunden in der EU: Reverse-Charge, keine deutsche USt. auf der Rechnung. USD-Preise auf Anfrage.'
						: 'All prices net. Invoiced by Micha Roessler LLC (USA); EU B2B clients: reverse charge. USD pricing on request.'
				}
			</p>
		</div>
	</section>

	<section id="arbeiten" class="sec">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Arbeiten' : 'Work'}</p>
				<p class="mono idx" aria-hidden="true">{sec(6)}</p>
				<h2>{de ? 'Was ich gebaut und geschnitten habe' : 'What I have built and edited'}</h2>
				<p>
					{
						de
							? 'Ehrlich eingeordnet: Format-Schnitt für Marken ist ein junger Schwerpunkt bei mir, Workflows baue ich seit Jahren für meine eigenen Produktionen. Große Agentur-Logos habe ich nicht – deshalb startet jede Zusammenarbeit mit einem bezahlten Pilot statt mit Versprechen. Keine erfundenen Zahlen; Kunden ohne Freigabe bleiben anonym.'
							: 'Honestly put: format editing for brands is a young focus for me; I have been building workflows for my own productions for years. I do not have big agency logos – which is why every engagement starts with a paid pilot instead of promises. No invented numbers; clients who have not approved being named stay anonymous.'
					}
				</p>
			</div>
			<div class="cases">
				{
					proof.map((c, i) => (
						<article class="case reveal">
							<p class="mono case-k">
								<span>{c.tag[lang]}</span>
								<span aria-hidden="true">{String.fromCharCode(65 + i)}</span>
							</p>
							<h3>{c.title[lang]}</h3>
							<p>{c.text[lang]}</p>
						</article>
					))
				}
			</div>
			<div class="tools">
				<p class="mono label">{de ? 'Werkzeuge, die ich selbst baue und nutze' : 'Tools I build and use'}</p>
				<dl>
					{
						tools.map((t) => (
							<div class="reveal">
								<dt>{t.name}</dt>
								<dd>{t.text[lang]}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</section>

	<section class="sec about">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Wer dahinter steht' : 'Who is behind it'}</p>
				<p class="mono idx" aria-hidden="true">{sec(7)}</p>
				<h2>{de ? 'Eine Person. Schnitt und System.' : 'One person. Edit and system.'}</h2>
			</div>
			<div class="about-g grid">
				<figure class="about-img">
					<Image src={portrait} alt="Micha Rössler" widths={[360, 720, 1080]} sizes="(min-width: 1040px) 30vw, 100vw" />
					<figcaption class="mono">Micha Rössler · Editor & {de ? 'Filmemacher' : 'filmmaker'}</figcaption>
				</figure>
				<div class="about-t">
					<p class="about-p">
						{
							de
								? 'Ich bin Micha Rössler, Editor und Filmemacher. Gelernt habe ich das Handwerk bei Langform-Dokus für YouTube – 1,2 und 1,4 Mio. Aufrufe für Felix von der Laden. Heute schneide ich Serienformate wie Auto-Reviews und baue die Systeme dahinter: Templates, Remotion-Grafiken und eigene Tools wie eine Offload-App für den Ingest. Wenn ich nicht im Schnitt sitze, drehe ich Expeditionsfilme.'
								: 'I am Micha Rössler, editor and filmmaker. I learned the craft on long-form YouTube docs – 1.2M and 1.4M views for Felix von der Laden. Today I edit series formats like car reviews and build the systems behind them: templates, Remotion graphics and my own tools such as an offload app for ingest. When I am not editing, I shoot expedition films.'
						}
					</p>
					<a class="btn" href={de ? 'https://micharoessler.com/de/' : 'https://micharoessler.com/'}>micharoessler.com <span class="arr">↗</span></a>
				</div>
			</div>
		</div>
	</section>

	<section id="faq" class="sec">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">FAQ</p>
				<p class="mono idx" aria-hidden="true">{sec(8)}</p>
				<h2>{de ? 'Häufige Fragen' : 'Common questions'}</h2>
			</div>
			<div class="faq">
				{
					faq.map((f, i) => (
						<details name="faq">
							<summary>
								<span class="mono q-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
								<span class="q-t">{f.q[lang]}</span>
								<i class="q-x" aria-hidden="true" />
							</summary>
							<p>{f.a[lang]}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section id="kontakt" class="sec sec--ink contact">
		<div class="wrap">
			<div class="sec-h grid">
				<p class="mono label">{de ? 'Kontakt' : 'Contact'}</p>
				<p class="mono idx" aria-hidden="true">{sec(9)}</p>
				<h2 class="bw">
					<span class="bw-txt">{de ? 'Erzählt mir von eurem Format.' : 'Tell me about your format.'}</span>
					<span class="bw-bars" aria-hidden="true"><i /><i /><i /><i /></span>
				</h2>
			</div>
			<div class="grid c-in">
				<div class="c-txt">
					<div class="c-who">
						<Image src={portrait} alt="Micha Rössler" width={128} height={128} widths={[64, 128]} sizes="64px" class="c-avatar" />
						<p><b>Micha Rössler</b><br /><span class="mono">{de ? 'antwortet persönlich' : 'replies personally'}</span></p>
					</div>
					<p class="c-mail">
						{de ? 'Antwort innerhalb von zwei Werktagen. Oder direkt: ' : 'Reply within two working days. Or directly: '}
						<a href="mailto:hello@micharoessler.com">hello@micharoessler.com</a>
					</p>
					<ul class="trust">
						<li>{de ? 'Ihr schreibt direkt mit mir – keine Agentur, kein Vertrieb, kein Subunternehmer.' : 'You talk to me directly – no agency, no sales team, no subcontractors.'}</li>
						<li>{de ? 'Festpreis schriftlich vor Start. Überzeugt euch der Pilot nicht, endet die Zusammenarbeit dort – ohne Folgekosten.' : 'Fixed price in writing before we start. If the pilot does not convince you, it ends there – no follow-on costs.'}</li>
						<li>{de ? 'Ich bin Deutscher, arbeite remote von unterwegs und rechne über meine US-Firma Micha Roessler LLC ab.' : 'I am German, work remotely while travelling and invoice through my US company, Micha Roessler LLC.'}</li>
					</ul>
				</div>
				<form class="f" id="brief" data-subject={de ? 'Anfrage Formatschnitt' : 'Formatschnitt enquiry'}>
					<fieldset>
