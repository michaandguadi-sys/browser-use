<script>
	// Hero multiplier wall: Folgen × (1 + clips) = Inhalte. Tiles cut in on a 25 fps frame grid.
	const mw = document.querySelector<HTMLElement>('[data-mw]');
	if (mw) {
		const de = mw.dataset.lang === 'de';
		const per = Number(mw.dataset.per ?? 6);
		const range = mw.querySelector<HTMLInputElement>('input[type=range]')!;
		const slots = [...mw.querySelectorAll<HTMLElement>('.slot')];
		const set = (k: string, t: string) => mw.querySelectorAll(`[data-o="${k}"]`).forEach((el) => (el.textContent = t));
		const word = (n: number) => (de ? (n === 1 ? 'Folge' : 'Folgen') : n === 1 ? 'episode' : 'episodes');
		let cur = Number(range.value);
		const render = (n: number) => {
			const total = n * (1 + per);
			set('n', String(n));
			set('t', String(total));
			set('nl', word(n));
			range.setAttribute('aria-valuetext', `${n} ${word(n)} → ${total} ${de ? 'Inhalte' : 'pieces of content'}`);
			slots.forEach((s, i) => {
				const on = i < n;
				if (on !== s.classList.contains('on')) s.style.setProperty('--s', String(on ? i - cur : cur - 1 - i));
				s.classList.toggle('on', on);
			});
			cur = n;
		};
		range.addEventListener('input', () => {
			mw.style.setProperty('--base', '0');
			render(Number(range.value));
		});
		render(cur);
	}

	const f = document.getElementById('brief') as HTMLFormElement;
	f?.addEventListener('submit', (e) => {
		e.preventDefault();
		const lines = [...new FormData(f).entries()].filter(([, v]) => String(v).trim()).map(([k, v]) => `${k}: ${v}`);
		location.href = `mailto:hello@micharoessler.com?subject=${encodeURIComponent(f.dataset.subject ?? '')}&body=${encodeURIComponent(lines.join('\n\n'))}`;
	});
</script>

