---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { impressum, privacy } from '../data/legal';

interface Props {
	lang: Lang;
	kind: 'imprint' | 'privacy';
}
const { lang, kind } = Astro.props;
const de = lang === 'de';
const sections = kind === 'imprint' ? impressum[lang] : privacy('Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, USA')[lang];
const title = kind === 'imprint' ? (de ? 'Impressum' : 'Legal notice') : de ? 'Datenschutzerklärung' : 'Privacy policy';
const alt = kind === 'imprint' ? { de: '/impressum/', en: '/en/legal/' } : { de: '/datenschutz/', en: '/en/privacy/' };
---

<Base lang={lang} title={`${title} | Formatschnitt`} description={title} alt={alt}>
	<div class="wrap l">
		<h1>{title}</h1>
		{
			sections.map((s) => (
				<section>
					<h2>{s.h}</h2>
					{s.p.map((p) => (
						<p set:html={p} />
					))}
				</section>
			))
		}
	</div>
</Base>

<style>
	.l {
		padding-block: clamp(56px, 7vw, 112px);
	}
	.l > * {
		max-width: 820px;
	}
	h1 {
		font-size: var(--h2);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 0.92;
		padding-top: 16px;
		border-top: 2px solid var(--ink);
		margin-bottom: 48px;
	}
	section {
		margin-top: 32px;
		padding-top: 12px;
		border-top: 1px solid var(--ink);
	}
	h2 {
		font-size: 22px;
		font-weight: 750;
		letter-spacing: -0.02em;
		line-height: 1.1;
		margin-bottom: 10px;
	}
	p {
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	p + p {
		margin-top: 10px;
	}
</style>
