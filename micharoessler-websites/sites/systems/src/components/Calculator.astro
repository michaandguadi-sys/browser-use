---
// Effort calculator, simplified: episodes × hours, minus an explicit, editable saving assumption.
// The saving rate is an assumption the pilot measures — the site never promises it.
import { type Lang } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

const inputs = [
	{ id: 'eps', label: de ? 'Langform-Folgen pro Monat' : 'Long-form episodes per month', min: 1, max: 12, step: 1, value: 4, unit: '' },
	{ id: 'hEp', label: de ? 'Stunden pro Folge inkl. Shorts (heute)' : 'Hours per episode incl. shorts (today)', min: 4, max: 48, step: 1, value: 20, unit: ' h' },
	{ id: 'save', label: de ? 'Annahme: Zeitersparnis (unbelegt, im Pilot gemessen)' : 'Assumption: time saved (unproven, measured in the pilot)', min: 0, max: 40, step: 5, value: 20, unit: ' %' },
];
---

<div class="calc glass" data-calc data-lang={lang}>
	<div class="in">
		{
			inputs.map((i) => (
				<label class="row">
					<span class="lab">
						<span>{i.label}</span>
						<output data-show={i.id}>
							{i.value}
							{i.unit}
						</output>
					</span>
					<input type="range" name={i.id} min={i.min} max={i.max} step={i.step} value={i.value} data-unit={i.unit} />
				</label>
			))
		}
	</div>

	<div class="res" aria-live="polite">
		<dl class="kpi">
			<div>
				<dt>{de ? 'Gesparte Stunden / Monat' : 'Hours saved / month'}</dt>
				<dd data-o="saved"></dd>
			</div>
			<div>
				<dt>{de ? 'Gegenwert bei 750 € / Tag' : 'Worth at €750 / day'}</dt>
				<dd data-o="worth"></dd>
			</div>
		</dl>
		<p class="how"><span data-o="how"></span> {de ? 'Beträge netto.' : 'Amounts net.'}</p>
		<div class="rec">
			<div>
				<p class="rec-k">{de ? 'Passendes Paket' : 'Matching package'}</p>
				<p class="rec-name" data-o="pkg"></p>
			</div>
			<a class="btn btn--primary" href="#kontakt" data-cta>{de ? 'Damit anfragen' : 'Enquire with this'} <span class="arr">→</span></a>
		</div>
		<p class="note">
			{de ? 'Schätzung, keine Garantie. Genau das klärt der Pilot.' : 'An estimate, not a promise. That is exactly what the pilot measures.'}
		</p>
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-calc]')) {
		const de = root.dataset.lang === 'de';
		const nf = new Intl.NumberFormat(de ? 'de-DE' : 'en-GB', { maximumFractionDigits: 0 });
		const nf1 = new Intl.NumberFormat(de ? 'de-DE' : 'en-GB', { maximumFractionDigits: 1 });
		const ranges = [...root.querySelectorAll<HTMLInputElement>('input[type=range]')];
		const get = (n: string) => Number(root.querySelector<HTMLInputElement>(`input[name="${n}"]`)!.value);
		const out = (k: string, t: string) => (root.querySelector(`[data-o="${k}"]`)!.textContent = t);
		const eur = (n: number) => (de ? `${nf.format(n)} €` : `€${nf.format(n)}`);

		// Restore a shared estimate from the URL (?eps=4&hEp=20&save=20), clamped to each slider's range.
		const q = new URLSearchParams(location.search);
		for (const i of ranges) {
			const v = q.get(i.name);
			if (v !== null && v.trim() !== '' && Number.isFinite(Number(v))) i.value = String(Math.min(Number(i.max), Math.max(Number(i.min), Number(v))));
		}

		const render = () => {
			for (const i of ranges) {
				root.querySelector(`[data-show="${i.name}"]`)!.textContent = Number(i.value).toLocaleString(de ? 'de-DE' : 'en-GB') + (i.dataset.unit ?? '');
				i.style.setProperty('--p', `${((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100}%`);
			}
			const eps = get('eps');
			const now = eps * get('hEp');
			const sys = now * (1 - get('save') / 100);
			const saved = now - sys;
			const worth = (saved / 8) * 750;
			out('saved', `${nf.format(saved)} h`);
			out('worth', `≈ ${eur(worth)}`);
			out('how', `${eps} × ${get('hEp')} h = ${nf.format(now)} h · −${get('save')} % = ${nf.format(sys)} h · ${nf1.format(saved)} h ÷ 8 h × ${eur(750)} ≈ ${eur(worth)}.`);

			// Retainer S = 6 days, M = 10 days (8 h each), see packages.
			const days = sys / 8;
			const pkg =
				days <= 3
					? de ? 'Pilot, dann Setup (3.500 €) – euer Team schneidet selbst' : 'Pilot, then setup (€3,500) – your team edits'
					: days <= 6
						? de ? 'Format-Retainer S · 4.200 € / Monat' : 'Format retainer S · €4,200 / month'
						: days <= 10
							? de ? 'Format-Retainer M · 6.750 € / Monat' : 'Format retainer M · €6,750 / month'
							: de ? 'Individuelles Angebot (über 10 Tage / Monat)' : 'Custom quote (over 10 days / month)';
			out('pkg', pkg);
			root.querySelector<HTMLAnchorElement>('[data-cta]')!.dataset.summary =
				`${de ? 'Rechner' : 'Calculator'}: ${eps} ${de ? 'Folgen' : 'episodes'}/${de ? 'Monat' : 'month'}, ${nf.format(now)} h → ${nf.format(sys)} h. ${pkg}`;
		};
		root.addEventListener('input', () => {
			render();
			// Keep the estimate shareable: the URL carries the current inputs.
			const p = new URLSearchParams(location.search);
			for (const i of ranges) p.set(i.name, i.value);
			history.replaceState(history.state, '', `${location.pathname}?${p}${location.hash}`);
		});
		// Carry the estimate into the brief form so the enquiry starts with numbers.
		root.querySelector('[data-cta]')?.addEventListener('click', (e) => {
			const s = (e.currentTarget as HTMLElement).dataset.summary ?? '';
			const goal = document.querySelector<HTMLTextAreaElement>('#brief textarea');
			if (goal && !goal.value.includes(s)) goal.value = (goal.value ? goal.value + '\n' : '') + s;
		});
		render();
	}
</script>

<style>
	.calc {
		display: grid;
		gap: clamp(28px, 4vw, 56px);
		padding: clamp(24px, 4vw, 48px);
	}
	@media (min-width: 960px) {
		.calc {
			grid-template-columns: 1fr 1fr;
		}
	}
	.in {
		display: grid;
		gap: 26px;
		align-content: start;
	}
	.row {
		display: grid;
		gap: 10px;
	}
	.lab {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		font-size: 16px;
		font-weight: 520;
	}
	.lab output {
		font-family: var(--mono);
		font-size: 15px;
		color: var(--iris);
		white-space: nowrap;
	}
	.res {
		display: grid;
		gap: 22px;
		align-content: start;
	}
	.kpi {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
		margin: 0;
	}
	.kpi dt {
		font-size: 14px;
		color: var(--ink-2);
	}
	.kpi dd {
		margin: 6px 0 0;
		font-size: clamp(36px, 4vw, 56px);
		font-weight: 680;
		letter-spacing: -0.045em;
		line-height: 1;
		white-space: nowrap;
	}
	.how {
		font-family: var(--mono);
		font-size: 12.5px;
		line-height: 1.6;
		color: var(--ink-2);
	}
	.rec {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 18px 18px 22px;
		border-radius: 22px;
		background: rgba(85, 70, 255, 0.07);
		box-shadow: inset 0 0 0 1px rgba(85, 70, 255, 0.12);
	}
	.rec-k {
		font-size: 14px;
		color: var(--ink-2);
	}
	.rec-name {
		font-size: 19px;
		font-weight: 620;
		letter-spacing: -0.02em;
	}
	.note {
		font-size: 14px;
		color: var(--ink-2);
	}
</style>
