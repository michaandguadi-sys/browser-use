---
// Effort calculator: current monthly edit hours vs. with a format system.
// The saving rate is an explicit, editable assumption – the site never promises it.
import { type Lang } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

const inputs = [
	{ id: 'eps', label: de ? 'Langform-Folgen pro Monat' : 'Long-form episodes per month', min: 1, max: 12, step: 1, value: 4, unit: '' },
	{ id: 'hEp', label: de ? 'Schnittstunden pro Folge (heute)' : 'Edit hours per episode (today)', min: 4, max: 40, step: 1, value: 16, unit: 'h' },
	{ id: 'shorts', label: de ? 'Shorts pro Folge' : 'Shorts per episode', min: 0, max: 8, step: 1, value: 3, unit: '' },
	{ id: 'hShort', label: de ? 'Stunden pro Short (heute)' : 'Hours per short (today)', min: 0.5, max: 4, step: 0.5, value: 1.5, unit: 'h' },
	{ id: 'save', label: de ? 'Annahme: Zeitersparnis (unbelegt, im Pilot gemessen)' : 'Assumption: time saved (unproven, measured in the pilot)', min: 0, max: 40, step: 5, value: 20, unit: '%' },
];
---

<div class="calc" data-calc data-lang={lang}>
	<div class="in">
		{
			inputs.map((i) => (
				<label class:list={['row', { assume: i.id === 'save' }]}>
					<span class="lab">
						{i.label}
						<output class="mono" data-show={i.id}>
							{i.value}
							{i.unit}
						</output>
					</span>
					<input type="range" name={i.id} min={i.min} max={i.max} step={i.step} value={i.value} data-unit={i.unit} />
				</label>
			))
		}
	</div>

	<div class="res" aria-live="polite">
		<div class="bars">
			<div class="bar">
				<span class="mono">{de ? 'Heute' : 'Today'}</span>
				<b data-o="now"></b>
				<i data-bar="now"></i>
			</div>
			<div class="bar sys">
				<span class="mono">{de ? 'Mit System' : 'With system'}</span>
				<b data-o="sys"></b>
				<i data-bar="sys"></i>
			</div>
		</div>
		<dl class="kpi">
			<div>
				<dt class="mono">{de ? 'Gesparte Stunden / Monat' : 'Hours saved / month'}</dt>
				<dd data-o="saved"></dd>
			</div>
			<div>
				<dt class="mono">{de ? 'Gegenwert bei 750 € / Tag' : 'Worth at €750 / day'}</dt>
				<dd data-o="worth"></dd>
			</div>
		</dl>
		<p class="mono how"><span>{de ? 'Rechenweg' : 'How it is calculated'}</span><span data-o="how"></span><span>{de ? 'Beträge netto.' : 'Amounts net.'}</span></p>
		<div class="rec">
			<p class="mono">{de ? 'Passendes Paket' : 'Matching package'}</p>
			<p class="rec-name" data-o="pkg"></p>
			<a class="btn btn--ink" href="#kontakt" data-cta>{de ? 'Damit anfragen' : 'Enquire with this'} <span class="arr">→</span></a>
		</div>
		<p class="mono note">
			{
				de
					? 'Schätzung, keine Garantie. Die Ersparnis hängt von eurem Format ab – genau das klärt der Pilot.'
					: 'An estimate, not a promise. The saving depends on your format – which is exactly what the pilot measures.'
			}
		</p>
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-calc]')) {
		const de = root.dataset.lang === 'de';
		const nf = new Intl.NumberFormat(de ? 'de-DE' : 'en-GB', { maximumFractionDigits: 0 });
		const nf1 = new Intl.NumberFormat(de ? 'de-DE' : 'en-GB', { maximumFractionDigits: 1 });
		const ranges = [...root.querySelectorAll<HTMLInputElement>('input[type=range]')];
		const get = (n: string) => Number(root.querySelector<HTMLInputElement>(`input[name="${n}"]`)!.value);
		const out = (k: string, t: string) => (root.querySelector(`[data-o="${k}"]`)!.textContent = t);

		// Restore a shared estimate from the URL (?eps=4&hEp=16…), clamped to each slider's range.
		const q = new URLSearchParams(location.search);
		for (const i of ranges) {
			const v = q.get(i.name);
			if (v !== null && v.trim() !== '' && Number.isFinite(Number(v))) i.value = String(Math.min(Number(i.max), Math.max(Number(i.min), Number(v))));
		}

		const render = () => {
			for (const i of ranges) {
				const v = Number(i.value).toLocaleString(de ? 'de-DE' : 'en-GB');
				root.querySelector(`[data-show="${i.name}"]`)!.textContent = v + (i.dataset.unit ?? '');
			}
			const eps = get('eps');
			const now = eps * (get('hEp') + get('shorts') * get('hShort'));
			const sys = now * (1 - get('save') / 100);
			const saved = now - sys;
			out('now', `${nf.format(now)} h`);
			out('sys', `${nf.format(sys)} h`);
			out('saved', `${nf.format(saved)} h`);
			out('worth', de ? `≈ ${nf.format((saved / 8) * 750)} €` : `≈ €${nf.format((saved / 8) * 750)}`);
			out(
				'how',
				`${eps} × (${nf1.format(get('hEp'))} h + ${get('shorts')} × ${nf1.format(get('hShort'))} h) = ${nf.format(now)} h · −${get('save')} % = ${nf.format(sys)} h · ${nf1.format(saved)} h ÷ 8 h × ${de ? '750 €' : '€750'} ≈ ${de ? `${nf.format((saved / 8) * 750)} €` : `€${nf.format((saved / 8) * 750)}`}`,
			);
			root.querySelector<HTMLElement>('[data-bar="now"]')!.style.setProperty('--w', '1');
			root.querySelector<HTMLElement>('[data-bar="sys"]')!.style.setProperty('--w', String(now ? sys / now : 0));

			// Retainer S = 6 days, M = 10 days (8 h each), see packages.
			const days = sys / 8;
			const pkg =
				days <= 3
					? de ? 'Pilot, dann Setup (3.500 €) – euer Team schneidet selbst' : 'Pilot, then setup (€3,500) – your team edits'
					: days <= 6
						? de ? 'Format-Retainer S · 4.200 € / Monat' : 'Format retainer S · €4,200 / month'
						: days <= 10
							? de ? 'Format-Retainer M · 6.750 € / Monat' : 'Format retainer M · €6,750 / month'
							: de ? 'Individuelles Angebot (über 10 Tage / Monat)' : 'Custom quote (over 10 days / month)';
			out('pkg', pkg);
			root.querySelector<HTMLAnchorElement>('[data-cta]')!.dataset.summary =
				`${de ? 'Rechner' : 'Calculator'}: ${eps} ${de ? 'Folgen' : 'episodes'}/${de ? 'Monat' : 'month'}, ${nf.format(now)} h → ${nf.format(sys)} h. ${pkg}`;
		};
		root.addEventListener('input', () => {
			render();
			// Keep the estimate shareable: the URL carries the current inputs.
			const p = new URLSearchParams(location.search);
			for (const i of ranges) p.set(i.name, i.value);
			history.replaceState(history.state, '', `${location.pathname}?${p}${location.hash}`);
		});
		// Carry the estimate into the brief form so the enquiry starts with numbers.
		root.querySelector('[data-cta]')?.addEventListener('click', (e) => {
			const s = (e.currentTarget as HTMLElement).dataset.summary ?? '';
			const goal = document.querySelector<HTMLTextAreaElement>('#brief textarea');
			if (goal && !goal.value.includes(s)) goal.value = (goal.value ? goal.value + '\n' : '') + s;
		});
		render();
	}
</script>

<style>
	.calc {
		display: grid;
		gap: 56px var(--gutter);
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		border-top: 1px solid var(--ink);
		padding-top: 24px;
	}
	.in,
	.res {
		grid-column: 1 / -1;
	}
	@media (min-width: 1040px) {
		.in {
			grid-column: 1 / span 6;
		}
		.res {
			grid-column: 8 / -1;
		}
	}
	.in {
		display: grid;
		gap: 0;
		align-content: start;
	}
	.row {
		display: grid;
		gap: 6px;
		padding: 12px 0 14px;
		border-bottom: 1px solid var(--guide);
	}
	.lab {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		font-size: 16px;
		line-height: 22px;
	}
	.lab output {
		color: var(--ink);
		font-size: 13px;
		text-transform: none;
		white-space: nowrap;
	}
	.assume {
		margin-top: 20px;
		border-top: 2px solid var(--ink);
		border-bottom: 0;
	}
	.assume .lab {
		color: var(--muted);
	}
	.assume .lab::before {
		content: '';
		flex: none;
		width: 8px;
		height: 8px;
		margin-top: 7px;
		background: var(--signal);
		align-self: flex-start;
	}
	.assume .lab {
		justify-content: flex-start;
	}
	.assume output {
		margin-left: auto;
	}
	.res {
		display: grid;
		gap: 28px;
		align-content: start;
	}
	.bars {
		display: grid;
		gap: 16px;
	}
	.bar {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: baseline;
		row-gap: 6px;
	}
	.bar b {
		font-size: 22px;
		font-weight: 750;
		letter-spacing: -0.02em;
	}
	.bar i {
		grid-column: 1 / -1;
		display: block;
		height: 28px;
		background: var(--ink);
		transform-origin: left;
		transform: scaleX(var(--w, 1));
		transition: transform var(--t-wipe) var(--ease);
	}
	.bar.sys i {
		background: var(--signal);
	}
	.kpi {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--gutter);
		margin: 0;
	}
	.kpi div {
		border-top: 1px solid var(--ink);
		padding-top: 10px;
	}
	.kpi dd {
		margin: 12px 0 0;
		font-size: clamp(36px, 4vw, 64px);
		font-weight: 850;
		letter-spacing: -0.04em;
		line-height: 0.9;
		white-space: nowrap;
	}
	.how {
		display: grid;
		gap: 4px;
		text-transform: none;
		letter-spacing: 0.01em;
		font-size: 11px;
	}
	.how span:first-child {
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--ink);
	}
	.rec {
		background: var(--ink);
		color: var(--paper);
		padding: 20px;
		display: grid;
		gap: 8px;
		justify-items: start;
	}
	.rec .mono {
		color: var(--muted-ink);
	}
	.rec-name {
		font-size: 22px;
		line-height: 1.15;
		font-weight: 750;
		letter-spacing: -0.02em;
		margin-bottom: 12px;
	}
	.rec .btn--ink {
		background: var(--paper);
		color: var(--ink);
		border-color: var(--paper);
	}
	.rec .btn--ink:hover {
		background: var(--signal);
		border-color: var(--signal);
	}
	.note {
		text-transform: none;
		letter-spacing: 0.01em;
	}
</style>
