---
// The "system" visual in the solution section: a real-time WebGL glass object, lazy-loaded near the viewport.
// Static CSS glass fallback for: no WebGL, prefers-reduced-motion, Save-Data, low-end phones (≤ 4 cores).
---

<div class="gs glass" data-glass-system aria-hidden="true">
	<div class="gs-fallback">
		<i class="c c1"></i><i class="c c2"></i><i class="c c3"></i>
		<span class="pane p1"></span><span class="pane p2"></span><span class="pane p3"></span><span class="pane p4"></span>
		<b class="ph"></b>
	</div>
	<canvas class="gs-canvas"></canvas>
</div>

<script>
	const host = document.querySelector<HTMLElement>('[data-glass-system]');
	const ok = () => {
		if (!host) return false;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
		const nav = navigator as Navigator & { connection?: { saveData?: boolean }; hardwareConcurrency?: number };
		if (nav.connection?.saveData) return false;
		if (matchMedia('(pointer: coarse)').matches && (nav.hardwareConcurrency ?? 8) <= 4) return false;
		try {
			const c = document.createElement('canvas');
			if (/[?&]story=live\b/.test(location.search)) return true;
			const g = c.getContext('webgl2', { failIfMajorPerformanceCaveat: true });
			if (!g) return false;
			const x = g.getExtension('WEBGL_debug_renderer_info');
			const soft = !!x && /swiftshader|llvmpipe|softpipe|software|basic render/i.test(String(g.getParameter(x.UNMASKED_RENDERER_WEBGL)));
			g.getExtension('WEBGL_lose_context')?.loseContext();
			return !soft;
		} catch {
			return false;
		}
	};
	if (host && ok()) {
		const io = new IntersectionObserver(
			([e]) => {
				if (!e.isIntersecting) return;
				io.disconnect();
				import('../scripts/glass-scene').then((m) => m.mount(host)).catch(() => {});
			},
			{ rootMargin: '150px 0px' },
		);
		// wait until the page has settled, so the first viewport never pays for WebGL
		const arm = () => io.observe(host);
		if (document.readyState === 'complete') setTimeout(arm, 600);
		else addEventListener('load', () => setTimeout(arm, 600), { once: true });
	}
</script>

<style>
	.gs {
		position: relative;
		aspect-ratio: 5 / 4;
		overflow: hidden;
		background: #eef0f5;
	}
	.gs-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.8s var(--ease);
	}
	.gs:global(.is-webgl) .gs-canvas {
		opacity: 1;
	}
	.gs:global(.is-webgl) .gs-fallback {
		opacity: 0;
	}
	/* static glass composition */
	.gs-fallback {
		position: absolute;
		inset: 0;
		perspective: 900px;
		transition: opacity 0.8s var(--ease);
		background:
			radial-gradient(40% 40% at 25% 30%, rgba(85, 70, 255, 0.3), transparent 70%),
			radial-gradient(40% 40% at 78% 35%, rgba(255, 166, 120, 0.35), transparent 70%),
			radial-gradient(45% 45% at 60% 85%, rgba(110, 220, 200, 0.32), transparent 70%);
	}
	.c {
		position: absolute;
		height: 7%;
		border-radius: 999px;
	}
	.c1 {
		left: 6%;
		top: 38%;
		width: 34%;
		background: #ff8a7a;
	}
	.c2 {
		left: 38%;
		top: 52%;
		width: 42%;
		background: #5546ff;
	}
	.c3 {
		left: 18%;
		top: 66%;
		width: 30%;
		background: #2bb3a3;
	}
	.pane {
		position: absolute;
		left: 20%;
		top: 27%;
		width: 50%;
		height: 46%;
		border-radius: 22px;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.18));
		border: 1px solid rgba(255, 255, 255, 0.85);
		box-shadow:
			inset 0 1px 0 #fff,
			0 24px 50px -24px rgba(16, 24, 40, 0.35);
		-webkit-backdrop-filter: blur(6px) saturate(1.4);
		backdrop-filter: blur(6px) saturate(1.4);
		transform: rotateY(-28deg) rotateX(10deg) translateZ(calc(var(--z) * 1px)) translate(calc(var(--z) * 0.25px), calc(var(--z) * -0.18px));
	}
	.p1 {
		--z: 0;
	}
	.p2 {
		--z: 60;
	}
	.p3 {
		--z: 120;
	}
	.p4 {
		--z: 180;
	}
	.ph {
		position: absolute;
		left: 49%;
		top: 14%;
		width: 4px;
		height: 66%;
		border-radius: 2px;
		background: #5546ff;
		box-shadow: 0 0 24px 4px rgba(85, 70, 255, 0.45);
		transform: rotate(4deg);
	}
</style>
