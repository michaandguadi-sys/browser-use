---
import Base from '../layouts/Base.astro';
---

<Base lang="de" title="Seite nicht gefunden | Formatschnitt" description="Diese Seite gibt es nicht." alt={{ de: '/', en: '/en/' }}>
	<div class="wrap nf">
		<p class="mono label">404</p>
		<h1>Diese Seite ist nicht im Schnitt gelandet.</h1>
		<p class="nf-p">Die Seite gibt es nicht (mehr). <span lang="en">This page does not exist.</span></p>
		<p class="nf-links">
			<a class="btn btn--ink" href="/">Startseite</a>
			<a class="btn" href="/en/">English</a>
		</p>
	</div>
</Base>

<style>
	.nf {
		padding-block: 7rem;
		min-height: 60vh;
	}
	h1 {
		font-size: var(--s5);
		margin: 1rem 0 1.25rem;
		max-width: 20ch;
	}
	.nf-p {
		color: var(--graphite);
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
