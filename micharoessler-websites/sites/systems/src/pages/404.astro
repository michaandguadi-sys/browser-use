---
import Base from '../layouts/Base.astro';
---

<Base lang="de" title="Seite nicht gefunden | Formatschnitt" description="Diese Seite gibt es nicht." alt={{ de: '/', en: '/en/' }}>
	<div class="wrap nf">
		<p class="eyebrow">404</p>
		<h1>Diese Seite ist nicht im Schnitt gelandet.</h1>
		<p class="nf-p">Die Seite gibt es nicht (mehr). <span lang="en">This page does not exist.</span></p>
		<p class="nf-links">
			<a class="btn btn--primary" href="/">Startseite</a>
			<a class="btn" href="/en/">English</a>
		</p>
	</div>
</Base>

<style>
	.nf {
		padding-block: clamp(56px, 7vw, 112px);
		min-height: 60vh;
	}
	h1 {
		font-size: var(--h2);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 0.92;
		margin: 24px 0 24px;
		max-width: 16ch;
		text-wrap: balance;
	}
	.nf-p {
		color: var(--ink-2);
		font-size: var(--lead);
		line-height: 1.45;
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 40px;
	}
</style>
