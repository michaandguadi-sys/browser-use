---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { href, other, type Lang } from '../i18n';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
	title: string;
	description: string;
	alt: Record<Lang, string>;
	jsonLd?: Record<string, unknown>[];
}
const { lang, title, description, alt, jsonLd = [] } = Astro.props;
const de = lang === 'de';
const site = Astro.site!;
const canonical = new URL(alt[lang], site).href;
const home = href(lang, 'home');
const face = await getImage({ src: portrait, width: 800, format: 'jpg' });

const org = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	'@id': 'https://formatschnitt.de/#service',
	name: 'Formatschnitt',
	url: 'https://formatschnitt.de/',
	description,
	email: 'hello@micharoessler.com',
	areaServed: ['DE', 'AT', 'CH', 'GB', 'EU'],
	knowsLanguage: ['de', 'en'],
	priceRange: '€€€',
	founder: {
		'@type': 'Person',
		'@id': 'https://micharoessler.com/#person',
		name: 'Micha Rössler',
		url: 'https://micharoessler.com/',
		image: new URL(face.src, site).href,
	},
	parentOrganization: { '@type': 'Organization', name: 'Micha Roessler LLC' },
	sameAs: ['https://micharoessler.com/'],
};
---

<!doctype html>
<html lang={de ? 'de-DE' : 'en'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="de-DE" href={new URL(alt.de, site).href} />
		<link rel="alternate" hreflang="en" href={new URL(alt.en, site).href} />
		<link rel="alternate" hreflang="x-default" href={new URL(alt.de, site).href} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#f5f5f7" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Formatschnitt" />
		<meta property="og:locale" content={de ? 'de_DE' : 'en_GB'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/og.png', site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<script type="speculationrules" is:inline>{"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}</script>
	</head>
	<body>
		<a class="skip" href="#main">{de ? 'Zum Inhalt springen' : 'Skip to content'}</a>
		<header class="hd">
			<div class="bar">
				<a class="brand" href={href(lang, 'home')} aria-label="Formatschnitt">
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="2" y="5" width="12" height="6" rx="3" fill="#5546ff"></rect><rect x="9" y="13" width="13" height="6" rx="3" fill="#1d1d1f"></rect><rect x="15" y="2" width="2" height="20" rx="1" fill="#5546ff"></rect></svg>
					<span>Formatschnitt</span>
				</a>
				<nav aria-label={de ? 'Hauptnavigation' : 'Main'}>
					<a class="nl" href={`${home}#loesung`}>{de ? 'Lösung' : 'Solution'}</a>
					<a class="nl" href={`${home}#vorteile`}>{de ? 'Vorteile' : 'Benefits'}</a>
					<a class="nl" href={`${home}#pakete`}>{de ? 'Pakete' : 'Packages'}</a>
					<a class="nl" href={`${home}#faq`}>FAQ</a>
					<a class="lang" href={alt[other(lang)]} hreflang={other(lang)} lang={other(lang)}>{other(lang).toUpperCase()}</a>
					<a class="btn btn--primary hd-cta" href={`${home}#kontakt`}>{de ? 'Erstgespräch' : 'Intro call'}</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="ft">
			<div class="wrap ft-in">
				<div>
					<p class="ft-brand">Formatschnitt</p>
					<p class="muted">{de ? 'Schnitt-Systeme für wiederkehrende Videoformate' : 'Edit systems for recurring video formats'}</p>
				</div>
				<ul>
					<li><a href="mailto:hello@micharoessler.com">hello@micharoessler.com</a></li>
					<li><a href={de ? 'https://micharoessler.com/de/' : 'https://micharoessler.com/'}>{de ? 'Outdoor- & Expeditionsfilm → micharoessler.com' : 'Outdoor & expedition film → micharoessler.com'}</a></li>
				</ul>
				<ul>
					<li><a href={href(lang, 'imprint')}>{de ? 'Impressum' : 'Legal notice'}</a></li>
					<li><a href={href(lang, 'privacy')}>{de ? 'Datenschutz' : 'Privacy'}</a></li>
					<li class="muted">© {new Date().getFullYear()} Micha Roessler LLC</li>
				</ul>
			</div>
		</footer>

		<script>
			const io = new IntersectionObserver(
				(es) =>
					es.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add('in');
							io.unobserve(e.target);
						}
					}),
				{ rootMargin: '0px 0px -8% 0px' },
			);
			document.querySelectorAll('.reveal, [data-io]').forEach((el) => io.observe(el));
		</script>

		<style>
			/* floating glass nav — the one real backdrop-filter on the page */
			.hd {
				position: sticky;
				top: 0;
				z-index: 50;
				padding: 10px var(--gutter) 0;
			}
			.bar {
				max-width: var(--max);
				margin-inline: auto;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				height: 56px;
				padding: 0 8px 0 18px;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.72);
				-webkit-backdrop-filter: saturate(1.8) blur(20px);
				backdrop-filter: saturate(1.8) blur(20px);
				box-shadow:
					inset 0 1px 0 rgba(255, 255, 255, 0.9),
					0 0 0 1px rgba(29, 29, 31, 0.06),
					0 8px 24px -12px rgba(16, 24, 40, 0.18);
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				font-weight: 650;
				font-size: 18px;
				letter-spacing: -0.03em;
			}
			nav {
				display: flex;
				align-items: center;
				gap: 4px;
				font-size: 15px;
			}
			nav > a:not(.btn) {
				text-decoration: none;
				color: var(--ink-2);
				padding: 8px 12px;
				border-radius: 999px;
				transition:
					color 0.2s var(--ease),
					background-color 0.2s var(--ease);
			}
			nav > a:not(.btn):hover {
				color: var(--ink);
				background: rgba(29, 29, 31, 0.05);
			}
			nav > a.lang {
				color: var(--ink);
				font-weight: 560;
			}
			.hd-cta {
				min-height: 40px;
				padding: 8px 18px;
				font-size: 15px;
				margin-left: 6px;
			}
			@media (max-width: 860px) {
				nav > a.nl {
					display: none;
				}
			}
			@media (max-width: 400px) {
				.brand span {
					font-size: 17px;
				}
				.bar {
					padding-left: 14px;
				}
			}
			.ft {
				padding-block: 64px 48px;
				font-size: 15px;
			}
			.ft-in {
				display: grid;
				gap: 32px;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				border-top: 1px solid var(--line);
				padding-top: 40px;
			}
			.ft-brand {
				font-size: 22px;
				font-weight: 650;
				letter-spacing: -0.03em;
				margin-bottom: 6px;
			}
			.ft ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 8px;
				align-content: start;
			}
			.ft a {
				text-decoration: none;
			}
			.ft a:hover {
				color: var(--iris);
			}
		</style>
	</body>
</html>
