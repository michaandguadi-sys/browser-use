---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { href, other, type Lang } from '../i18n';
import portrait from '../assets/micha-portrait.jpg';

interface Props {
	lang: Lang;
	title: string;
	description: string;
	alt: Record<Lang, string>;
	jsonLd?: Record<string, unknown>[];
}
const { lang, title, description, alt, jsonLd = [] } = Astro.props;
const de = lang === 'de';
const site = Astro.site!;
const canonical = new URL(alt[lang], site).href;
const home = href(lang, 'home');
const face = await getImage({ src: portrait, width: 800, format: 'jpg' });

const org = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	'@id': 'https://formatschnitt.de/#service',
	name: 'Formatschnitt',
	url: 'https://formatschnitt.de/',
	description,
	email: 'hello@micharoessler.com',
	areaServed: ['DE', 'AT', 'CH', 'GB', 'EU'],
	knowsLanguage: ['de', 'en'],
	priceRange: '€€€',
	founder: {
		'@type': 'Person',
		'@id': 'https://micharoessler.com/#person',
		name: 'Micha Rössler',
		url: 'https://micharoessler.com/',
		image: new URL(face.src, site).href,
	},
	parentOrganization: { '@type': 'Organization', name: 'Micha Roessler LLC' },
	sameAs: ['https://micharoessler.com/'],
};
---

<!doctype html>
<html lang={de ? 'de-DE' : 'en'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="de-DE" href={new URL(alt.de, site).href} />
		<link rel="alternate" hreflang="en" href={new URL(alt.en, site).href} />
		<link rel="alternate" hreflang="x-default" href={new URL(alt.de, site).href} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#eeece6" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Formatschnitt" />
		<meta property="og:locale" content={de ? 'de_DE' : 'en_GB'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/og.png', site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<script type="speculationrules" is:inline>{"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}</script>
	</head>
	<body>
		<a class="skip" href="#main">{de ? 'Zum Inhalt springen' : 'Skip to content'}</a>
		<header class="hd">
			<div class="wrap bar">
				<a class="brand" href={href(lang, 'home')} aria-label="Formatschnitt">
					<i aria-hidden="true"></i>
					<span>Formatschnitt</span>
				</a>
				<nav aria-label={de ? 'Hauptnavigation' : 'Main'}>
					<a href={`${home}#system`}>{de ? 'System' : 'System'}</a>
					<a href={`${home}#demo`}>Demo</a>
					<a href={`${home}#pakete`}>{de ? 'Pakete' : 'Packages'}</a>
					<a href={`${home}#arbeiten`}>{de ? 'Arbeiten' : 'Work'}</a>
					<a href={`${home}#faq`}>FAQ</a>
					<a class="lang" href={alt[other(lang)]} hreflang={other(lang)} lang={other(lang)}>{other(lang).toUpperCase()}</a>
					<a class="btn btn--ink hd-cta" href={`${home}#kontakt`}>{de ? 'Erstgespräch' : 'Intro call'}</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="ft">
			<div class="wrap grid ft-in">
				<div class="ft-a">
					<p class="ft-brand">Formatschnitt</p>
					<p class="mono">{de ? 'Schnitt-Systeme für wiederkehrende Videoformate' : 'Edit systems for recurring video formats'}</p>
				</div>
				<ul class="ft-b">
					<li><a href="mailto:hello@micharoessler.com">hello@micharoessler.com</a></li>
					<li><a href={de ? 'https://micharoessler.com/de/' : 'https://micharoessler.com/'}>{de ? 'Outdoor- & Expeditionsfilm → micharoessler.com' : 'Outdoor & expedition film → micharoessler.com'}</a></li>
				</ul>
				<ul class="ft-c">
					<li><a href={href(lang, 'imprint')}>{de ? 'Impressum' : 'Legal notice'}</a></li>
					<li><a href={href(lang, 'privacy')}>{de ? 'Datenschutz' : 'Privacy'}</a></li>
					<li class="mono">© {new Date().getFullYear()} Micha Roessler LLC</li>
				</ul>
			</div>
		</footer>

		<script>
			const io = new IntersectionObserver(
				(es) =>
					es.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add('in');
							io.unobserve(e.target);
						}
					}),
				{ rootMargin: '0px 0px -8% 0px' },
			);
			document.querySelectorAll('.reveal, .bw, [data-io]').forEach((el) => io.observe(el));
		</script>

		<style>
			.hd {
				position: sticky;
				top: 0;
				z-index: 50;
				background: var(--paper);
				border-bottom: 1px solid var(--ink);
			}
			.bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 64px;
				gap: 16px;
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				font-weight: 800;
				font-stretch: 112%;
				letter-spacing: -0.035em;
				font-size: 22px;
				line-height: 1;
			}
			.brand i {
				width: 12px;
				height: 12px;
				background: var(--signal);
			}
			nav {
				display: flex;
				align-items: center;
				gap: clamp(12px, 2vw, 28px);
				font-family: var(--mono);
				font-size: 12px;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			nav > a:not(.btn) {
				text-decoration: none;
				color: var(--muted);
				padding-block: 6px;
				position: relative;
				transition: color var(--t-hover) var(--ease);
			}
			nav > a:not(.btn)::after {
				content: '';
				position: absolute;
				inset: auto 0 0 0;
				height: 2px;
				background: var(--signal);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform var(--t-hover) var(--ease);
			}
			nav > a:not(.btn):hover {
				color: var(--ink);
			}
			nav > a:not(.btn):hover::after {
				transform: scaleX(1);
			}
			nav > a.lang {
				color: var(--ink);
			}
			.hd-cta {
				min-height: 40px;
				padding: 8px 14px;
				font-family: var(--sans);
				font-size: 14px;
				text-transform: none;
				letter-spacing: -0.01em;
			}
			@media (max-width: 860px) {
				nav > a:not(.btn):not(.lang) {
					display: none;
				}
			}
			.ft {
				padding-block: 64px 40px;
				border-top: 2px solid var(--ink);
			}
			.ft-in {
				row-gap: 32px;
			}
			.ft-a {
				grid-column: 1 / -1;
			}
			.ft-b,
			.ft-c {
				grid-column: 1 / -1;
			}
			@media (min-width: 900px) {
				.ft-a {
					grid-column: 1 / span 6;
				}
				.ft-b {
					grid-column: 7 / span 3;
				}
				.ft-c {
					grid-column: 10 / span 3;
				}
			}
			.ft-brand {
				font-size: clamp(40px, 5.5vw, 88px);
				font-weight: 850;
				font-stretch: 110%;
				letter-spacing: -0.045em;
				line-height: 0.9;
				margin-bottom: 16px;
			}
			.ft ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 8px;
				align-content: start;
				font-size: 15px;
				line-height: 22px;
			}
			.ft a {
				text-decoration: none;
			}
			.ft a:hover {
				text-decoration: underline;
				text-decoration-color: var(--signal);
				text-decoration-thickness: 2px;
			}
		</style>
	</body>
</html>
