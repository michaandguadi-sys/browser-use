# Copy to .env (install.sh does this for you). Keep .env private: chmod 600 .env

OWNER_NAME=Micha
# Long passphrase you type on phone/laptop to log in (min 8 chars)
MENTOR_PASSPHRASE=
# Random secret for session cookies: openssl rand -hex 32
SESSION_SECRET=

ANTHROPIC_API_KEY=
MENTOR_MODEL=claude-opus-5-5

# Public URL (HTTPS). A DNS A record for the domain must point at this VPS.
MENTOR_DOMAIN=mentor.example.com
PUBLIC_URL=https://mentor.example.com

# Which optional services run: "caddy" (bundled HTTPS), "ntfy" (extra push server, only with WITH_NTFY=1 ./install.sh)
COMPOSE_PROFILES=caddy

# Optional ntfy push (Web Push from the installed app needs none of this)
PUSH_DOMAIN=
NTFY_PUBLIC_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# Optional dead-man switch, e.g. a free healthchecks.io check (period 5 min, grace 15 min)
HEALTHCHECK_PING_URL=

# Host ports when running behind your own reverse proxy instead of the bundled Caddy
MENTOR_PORT=8787
NTFY_PORT=8788
